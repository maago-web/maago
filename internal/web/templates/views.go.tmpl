{{.Marker}}

package {{.Package}}

import (
{{range .Imports}}{{if .}}	"{{.}}"{{end}}
{{end}}{{if .UserImport}}	maagouser "{{.UserImport}}"
{{end}})
{{if .Static}}
//go:embed static
var maagoStaticFiles embed.FS

// maagoStatic are the files of static/, with the names the project's
// templates ask for.
var maagoStatic = rt.Static({{printf "%q" .Package}}, maagoStaticFiles{{range .Used}}, {{printf "%q" .}}{{end}})
{{end}}{{if .HTML}}
//go:embed templates/*.html
var maagoTemplateFiles embed.FS

// maagoRoutes are the paths of every route of the project, for {{"{{"}}url{{"}}"}}.
var maagoRoutes = map[string]string{
{{range .AllRoutes}}	{{printf "%q" .Name}}: {{printf "%q" .Path}},
{{end}}}

// maagoPages are the template sets of the pages: base.html, if there is
// one, and the page.
var maagoPages = rt.Pages(maagoTemplateFiles, template.FuncMap{"url": rt.URLFunc(maagoRoutes), "date": rt.DateFunc, "static": rt.StaticFunc},
{{range .Pages}}	{{printf "%q" .}},
{{end}})
{{end}}{{range $route := .Routes}}
// {{.Serve}} serves route {{.Name}} with view {{.View}}.
func {{.Serve}}(w http.ResponseWriter, r *http.Request) error {
{{- if .Escape}}
	{{.View}}(w, r)
	return nil
{{- else}}
{{- if .Query}}
	q, err := rt.ParseQuery(r)
	if err != nil {
		return err
	}
{{- else if .Fields}}
	var err error
{{- end}}
	var in {{.In}}
{{- range .Fields}}
{{- if eq .Source "form"}}
	vals, err := rt.{{if $route.API}}JSONValues{{else if .Multipart}}MultipartValues{{else}}FormValues{{end}}(r{{range .Keys}}, {{.}}{{end}})
	if err != nil {
		return err
	}
	bind{{.Form}}(r, vals, &in.{{.Name}})
{{- if $route.API}}
	if !in.{{.Name}}.Valid() { // an API form is never a GET's: Forms rejects it
		return invalid{{.Form}}(&in.{{.Name}})
	}
{{- end}}
{{- else if eq .Source "path"}}
	if in.{{.Name}}, err = rt.Path(r, {{printf "%q" .Key}}, rt.Parse{{.Parser}}); err != nil {
		return err
	}
{{- else if .Pointer}}
	if v, ok, err := rt.Query(q, {{printf "%q" .Key}}, rt.Parse{{.Parser}}, false); err != nil {
		return err
	} else if ok {
		in.{{.Name}} = &v
	}
{{- else}}
	if in.{{.Name}}, _, err = rt.Query(q, {{printf "%q" .Key}}, rt.Parse{{.Parser}}, true); err != nil {
		return err
	}
{{- end}}
{{- end}}
{{- if .User}}
{{- if .UserPtr}}
	var u *{{.User}}
	if v, ok := maago.UserFrom[{{.User}}](r.Context()); ok {
		u = &v
	}
{{- else}}
	u, _ := maago.UserFrom[{{.User}}](r.Context()) // the route requires login
{{- end}}
{{- end}}
{{- if .Tx}}
	// The view runs in a transaction, and its page is drawn before the
	// commit: one that fails to draw rolls it back.
	b := rt.NewBuffer()
{{- if .Result}}
	to := ""
{{- end}}
	txErr := maago.WithTx(r.Context(), maago.DBFrom(r.Context()), func(ctx context.Context, tx maago.Tx) error {
		p, err := {{.View}}(ctx{{if .User}}, u{{end}}, tx, in)
		if err != nil {
			return err
		}
{{- if .Result}}
		page, next := p.Page()
		if next != "" {
			to = next
			return nil
		}
{{- else}}
		page := p
{{- end}}
{{- if .API}}
		return rt.JSON(b, page)
{{- else}}
		return rt.Render(b, maagoPages, {{printf "%q" .Template}}, {{printf "%q" .Block}}, page)
{{- end}}
	})
	if txErr != nil {
		return txErr
	}
{{- if .Result}}
	if to != "" {
		http.Redirect(w, r, to, http.StatusSeeOther)
		return nil
	}
{{- end}}
	return b.Send(w)
{{- else}}
	p, err := {{.View}}(r.Context(){{if .User}}, u{{end}}{{if .DB}}, maago.DBFrom(r.Context()){{end}}, in)
	if err != nil {
		return err
	}
{{- if .Result}}
	page, to := p.Page()
	if to != "" {
		http.Redirect(w, r, to, http.StatusSeeOther)
		return nil
	}
{{- else}}
	page := p
{{- end}}
{{- if .API}}
	return rt.JSON(w, page)
{{- else}}
	return rt.Render(w, maagoPages, {{printf "%q" .Template}}, {{printf "%q" .Block}}, page)
{{- end}}
{{- end}}
{{- end}}
}
{{end}}
{{- range .Forms}}
// bind{{.Name}} reads form {{.Name}} from the values the request sent, or
// for a GET or HEAD, which sends none, only describes its fields, for
// drawing it empty.
func bind{{.Name}}(r *http.Request, vals url.Values, f *{{.Name}}) {
{{- range .Fields}}
	rt.{{.Bind}}({{.Arg}}, vals, &f.{{.Name}}, {{.Rule}})
{{- end}}
	ok := func() bool {
		return {{range $i, $f := .Fields}}{{if $i}} && {{end}}f.{{$f.Name}}.Error == ""{{else}}true{{end}}
	}
{{- if .Validate}}
	if vals != nil && ok() {
		f.Validate()
	}
{{- end}}
	rt.FinishForm(r.Context(), &f.Form, vals != nil, ok())
}
{{- if .API}}

// invalid{{.Name}} is the 422 of form {{.Name}} on an API route.
func invalid{{.Name}}(f *{{.Name}}) error {
	return rt.Unprocessable([]rt.FieldError{
{{- range .Fields}}
		{Field: f.{{.Name}}.Name, Detail: f.{{.Name}}.Error},
{{- end}}
	}, f.Errors)
}
{{- end}}
{{end}}
