{{.Marker}}

package {{.Package}}

import (
{{range .Imports}}{{if .}}	"{{.}}"{{end}}
{{end}})
{{if .HTML}}
//go:embed templates/*.html
var maagoTemplateFiles embed.FS

// maagoRoutes are the paths of every route of the project, for {{"{{"}}url{{"}}"}}.
var maagoRoutes = map[string]string{
{{range .AllRoutes}}	{{printf "%q" .Name}}: {{printf "%q" .Path}},
{{end}}}

// maagoPages are the template sets of the pages: base.html, if there is
// one, and the page.
var maagoPages = maago.Pages(maagoTemplateFiles, template.FuncMap{"url": maago.URLFunc(maagoRoutes)},
{{range .Pages}}	{{printf "%q" .}},
{{end}})
{{end}}{{range .Routes}}
// {{.Serve}} serves route {{.Name}} with view {{.View}}.
func {{.Serve}}(w http.ResponseWriter, r *http.Request) error {
{{- if .Escape}}
	{{.View}}(w, r)
	return nil
{{- else}}
{{- if .Query}}
	q, err := maago.ParseQuery(r)
	if err != nil {
		return err
	}
{{- else if .Fields}}
	var err error
{{- end}}
	var in {{.In}}
{{- range .Fields}}
{{- if eq .Source "path"}}
	if in.{{.Name}}, err = maago.Path(r, {{printf "%q" .Key}}, maago.Parse{{.Parser}}); err != nil {
		return err
	}
{{- else if .Pointer}}
	if v, ok, err := maago.Query(q, {{printf "%q" .Key}}, maago.Parse{{.Parser}}, false); err != nil {
		return err
	} else if ok {
		in.{{.Name}} = &v
	}
{{- else}}
	if in.{{.Name}}, _, err = maago.Query(q, {{printf "%q" .Key}}, maago.Parse{{.Parser}}, true); err != nil {
		return err
	}
{{- end}}
{{- end}}
	p, err := {{.View}}(r.Context(), in)
	if err != nil {
		return err
	}
{{- if .Result}}
	page, to := p.Page()
	if to != "" {
		http.Redirect(w, r, to, http.StatusSeeOther)
		return nil
	}
{{- else}}
	page := p
{{- end}}
{{- if .API}}
	return maago.JSON(w, page)
{{- else}}
	return maago.Render(w, maagoPages, {{printf "%q" .Template}}, {{printf "%q" .Block}}, page)
{{- end}}
{{- end}}
}
{{end}}
