{{.Marker}}

package {{.Package}}

import (
{{range .Imports}}{{if .}}	"{{.}}"{{end}}
{{end}})
{{if .Static}}
//go:embed static
var maagoStaticFiles embed.FS

// maagoStatic are the files of static/, with the names the project's
// templates ask for (D-136).
var maagoStatic = maago.Static({{printf "%q" .Package}}, maagoStaticFiles{{range .Used}}, {{printf "%q" .}}{{end}})
{{end}}{{if .HTML}}
//go:embed templates/*.html
var maagoTemplateFiles embed.FS

// maagoRoutes are the paths of every route of the project, for {{"{{"}}url{{"}}"}}.
var maagoRoutes = map[string]string{
{{range .AllRoutes}}	{{printf "%q" .Name}}: {{printf "%q" .Path}},
{{end}}}

// maagoPages are the template sets of the pages: base.html, if there is
// one, and the page.
var maagoPages = maago.Pages(maagoTemplateFiles, template.FuncMap{"url": maago.URLFunc(maagoRoutes), "date": maago.DateFunc, "static": maago.StaticFunc},
{{range .Pages}}	{{printf "%q" .}},
{{end}})
{{end}}{{range $route := .Routes}}
// {{.Serve}} serves route {{.Name}} with view {{.View}}.
func {{.Serve}}(w http.ResponseWriter, r *http.Request) error {
{{- if .Escape}}
	{{.View}}(w, r)
	return nil
{{- else}}
{{- if .Query}}
	q, err := maago.ParseQuery(r)
	if err != nil {
		return err
	}
{{- else if .Fields}}
	var err error
{{- end}}
	var in {{.In}}
{{- range .Fields}}
{{- if eq .Source "form"}}
	vals, err := maago.{{if $route.API}}JSONValues{{else if .Multipart}}MultipartValues{{else}}FormValues{{end}}(r{{range .Keys}}, {{.}}{{end}})
	if err != nil {
		return err
	}
	bind{{.Form}}(r, vals, &in.{{.Name}})
{{- if $route.API}}
	if !in.{{.Name}}.Valid() { // an API form is never a GET's: Forms rejects it
		return invalid{{.Form}}(&in.{{.Name}})
	}
{{- end}}
{{- else if eq .Source "path"}}
	if in.{{.Name}}, err = maago.Path(r, {{printf "%q" .Key}}, maago.Parse{{.Parser}}); err != nil {
		return err
	}
{{- else if .Pointer}}
	if v, ok, err := maago.Query(q, {{printf "%q" .Key}}, maago.Parse{{.Parser}}, false); err != nil {
		return err
	} else if ok {
		in.{{.Name}} = &v
	}
{{- else}}
	if in.{{.Name}}, _, err = maago.Query(q, {{printf "%q" .Key}}, maago.Parse{{.Parser}}, true); err != nil {
		return err
	}
{{- end}}
{{- end}}
	p, err := {{.View}}(r.Context(), in)
	if err != nil {
		return err
	}
{{- if .Result}}
	page, to := p.Page()
	if to != "" {
		http.Redirect(w, r, to, http.StatusSeeOther)
		return nil
	}
{{- else}}
	page := p
{{- end}}
{{- if .API}}
	return maago.JSON(w, page)
{{- else}}
	return maago.Render(w, maagoPages, {{printf "%q" .Template}}, {{printf "%q" .Block}}, page)
{{- end}}
{{- end}}
}
{{end}}
{{- range .Forms}}
// bind{{.Name}} reads form {{.Name}} from the values the request sent, or
// for a GET or HEAD, which sends none, only describes its fields, for
// drawing it empty (D-119).
func bind{{.Name}}(r *http.Request, vals url.Values, f *{{.Name}}) {
{{- range .Fields}}
	maago.{{.Bind}}({{.Arg}}, vals, &f.{{.Name}}, {{.Rule}})
{{- end}}
	ok := func() bool {
		return {{range $i, $f := .Fields}}{{if $i}} && {{end}}f.{{$f.Name}}.Error == ""{{else}}true{{end}}
	}
{{- if .Validate}}
	if vals != nil && ok() {
		f.Validate()
	}
{{- end}}
	maago.FinishForm(&f.Form, vals != nil, ok())
}
{{- if .API}}

// invalid{{.Name}} is the 422 of form {{.Name}} on an API route (D-120).
func invalid{{.Name}}(f *{{.Name}}) error {
	return maago.Unprocessable([]maago.FieldError{
{{- range .Fields}}
		{Field: f.{{.Name}}.Name, Detail: f.{{.Name}}.Error},
{{- end}}
	}, f.Errors)
}
{{- end}}
{{end}}
