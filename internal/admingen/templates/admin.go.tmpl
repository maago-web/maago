{{.Marker}}

// The admin's view of the models (D-131). Its columns, its search and
// what it hides come from the models' admin tags (D-132): change the
// tags, then run maago gen.
{{- if .NoAdd}}
//
// Models with no adding in the admin (D-132):
//
{{- range .NoAdd}}
//   - {{.}}
{{- end}}
{{- end}}

package {{.Package}}

import (
{{range .Imports}}{{if .}}	"{{.}}"{{end}}
{{end}})

var Admin = []admin.Model{
{{range .Models}}	{
		App:  "{{$.Package}}",
		Name: "{{.Name}}",
		Fields: []admin.Field{
{{range .Fields}}			{Name: "{{.Name}}", Label: {{printf "%q" .Label}}{{if .Help}}, Help: {{printf "%q" .Help}}{{end}}{{if .ReadOnly}}, ReadOnly: true{{end}}{{if .FK}}, FK: "{{.FK}}"{{end}}},
{{end}}		},
		List: []string{ {{range $i, $n := .List}}{{if $i}}, {{end}}"{{$n}}"{{end}} },
{{- if .Search}}
		Search: []string{ {{range $i, $n := .Search}}{{if $i}}, {{end}}"{{$n}}"{{end}} },
{{- end}}
{{- if .Filters}}
		Filters: []admin.Filter{
{{- range .Filters}}
			{Key: "{{.Key}}", Field: "{{.Field}}", Kind: "{{.Kind}}"{{.Choices}}},
{{- end}}
		},
{{- end}}
		Rows: func(ctx context.Context, db maago.DB, q admin.Query) ([]admin.Row, error) {
			{{.RowsArgs}}vs, err := maago.Many(ctx, db, scan{{.Name}}, {{.ListSQL}}, {{.Args}}q.Limit, q.Offset)
			if err != nil {
				return nil, err
			}
			rows := make([]admin.Row, len(vs))
			for i, v := range vs {
				rows[i] = admin.Row{ID: v.ID, Cells: []any{ {{range $i, $n := .List}}{{if $i}}, {{end}}v.{{$n}}{{end}} }}
			}
			return rows, nil
		},
		Count: func(ctx context.Context, db maago.DB, q admin.Query) (n int64, err error) {
			{{.CountArgs}}err = db.QueryRowContext(ctx, {{.CountSQL}}{{if .Args}}, {{.ArgList}}{{end}}).Scan(&n)
			return n, err
		},
		Form: {{.Form}},
		Delete: Delete{{.Name}},
		Refs: func(ctx context.Context, db maago.DB, id int64) ([]admin.Ref, error) {
			return admin.CountRefs(ctx, db, id, {{.Row}}, {{if .Refs}}[]admin.Ref{
{{- range .Refs}}
				{Model: "{{.Model}}", Field: "{{.Field}}", SQL: {{.SQL}}{{.Self}}},
{{- end}}
			}{{else}}nil{{end}})
		},
{{- if .Add}}
		Add: true,
{{- end}}
{{- if .Edit}}
		Edit: true,
{{- end}}
	},
{{end}}}
