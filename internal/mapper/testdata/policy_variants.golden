-- variant 1, args: now, viewer_id, viewer_is_staff; slices:
-- q absent, board_id absent
SELECT p.id FROM board_post p
WHERE
  (NOT p.hidden AND (p.status <> 'draft' AND (p.publish_at IS NULL OR p.publish_at <= $1) OR p.author_id = $2 OR $3))
ORDER BY p.publish_at < $1

-- variant 2, args: board_id, now, viewer_id, viewer_is_staff; slices:
-- q absent, board_id present
SELECT p.id FROM board_post p
WHERE
  p.board_id = $1
  AND (NOT p.hidden AND (p.status <> 'draft' AND (p.publish_at IS NULL OR p.publish_at <= $2) OR p.author_id = $3 OR $4))
ORDER BY p.publish_at < $2

-- variant 3, args: now, viewer_id, viewer_is_staff, q; slices:
-- q present, board_id absent
SELECT p.id FROM board_post p
WHERE
  (NOT p.hidden AND (p.status <> 'draft' AND (p.publish_at IS NULL OR p.publish_at <= $1) OR p.author_id = $2 OR $3))
  AND p.status = $4
ORDER BY p.publish_at < $1

-- variant 4, args: board_id, now, viewer_id, viewer_is_staff, q; slices:
-- q present, board_id present
SELECT p.id FROM board_post p
WHERE
  p.board_id = $1
  AND (NOT p.hidden AND (p.status <> 'draft' AND (p.publish_at IS NULL OR p.publish_at <= $2) OR p.author_id = $3 OR $4))
  AND p.status = $5
ORDER BY p.publish_at < $2
