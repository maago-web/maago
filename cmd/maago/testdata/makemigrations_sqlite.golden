-- migrations/0001_initial.sql

CREATE TABLE "blog_author" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "name" TEXT NOT NULL
) STRICT;

CREATE TABLE "blog_post" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "author_id" INTEGER NOT NULL,
    "title" TEXT NOT NULL CHECK (length("title") <= 200),
    "text" TEXT NOT NULL CHECK (length("text") <= 500),
    CONSTRAINT "blog_post_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "blog_author" ("id") ON DELETE NO ACTION
) STRICT;

CREATE INDEX "blog_post_text_idx" ON "blog_post" ("text");

CREATE INDEX "blog_post_author_id_idx" ON "blog_post" ("author_id");

-- migrations/0002_add_blog_post_slug.sql

ALTER TABLE "blog_post" ADD COLUMN "slug" TEXT NOT NULL DEFAULT '' CHECK (length("slug") <= 50);

CREATE INDEX "blog_post_slug_idx" ON "blog_post" ("slug");

-- migrations/0003_blog_post.sql

-- ⚠ Column "text" of "blog_post" is dropped and column "body" is added. If "body" is "text" renamed, keep its values: delete this file, then run maago makemigrations --rename blog_post.text:body

DROP INDEX "blog_post_text_idx";

-- ⚠ This drops column "text" of "blog_post" and its values. If that is intended, put "-- maago: allow-drop" on the line right before the DROP statement.
ALTER TABLE "blog_post" DROP COLUMN "text";

ALTER TABLE "blog_post" ADD COLUMN "body" TEXT CHECK (length("body") <= 500);

CREATE INDEX "blog_post_body_idx" ON "blog_post" ("body");

-- migrations/0003_blog_post.sql

ALTER TABLE "blog_post" RENAME COLUMN "text" TO "body";

