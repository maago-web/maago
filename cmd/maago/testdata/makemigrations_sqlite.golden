    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "author_id" INTEGER NOT NULL,
    "title" TEXT NOT NULL CHECK (length("title") <= 200),
    "slug" TEXT NOT NULL DEFAULT '' CHECK (length("slug") <= 50),
    "body" TEXT CHECK (length("body") <= 500),
    CONSTRAINT "blog_post_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "blog_author" ("id") ON DELETE NO ACTION
) STRICT;

INSERT INTO "maago_new_blog_post" ("id", "author_id", "title", "slug", "body") SELECT "id", "author_id", "title", "slug", "body" FROM "blog_post";

DELETE FROM sqlite_sequence WHERE name = 'maago_new_blog_post';

INSERT INTO sqlite_sequence (name, seq) SELECT 'maago_new_blog_post', seq FROM sqlite_sequence WHERE name = 'blog_post';

DROP TABLE "blog_post";

