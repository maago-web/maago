-- initial

CREATE TABLE "blog_author" (
    "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "name" TEXT NOT NULL
);

CREATE TABLE "blog_comment" (
    "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "post_id" BIGINT NOT NULL,
    "parent_id" BIGINT
);

CREATE INDEX "blog_comment_post_id_idx" ON "blog_comment" ("post_id");

CREATE INDEX "blog_comment_parent_id_idx" ON "blog_comment" ("parent_id");

CREATE TABLE "blog_post" (
    "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "author_id" BIGINT NOT NULL,
    "title" VARCHAR(200) NOT NULL,
    "views" INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX "blog_post_author_id_idx" ON "blog_post" ("author_id");

CREATE TABLE "blog_tag" (
    "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "label" TEXT NOT NULL
);

ALTER TABLE "blog_comment" ADD CONSTRAINT "blog_comment_post_id_fkey" FOREIGN KEY ("post_id") REFERENCES "blog_post" ("id") ON DELETE NO ACTION;

ALTER TABLE "blog_comment" ADD CONSTRAINT "blog_comment_parent_id_fkey" FOREIGN KEY ("parent_id") REFERENCES "blog_comment" ("id") ON DELETE NO ACTION;

ALTER TABLE "blog_post" ADD CONSTRAINT "blog_post_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "blog_author" ("id") ON DELETE NO ACTION;

-- add nullable field

ALTER TABLE "blog_post" ADD COLUMN "summary" TEXT;

-- add field without default

-- ⚠ Column "body" of "blog_post" is NOT NULL without a default, so this fails if "blog_post" has rows. Give the field a default, or add it as a pointer, fill it, then make it NOT NULL.
ALTER TABLE "blog_post" ADD COLUMN "body" TEXT NOT NULL;

-- add field with max and default

ALTER TABLE "blog_post" ADD COLUMN "lang" VARCHAR(5) NOT NULL DEFAULT 'ko';

-- add foreign key field

ALTER TABLE "blog_post" ADD COLUMN "editor_id" BIGINT;

CREATE INDEX "blog_post_editor_id_idx" ON "blog_post" ("editor_id");

ALTER TABLE "blog_post" ADD CONSTRAINT "blog_post_editor_id_fkey" FOREIGN KEY ("editor_id") REFERENCES "blog_author" ("id") ON DELETE NO ACTION;

-- add field with choices

ALTER TABLE "blog_post" ADD COLUMN "status" TEXT NOT NULL DEFAULT 'draft' CHECK ("status" IN ('draft', 'published'));

-- add fields with unusual defaults

ALTER TABLE "blog_post" ADD COLUMN "ratio" DOUBLE PRECISION NOT NULL DEFAULT 1e-07;

ALTER TABLE "blog_post" ADD COLUMN "delta" INTEGER NOT NULL DEFAULT -3;

-- drop field

-- ⚠ This drops column "views" of "blog_post" and its values. If that is intended, put "-- maago: allow-drop" on the line right before the DROP statement.
ALTER TABLE "blog_post" DROP COLUMN "views";

-- drop foreign key field

ALTER TABLE "blog_post" DROP CONSTRAINT "blog_post_author_id_fkey";

DROP INDEX "blog_post_author_id_idx";

-- ⚠ This drops column "author_id" of "blog_post" and its values. If that is intended, put "-- maago: allow-drop" on the line right before the DROP statement.
ALTER TABLE "blog_post" DROP COLUMN "author_id";

-- type

ALTER TABLE "blog_post" ALTER COLUMN "views" DROP DEFAULT;

ALTER TABLE "blog_post" ALTER COLUMN "views" TYPE DOUBLE PRECISION USING "views"::DOUBLE PRECISION;

ALTER TABLE "blog_post" ALTER COLUMN "views" SET DEFAULT 0;

-- type and default

ALTER TABLE "blog_post" ALTER COLUMN "code" DROP DEFAULT;

ALTER TABLE "blog_post" ALTER COLUMN "code" TYPE BIGINT USING "code"::BIGINT;

ALTER TABLE "blog_post" ALTER COLUMN "code" SET DEFAULT 0;

-- max

ALTER TABLE "blog_post" ALTER COLUMN "title" TYPE VARCHAR(100) USING "title"::TEXT;

-- nullable

ALTER TABLE "blog_post" ALTER COLUMN "title" DROP NOT NULL;

-- default

ALTER TABLE "blog_post" ALTER COLUMN "views" SET DEFAULT 1;

-- add unique

ALTER TABLE "blog_tag" ADD CONSTRAINT "blog_tag_label_key" UNIQUE ("label");

-- drop unique

ALTER TABLE "blog_tag" DROP CONSTRAINT "blog_tag_label_key";

-- add choices

ALTER TABLE "blog_post" ADD CONSTRAINT "blog_post_status_check" CHECK ("status" IN ('draft', 'published'));

-- drop model

-- ⚠ This drops table "blog_comment" and all its rows. If that is intended, put "-- maago: allow-drop" on the line right before the DROP statement.
DROP TABLE "blog_comment";

-- by hand

ALTER TABLE "blog_post" DROP CONSTRAINT "blog_post_author_id_fkey";

ALTER TABLE "blog_tag" ALTER COLUMN "id" DROP IDENTITY;

ALTER TABLE "blog_tag" DROP CONSTRAINT "tag_key";

ALTER TABLE "blog_comment" ALTER COLUMN "id" DROP DEFAULT;

ALTER TABLE "blog_author" ALTER COLUMN "id" SET GENERATED BY DEFAULT;

ALTER TABLE "blog_comment" ALTER COLUMN "id" ADD GENERATED BY DEFAULT AS IDENTITY;

ALTER TABLE "blog_tag" ADD CONSTRAINT "blog_tag_pkey" PRIMARY KEY ("id");

ALTER TABLE "blog_tag" ALTER COLUMN "id" ADD GENERATED BY DEFAULT AS IDENTITY;

ALTER TABLE "blog_post" ADD CONSTRAINT "blog_post_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "blog_author" ("id") ON DELETE NO ACTION;

-- unique constraint

ALTER TABLE "blog_tag" DROP CONSTRAINT "tag_label_key";

