== checks
table "t" strict=false pk=[] auto=""
  column "a" TEXT notnull=false default=""
  column "b" TEXT notnull=false default=""
  column "c" INTEGER notnull=false default=""
  check "t_a_check" column="a" ( A < > '' : : TEXT )
  check "t_ab" column="" ( A < > B )
  check "b_choice" column="b" ( B = ANY ( ARRAY [ 'x,(' : : TEXT , 'y' : : TEXT ] ) )
  check "t_c_check" column="c" ( C > 0 )
  check "t_a_check1" column="a" ( LENGTH ( A ) < 10 )
== keys
table "c" strict=false pk=["id"] auto="ALWAYS"
  column "id" BIGINT notnull=true default=""
  column "x" INTEGER notnull=false default=""
  column "y" INTEGER notnull=false default=""
  column "n" INTEGER notnull=false default=""
  column "d" INTEGER notnull=false default="1"
  column "r" INTEGER notnull=false default=""
  fk "c_d_fkey" ["d"] -> "c" ["id"] delete=SET DEFAULT update=NO ACTION
  fk "c_n_fkey" ["n"] -> "c" ["id"] delete=SET NULL update=NO ACTION
  fk "c_r_fkey" ["r"] -> "c" ["id"] delete=RESTRICT update=NO ACTION
  fk "c_xy_fkey" ["x" "y"] -> "p" ["y" "x"] delete=NO ACTION update=CASCADE
table "p" strict=false pk=["y" "x"] auto=""
  column "x" INTEGER notnull=true default=""
  column "y" INTEGER notnull=true default=""
== foreign keys on the same column
table "a" strict=false pk=["id"] auto=""
  column "id" INTEGER notnull=true default=""
table "b" strict=false pk=["id"] auto=""
  column "id" INTEGER notnull=true default=""
table "c" strict=false pk=[] auto=""
  column "x" INTEGER notnull=false default=""
  fk "c_x_a" ["x"] -> "a" ["id"] delete=NO ACTION update=NO ACTION
  fk "c_x_b" ["x"] -> "b" ["id"] delete=NO ACTION update=NO ACTION
== names that are keywords
table "t" strict=false pk=[] auto=""
  column "match" INTEGER notnull=false default=""
  column "order" INTEGER notnull=false default=""
  unique constraint "t_match_order_key" ["match" "order"]
== added column
table "t" strict=false pk=[] auto=""
  column "a" TEXT notnull=false default=""
  column "c" TEXT notnull=false default=""
  check "t_c_check" column="c" ( C < > '' : : TEXT )
== renamed column
table "t" strict=false pk=[] auto=""
  column "b" TEXT notnull=false default=""
  check "t_a_check" column="b" ( LENGTH ( B ) < 10 )
== dropped column
table "t" strict=false pk=[] auto=""
  column "b" TEXT notnull=false default=""
  check "t_b_check" column="b" ( B < > '' : : TEXT )
