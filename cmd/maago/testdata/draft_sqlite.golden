-- initial

CREATE TABLE "blog_author" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "name" TEXT NOT NULL
) STRICT;

CREATE TABLE "blog_comment" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "post_id" INTEGER NOT NULL,
    "parent_id" INTEGER,
    CONSTRAINT "blog_comment_post_id_fkey" FOREIGN KEY ("post_id") REFERENCES "blog_post" ("id") ON DELETE NO ACTION,
    CONSTRAINT "blog_comment_parent_id_fkey" FOREIGN KEY ("parent_id") REFERENCES "blog_comment" ("id") ON DELETE NO ACTION
) STRICT;

CREATE INDEX "blog_comment_post_id_idx" ON "blog_comment" ("post_id");

CREATE INDEX "blog_comment_parent_id_idx" ON "blog_comment" ("parent_id");

CREATE TABLE "blog_post" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "author_id" INTEGER NOT NULL,
    "title" TEXT NOT NULL CHECK (length("title") <= 200),
    "views" INTEGER NOT NULL DEFAULT 0,
    CONSTRAINT "blog_post_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "blog_author" ("id") ON DELETE NO ACTION
) STRICT;

CREATE INDEX "blog_post_author_id_idx" ON "blog_post" ("author_id");

CREATE TABLE "blog_tag" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "label" TEXT NOT NULL
) STRICT;

-- add nullable field

ALTER TABLE "blog_post" ADD COLUMN "summary" TEXT;

-- add field without default

CREATE TABLE "maago_new_blog_post" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "author_id" INTEGER NOT NULL,
    "title" TEXT NOT NULL CHECK (length("title") <= 200),
    "body" TEXT NOT NULL,
    "views" INTEGER NOT NULL DEFAULT 0,
    CONSTRAINT "blog_post_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "blog_author" ("id") ON DELETE NO ACTION
) STRICT;

-- ⚠ Column "body" of "blog_post" is NOT NULL without a default, so this fails if "blog_post" has rows. Give the field a default, or add it as a pointer, fill it, then make it NOT NULL.
INSERT INTO "maago_new_blog_post" ("id", "author_id", "title", "views") SELECT "id", "author_id", "title", "views" FROM "blog_post";

DELETE FROM sqlite_sequence WHERE name = 'maago_new_blog_post';

INSERT INTO sqlite_sequence (name, seq) SELECT 'maago_new_blog_post', seq FROM sqlite_sequence WHERE name = 'blog_post';

DROP TABLE "blog_post";

ALTER TABLE "maago_new_blog_post" RENAME TO "blog_post";

CREATE INDEX "blog_post_author_id_idx" ON "blog_post" ("author_id");

-- add version field

CREATE TABLE "maago_new_blog_post" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "author_id" INTEGER NOT NULL,
    "title" TEXT NOT NULL CHECK (length("title") <= 200),
    "updated_at" TEXT NOT NULL,
    "views" INTEGER NOT NULL DEFAULT 0,
    CONSTRAINT "blog_post_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "blog_author" ("id") ON DELETE NO ACTION
) STRICT;

-- ⚠ Column "updated_at" of "blog_post" is NOT NULL without a default, so this fails if "blog_post" has rows. Give the field a default, or add it as a pointer, fill it, then make it NOT NULL.
-- ⚠ Fill "updated_at" as maago writes a time, UTC to the microsecond: strftime('%Y-%m-%d %H:%M:%f', 'now') || '000'. As CURRENT_TIMESTAMP writes it, every Update of the row is a conflict.
INSERT INTO "maago_new_blog_post" ("id", "author_id", "title", "views") SELECT "id", "author_id", "title", "views" FROM "blog_post";

DELETE FROM sqlite_sequence WHERE name = 'maago_new_blog_post';

INSERT INTO sqlite_sequence (name, seq) SELECT 'maago_new_blog_post', seq FROM sqlite_sequence WHERE name = 'blog_post';

DROP TABLE "blog_post";

ALTER TABLE "maago_new_blog_post" RENAME TO "blog_post";

CREATE INDEX "blog_post_author_id_idx" ON "blog_post" ("author_id");

-- add field with max and default

ALTER TABLE "blog_post" ADD COLUMN "lang" TEXT NOT NULL DEFAULT 'ko' CHECK (length("lang") <= 5);

-- add foreign key field

CREATE TABLE "maago_new_blog_post" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "author_id" INTEGER NOT NULL,
    "title" TEXT NOT NULL CHECK (length("title") <= 200),
    "editor_id" INTEGER,
    "views" INTEGER NOT NULL DEFAULT 0,
    CONSTRAINT "blog_post_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "blog_author" ("id") ON DELETE NO ACTION,
    CONSTRAINT "blog_post_editor_id_fkey" FOREIGN KEY ("editor_id") REFERENCES "blog_author" ("id") ON DELETE NO ACTION
) STRICT;

INSERT INTO "maago_new_blog_post" ("id", "author_id", "title", "views") SELECT "id", "author_id", "title", "views" FROM "blog_post";

DELETE FROM sqlite_sequence WHERE name = 'maago_new_blog_post';

INSERT INTO sqlite_sequence (name, seq) SELECT 'maago_new_blog_post', seq FROM sqlite_sequence WHERE name = 'blog_post';

DROP TABLE "blog_post";

ALTER TABLE "maago_new_blog_post" RENAME TO "blog_post";

CREATE INDEX "blog_post_author_id_idx" ON "blog_post" ("author_id");

CREATE INDEX "blog_post_editor_id_idx" ON "blog_post" ("editor_id");

-- add field with choices

ALTER TABLE "blog_post" ADD COLUMN "status" TEXT NOT NULL DEFAULT 'draft' CHECK ("status" IN ('draft', 'published'));

-- add fields with unusual defaults

ALTER TABLE "blog_post" ADD COLUMN "ratio" REAL NOT NULL DEFAULT 1e-07;

ALTER TABLE "blog_post" ADD COLUMN "delta" INTEGER NOT NULL DEFAULT -3;

