== bracket name
table "t" strict=false pk=[] auto=""
  column "order" INTEGER notnull=false default=""
  column "b" INTEGER notnull=false default=""
table "t" has a column name quoted with [, which maago does not support
  fix: quote the name with "…" instead
== ON CONFLICT
table "t" strict=false pk=[] auto=""
  column "a" INTEGER notnull=false default=""
  unique constraint "sqlite_autoindex_t_1" ["a"]
table "t" has ON CONFLICT on column "a", which maago does not support
  fix: remove it from the migrations
== DEFERRABLE
table "p" strict=false pk=["id"] auto=""
  column "id" INTEGER notnull=false default=""
table "t" strict=false pk=[] auto=""
  column "p_id" INTEGER notnull=false default=""
  fk ["p_id"] -> "p" ["id"] delete=NO ACTION update=NO ACTION
table "t" has DEFERRABLE on column "p_id", which maago does not support
  fix: remove it from the migrations
== MATCH
table "p" strict=false pk=["id"] auto=""
  column "id" INTEGER notnull=false default=""
table "t" strict=false pk=[] auto=""
  column "p_id" INTEGER notnull=false default=""
  fk ["p_id"] -> "p" ["id"] delete=NO ACTION update=NO ACTION
