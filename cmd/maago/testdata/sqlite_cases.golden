== unknown table
table "t" strict=false pk=[] auto=""
  column "p_id" INTEGER notnull=false default=""
  column "b" INTEGER notnull=false default=""
  fk ["p_id"] -> "nosuch" ["id"] delete=NO ACTION update=NO ACTION
foreign key of "t" references unknown table "nosuch"
  fix: create that table in the migrations, or fix the name after REFERENCES
