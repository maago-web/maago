From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maago <maago@example.com>
Date: Mon, 12 Oct 2026 23:40:13 +0900
Subject: [PATCH] Delete what has no comments

Deleting deletes now, for a post without comments.

In 0015 deleting was hiding. A comment's post_id points at its post,
and the foreign key is ON DELETE NO ACTION, so a post with comments
cannot go (maago does not cascade deletes by default). Now that only
the author deletes (0022), a post without comments goes with
DeletePost, and one with comments is hidden as before.

- Whether it has comments, the PostComments that is already there
  tells. No new query
- The view's name changes from HidePost to RemovePost, with the same
  signature (ctx, u auth.User, tx maago.Tx, in PostIn). DeletePost is
  taken: maago generates it for Post. Name views clear of the generated
  GetX, InsertX, UpdateX and DeleteX

With this the board has accounts: sign-up and verification, sign-in,
authors, only the author publishing, archiving and deleting, and API
tokens.

diff --git a/board/urls.go b/board/urls.go
index 641e9aa..809df22 100644
--- a/board/urls.go
+++ b/board/urls.go
@@ -17,7 +17,7 @@ var Routes = maago.Routes{
 	maago.POST("/posts/{id}", "comment_create", CreateComment),
 	maago.POST("/posts/{id}/publish", "post_publish", Publish),
 	maago.POST("/posts/{id}/archive", "post_archive", Archive),
-	maago.POST("/posts/{id}/delete", "post_delete", HidePost),
+	maago.POST("/posts/{id}/delete", "post_delete", RemovePost),
 
 	// JSON for a frontend on another origin: main trusts it in Config.Origins.
 	maago.GET("/api/boards/{id}/posts", "api_posts", APIPosts, maago.API),
diff --git a/board/views.go b/board/views.go
index 880ba58..4b213ac 100644
--- a/board/views.go
+++ b/board/views.go
@@ -115,10 +115,11 @@ func postPage(ctx context.Context, db maago.DB, id int64, f CommentForm) (PostPa
 	return PostPage{p, cs, f}, err
 }
 
-// HidePost deletes a post as people see it: it hides it, and its comments
-// with it. They stay in the database, so a comment never points at a post
-// that is gone.
-func HidePost(ctx context.Context, u auth.User, tx maago.Tx, in PostIn) (maago.Result[PostPage], error) {
+// RemovePost deletes a post. One without comments goes from the database;
+// one with comments is hidden, and its comments with it: they stay, so a
+// comment never points at a post that is gone (the foreign key would
+// refuse it).
+func RemovePost(ctx context.Context, u auth.User, tx maago.Tx, in PostIn) (maago.Result[PostPage], error) {
 	p, err := GetPost(ctx, tx, in.ID)
 	if err != nil {
 		return maago.Result[PostPage]{}, err
@@ -126,8 +127,17 @@ func HidePost(ctx context.Context, u auth.User, tx maago.Tx, in PostIn) (maago.R
 	if err := mayChange(u, p); err != nil {
 		return maago.Result[PostPage]{}, err
 	}
-	p.Hidden = true
-	if err := UpdatePost(ctx, tx, &p); err != nil {
+	cs, err := PostComments(ctx, tx, PostCommentsParams{PostID: p.ID})
+	if err != nil {
+		return maago.Result[PostPage]{}, err
+	}
+	if len(cs) == 0 {
+		err = DeletePost(ctx, tx, p.ID)
+	} else {
+		p.Hidden = true
+		err = UpdatePost(ctx, tx, &p)
+	}
+	if err != nil {
 		return maago.Result[PostPage]{}, err
 	}
 	return maago.SeeOther[PostPage](BoardDetailURL(p.BoardID)), nil
diff --git a/board/web_test.go b/board/web_test.go
index b73d99d..c88ae6e 100644
--- a/board/web_test.go
+++ b/board/web_test.go
@@ -580,3 +580,24 @@ func TestAuthors(t *testing.T) {
 		}
 	}
 }
+
+// A post without comments is deleted from the database.
+func TestDeleteWithoutComments(t *testing.T) {
+	h, db := app(t)
+	h, ann := signedIn(t, h, db, "ann@example.com")
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, AuthorID: &ann.ID, Title: "글", Body: "본문"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if code, loc, _ := post(h, PostDeleteURL(p.ID), nil); code != 303 || loc != BoardDetailURL(b.ID) {
+		t.Fatalf("delete: %d %q", code, loc)
+	}
+	if _, err := GetPost(ctx, db, p.ID); err != sql.ErrNoRows {
+		t.Errorf("the post is still there: %v", err)
+	}
+}
