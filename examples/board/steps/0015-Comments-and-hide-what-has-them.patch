diff --git a/board/queries/post_comments.sql b/board/queries/post_comments.sql
new file mode 100644
index 0000000..a9718c4
--- /dev/null
+++ b/board/queries/post_comments.sql
@@ -0,0 +1,7 @@
+-- name: PostComments :many Comment
+-- The comments of a post, oldest first.
+-- param: post_id int64
+SELECT id, post_id, text, created_at
+FROM board_comment
+WHERE post_id = :post_id
+ORDER BY created_at, id
