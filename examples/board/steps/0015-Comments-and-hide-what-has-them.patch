diff --git a/board/views.go b/board/views.go
index e21546a..2591ad9 100644
--- a/board/views.go
+++ b/board/views.go
@@ -66,14 +66,63 @@ type PostIn struct {
 	ID int64 `maago:"path=id"`
 }
 
+type ShowPostIn struct {
+	ID   int64       `maago:"path=id"`
+	Form CommentForm `maago:"form"`
+}
+
 type PostPage struct {
-	Post PostWithBoard
+	Post     PostWithBoard
+	Comments []Comment
+	Form     CommentForm
+}
+
+// ShowPost shows one post and its comments, and the form for one more.
+func ShowPost(ctx context.Context, db maago.DB, in ShowPostIn) (PostPage, error) {
+	return postPage(ctx, db, in.ID, in.Form)
+}
+
+// CreateComment adds a comment to the post, or shows the post again with
+// what is wrong with the form.
+func CreateComment(ctx context.Context, tx maago.Tx, in ShowPostIn) (maago.Result[PostPage], error) {
+	f := in.Form
+	page, err := postPage(ctx, tx, in.ID, f)
+	if err != nil {
+		return maago.Result[PostPage]{}, err
+	}
+	if !f.Valid() {
+		return maago.Show(page), nil
+	}
+	if _, err := InsertComment(ctx, tx, NewCommentInput{PostID: in.ID, Text: f.Text.Value}); err != nil {
+		return maago.Result[PostPage]{}, err
+	}
+	return maago.SeeOther[PostPage](PostDetailURL(in.ID)), nil
+}
+
+// postPage is the page of post id, with the comment form f. A hidden post
+// is not found.
+func postPage(ctx context.Context, db maago.DB, id int64, f CommentForm) (PostPage, error) {
+	p, err := PostDetail(ctx, db, PostDetailParams{ID: id})
+	if err != nil {
+		return PostPage{}, err
+	}
+	cs, err := PostComments(ctx, db, PostCommentsParams{PostID: p.ID})
+	return PostPage{p, cs, f}, err
 }
 
-// ShowPost shows one post.
-func ShowPost(ctx context.Context, db maago.DB, in PostIn) (PostPage, error) {
-	p, err := PostDetail(ctx, db, PostDetailParams{ID: in.ID})
-	return PostPage{p}, err
+// HidePost deletes a post as people see it: it hides it, and its comments
+// with it. They stay in the database, so a comment never points at a post
+// that is gone.
+func HidePost(ctx context.Context, tx maago.Tx, in PostIn) (maago.Result[PostPage], error) {
+	p, err := GetPost(ctx, tx, in.ID)
+	if err != nil {
+		return maago.Result[PostPage]{}, err
+	}
+	p.Hidden = true
+	if err := UpdatePost(ctx, tx, &p); err != nil {
+		return maago.Result[PostPage]{}, err
+	}
+	return maago.SeeOther[PostPage](BoardDetailURL(p.BoardID)), nil
 }
 
 type NewBoardIn struct {
diff --git a/board/web_test.go b/board/web_test.go
index 01bea0a..a0b282f 100644
--- a/board/web_test.go
+++ b/board/web_test.go
@@ -233,3 +233,43 @@ func TestPublishAndArchive(t *testing.T) {
 		t.Errorf("a stale copy: %v", err)
 	}
 }
+
+func TestCommentAndHide(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "글", Body: "본문"})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if code, _, body := post(h, CommentCreateURL(p.ID), url.Values{"text": {""}}); code != 200 || !strings.Contains(body, "This field is required.") {
+		t.Errorf("empty comment: %d %s", code, body)
+	}
+	if code, loc, _ := post(h, CommentCreateURL(p.ID), url.Values{"text": {"<i>첫 댓글</i>"}}); code != 303 || loc != PostDetailURL(p.ID) {
+		t.Fatalf("comment: %d %q", code, loc)
+	}
+	if code, body := get(h, PostDetailURL(p.ID)); code != 200 || !strings.Contains(body, "&lt;i&gt;첫 댓글") {
+		t.Errorf("post with its comment: %d %s", code, body)
+	}
+
+	if code, loc, _ := post(h, PostDeleteURL(p.ID), nil); code != 303 || loc != BoardDetailURL(b.ID) {
+		t.Fatalf("delete: %d %q", code, loc)
+	}
+	if code, _ := get(h, PostDetailURL(p.ID)); code != 404 {
+		t.Errorf("hidden post: %d", code)
+	}
+	if code, _, _ := post(h, CommentCreateURL(p.ID), url.Values{"text": {"늦은 댓글"}}); code != 404 {
+		t.Errorf("comment on a hidden post: %d", code)
+	}
+	if _, body := get(h, BoardDetailURL(b.ID)); !strings.Contains(body, "글이 없습니다.") {
+		t.Errorf("list:\n%s", body)
+	}
+	// The comment is still there, its post with it.
+	if cs, err := PostComments(ctx, db, PostCommentsParams{PostID: p.ID}); err != nil || len(cs) != 1 {
+		t.Errorf("%v %v", cs, err)
+	}
+}
