index 2591ad9..123157e 100644
--- a/board/views.go
+++ b/board/views.go
@@ -176,9 +176,7 @@ func NewPost(ctx context.Context, db maago.DB, in NewPostIn) (PostFormPage, erro
 	return PostFormPage{b, in.Form}, err // sql.ErrNoRows: a 404
 }
 
-// CreatePost writes a post on the board of the path. The same title twice
-// on one board would break the model's unique=(BoardID,Title) as a 500;
-// the view asks first and says so on the field.
+// CreatePost writes a post on the board of the path.
 func CreatePost(ctx context.Context, tx maago.Tx, in NewPostIn) (maago.Result[PostFormPage], error) {
 	b, err := GetBoard(ctx, tx, in.BoardID)
 	if err != nil {
@@ -188,32 +186,45 @@ func CreatePost(ctx context.Context, tx maago.Tx, in NewPostIn) (maago.Result[Po
 	if !f.Valid() {
 		return maago.Show(PostFormPage{b, f}), nil
 	}
-	taken, err := PostTitleTaken(ctx, tx, PostTitleTakenParams{BoardID: b.ID, Title: f.Title.Value})
+	p, ok, err := savePost(ctx, tx, b.ID, &f)
 	if err != nil {
 		return maago.Result[PostFormPage]{}, err
 	}
+	if !ok {
+		return maago.Show(PostFormPage{b, f}), nil
+	}
+	return maago.SeeOther[PostFormPage](PostDetailURL(p.ID)), nil
+}
+
+// savePost saves the post of a valid form f on board boardID, after what
+// only the database can check: the same title twice on one board would
+// break the model's unique=(BoardID,Title) as a 500, and two notices may
+// not be pinned at once. When one fails, it says so on f, as Validate
+// would, and reports false.
+func savePost(ctx context.Context, tx maago.Tx, boardID int64, f *PostForm) (Post, bool, error) {
+	taken, err := PostTitleTaken(ctx, tx, PostTitleTakenParams{BoardID: boardID, Title: f.Title.Value})
+	if err != nil {
+		return Post{}, false, err
+	}
 	if taken.N > 0 {
 		f.Title.Error = "이 게시판에 같은 제목의 글이 있습니다."
-		return maago.Show(PostFormPage{b, f}), nil
+		return Post{}, false, nil
 	}
 	if f.PinnedFrom.Given {
-		n, err := PinnedOverlap(ctx, tx, PinnedOverlapParams{BoardID: b.ID, From: f.PinnedFrom.Value, Until: f.PinnedUntil.Value})
+		n, err := PinnedOverlap(ctx, tx, PinnedOverlapParams{BoardID: boardID, From: f.PinnedFrom.Value, Until: f.PinnedUntil.Value})
 		if err != nil {
-			return maago.Result[PostFormPage]{}, err
+			return Post{}, false, err
 		}
 		if n.N > 0 {
 			f.AddError("이 기간에 고정된 다른 공지가 있습니다.")
-			return maago.Show(PostFormPage{b, f}), nil
+			return Post{}, false, nil
 		}
 	}
 	p, err := InsertPost(ctx, tx, NewPostInput{
-		BoardID: b.ID, Title: f.Title.Value, Body: f.Body.Value,
+		BoardID: boardID, Title: f.Title.Value, Body: f.Body.Value,
 		PinnedFrom: given(f.PinnedFrom), PinnedUntil: given(f.PinnedUntil), PublishAt: given(f.PublishAt),
 	})
-	if err != nil {
-		return maago.Result[PostFormPage]{}, err
-	}
-	return maago.SeeOther[PostFormPage](PostDetailURL(p.ID)), nil
+	return p, err == nil, err
 }
 
 // Publish publishes a draft.
@@ -242,3 +253,36 @@ func move(ctx context.Context, tx maago.Tx, id int64, to string) (maago.Result[P
 	}
 	return maago.SeeOther[PostPage](PostDetailURL(id)), nil
 }
+
+type APIPostsIn struct {
+	BoardID int64 `maago:"path=id"`
+}
+
+// APIPosts is the first page of a board as JSON, for a frontend of its
+// own: the same query as the board's page.
+func APIPosts(ctx context.Context, db maago.DB, in APIPostsIn) ([]PostSummary, error) {
+	if _, err := GetBoard(ctx, db, in.BoardID); err != nil {
+		return nil, err
+	}
+	return PostList(ctx, db, PostListParams{BoardID: in.BoardID, Now: time.Now(), Limit: pageSize})
+}
+
+// APICreatePost writes a post from a JSON object, with the same form as
+// CreatePost. A form that does not pass never gets here: the generated
+// code answers it with a 422. What savePost finds on f is a 422 too:
+// maago.Invalid names the field, maago.InvalidForm the form.
+func APICreatePost(ctx context.Context, tx maago.Tx, in NewPostIn) (Post, error) {
+	if _, err := GetBoard(ctx, tx, in.BoardID); err != nil {
+		return Post{}, err
+	}
+	f := in.Form
+	p, ok, err := savePost(ctx, tx, in.BoardID, &f)
+	switch {
+	case err != nil || ok:
+		return p, err
+	case f.Title.Error != "":
+		return Post{}, maago.Invalid(&f.Title, f.Title.Error)
+	default:
+		return Post{}, maago.InvalidForm(f.Errors[0])
+	}
+}
diff --git a/board/web_test.go b/board/web_test.go
index a0b282f..d077180 100644
--- a/board/web_test.go
+++ b/board/web_test.go
@@ -15,11 +15,14 @@ import (
 	"github.com/maago-web/maago/maagotest"
 )
 
+// front is the origin main trusts, a frontend of its own.
+const front = "http://localhost:5173"
+
 // app serves the board on a new database, as main does.
 func app(t *testing.T) (http.Handler, *sql.DB) {
 	t.Helper()
 	db := maagotest.DB(t)
-	h, err := maago.Handler(maago.Config{DB: db, Apps: []maago.App{App}})
+	h, err := maago.Handler(maago.Config{DB: db, Apps: []maago.App{App}, Origins: []string{front}})
 	if err != nil {
 		t.Fatal(err)
 	}
@@ -273,3 +276,66 @@ func TestCommentAndHide(t *testing.T) {
 		t.Errorf("%v %v", cs, err)
 	}
 }
+
+func TestAPI(t *testing.T) {
+	h, db := app(t)
+	b, err := InsertBoard(t.Context(), db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// call sends a request as a page of origin would, and returns the
+	// response.
+	call := func(method, path, origin, body string, header ...string) *httptest.ResponseRecorder {
+		r := httptest.NewRequest(method, path, strings.NewReader(body))
+		r.Header.Set("Origin", origin)
+		r.Header.Set("Sec-Fetch-Site", "cross-site")
+		if body != "" {
+			r.Header.Set("Content-Type", "application/json")
+		}
+		for i := 0; i < len(header); i += 2 {
+			r.Header.Set(header[i], header[i+1])
+		}
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		return w
+	}
+	const evil = "https://evil.example"
+
+	// The browser asks first whether the frontend may POST JSON.
+	w := call("OPTIONS", APIPostCreateURL(b.ID), front, "", "Access-Control-Request-Method", "POST", "Access-Control-Request-Headers", "content-type")
+	if w.Code != 204 || w.Header().Get("Access-Control-Allow-Origin") != front {
+		t.Errorf("preflight: %d %v", w.Code, w.Header())
+	}
+	if w := call("OPTIONS", APIPostCreateURL(b.ID), evil, "", "Access-Control-Request-Method", "POST"); w.Code != 405 || w.Header().Get("Access-Control-Allow-Origin") != "" {
+		t.Errorf("preflight from another site: %d %v", w.Code, w.Header())
+	}
+
+	for _, c := range []struct {
+		origin, body string
+		code         int
+		has          string
+	}{
+		{front, `{"title": "API 글", "body": "본문"}`, 200, `"Title":"API 글"`},
+		{front, `{"title": "API 글", "body": "본문"}`, 422, `"errors":[{"field":"title","detail":"이 게시판에 같은 제목의 글이 있습니다."}]`},
+		{front, `{"title": "", "body": "본문"}`, 422, `{"field":"title","detail":"This field is required."}`},
+		{front, `{"title": "빈 본문"`, 400, `"status":400`},
+		{front, ``, 400, `"status":400`},
+		{evil, `{"title": "남의 글", "body": "본문"}`, 403, `"status":403`},
+	} {
+		w := call("POST", APIPostCreateURL(b.ID), c.origin, c.body)
+		if w.Code != c.code || !strings.Contains(w.Body.String(), c.has) {
+			t.Errorf("POST %s from %s: %d, want %d with %s:\n%s", c.body, c.origin, w.Code, c.code, c.has, w.Body)
+		}
+		if acao := w.Header().Get("Access-Control-Allow-Origin"); (c.origin == front) != (acao == front) {
+			t.Errorf("POST from %s: Access-Control-Allow-Origin %q", c.origin, acao)
+		}
+	}
+
+	w = call("GET", APIPostsURL(b.ID), front, "")
+	if w.Code != 200 || w.Header().Get("Content-Type") != "application/json" || !strings.Contains(w.Body.String(), `"Title":"API 글"`) || strings.Contains(w.Body.String(), "남의 글") {
+		t.Errorf("list: %d %v %s", w.Code, w.Header(), w.Body)
+	}
+	if w := call("GET", APIPostsURL(b.ID+1), front, ""); w.Code != 404 {
+		t.Errorf("no board: %d %s", w.Code, w.Body)
+	}
+}
