From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maago <maago@example.com>
Date: Tue, 13 Oct 2026 15:24:48 +0900
Subject: [PATCH] Board in the admin

main passes board.Admin too. /app/admin/ gets the board's three models.

How a model looks in the admin, its model tag says:

- admin_list=(Title,BoardID,Status,AuthorID,CreatedAt): the columns of
  the list of posts. Without it, every field (the body too)
- admin_search=(Title,Body): the string fields the search box looks in,
  a LIKE that ignores case
- admin_filter=(Status,BoardID,Hidden): the filters above the list.
  Only fields with choices, bools and foreign keys
- Three for comments too, and a search for boards. A field that is not
  there, or a field in the search that is not a string, maago gen points
  at

Tags are not the schema: maago makemigrations says "no changes".

The first account is the superuser of 0021's -createsuperuser. A
superuser does anything in the admin. For an editor, the superuser does
two things in the admin:

- In auth's User page, turn on the user's is_staff. Without staff, rows
  of permission do not let a user in
- Add an auth Permission: App board, ModelName Post, Action one of view,
  add, change, delete. App and ModelName have no picker: write the
  package name and the Go name as they are. A row spelled wrong allows
  nothing

auth's User and Permission, whatever the rows, are the superuser's
alone beyond viewing. Giving permissions does not pass to editors.

The admin is not the views. Two differences that touch this board:

- Saving keeps the model's rules only (lengths, choices, foreign keys).
  The order of statuses the views keep (Post.Next: draft, published,
  archived) and the author change freely in the admin. A foreign key
  field takes a number
- A post with comments, not even a superuser deletes: the comments
  point at it. The views hide such a post (0023)

The change form carries the post's version (UpdatedAt) as it was when
the form opened, in a hidden field. If somebody saved meanwhile, it is a
409, and the form draws again with what was written. Saving needs the
page opened again: a later save does not undo an earlier one unseen.

The test has the superuser make an editor in the admin, and sees what
the editor may and may not do (rows of a user who is not staff, the
editor's auth rows of permission), the list's columns, a list with the
search and filters at once, a search in the body, a late save from a
form opened first, and the two cases of deleting.

The admin's routes are made when main calls admin.App, so maago gen
does not see them, and no URL function makes their paths. The tests
make the admin once, in adminApp, which config serves, and
TestPermissions gives Permissions both apps: []maago.App{App,
adminApp()}. Its eight routes get rows, with the admin's own URLs:
nobody is sent to sign in (303, 401 for a POST), bob and ann are 403,
staff gets the pages and saves. A table that leaves the admin's App out
does not see its routes: nothing else will say so.

diff --git a/board/admin_test.go b/board/admin_test.go
new file mode 100644
index 0000000..72dbed7
--- /dev/null
+++ b/board/admin_test.go
@@ -0,0 +1,154 @@
+package board
+
+import (
+	"database/sql"
+	"fmt"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/maago-web/maago"
+	"github.com/maago-web/maago/maagotest"
+
+	"example.com/board/auth"
+)
+
+// The admin, as main serves it: who gets in, the editor a superuser makes
+// in it, and the board's tags.
+func TestAdmin(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	if code, _ := get(h, "/admin/"); code != 303 {
+		t.Errorf("without a sign-in: %d", code)
+	}
+	asAnn, ann := signedIn(t, h, db, "ann@example.com")
+	if code, _ := get(asAnn, "/admin/"); code != 403 {
+		t.Errorf("ann, not staff: %d", code)
+	}
+
+	// The superuser of -createsuperuser makes ed an editor: staff, and
+	// allowed to see and change posts.
+	if _, err := auth.CreateSuperuser(ctx, db, "boss@example.com", password); err != nil {
+		t.Fatal(err)
+	}
+	asBoss := maagotest.As(h, login(t, h, "boss@example.com"))
+	asEd, ed := signedIn(t, h, db, "ed@example.com")
+	staff := url.Values{"email": {ed.Email}, "is_active": {"on"}, "is_staff": {"on"}, "verified_at": {"2026-01-01T00:00:00"}}
+	if code, _, body := post(asBoss, fmt.Sprintf("/admin/auth/User/%d/", ed.ID), staff); code != 303 {
+		t.Fatalf("boss makes ed staff: %d\n%s", code, body)
+	}
+	if code, _ := get(asEd, "/admin/"); code != 403 {
+		t.Errorf("ed, staff with no permission: %d", code)
+	}
+	for _, action := range []string{"view", "change"} {
+		grant := url.Values{"user_id": {fmt.Sprint(ed.ID)}, "app": {"board"}, "model_name": {"Post"}, "action": {action}}
+		if code, _, body := post(asBoss, "/admin/auth/Permission/add/", grant); code != 303 {
+			t.Fatalf("boss grants %s: %d\n%s", action, code, body)
+		}
+	}
+	// A row means nothing for who is not staff, and a staff user may not
+	// add a Permission whatever the rows say: that is a superuser's.
+	grant := url.Values{"user_id": {fmt.Sprint(ann.ID)}, "app": {"board"}, "model_name": {"Post"}, "action": {"view"}}
+	if code, _, body := post(asBoss, "/admin/auth/Permission/add/", grant); code != 303 {
+		t.Fatalf("boss grants ann: %d\n%s", code, body)
+	}
+	grant = url.Values{"user_id": {fmt.Sprint(ed.ID)}, "app": {"auth"}, "model_name": {"Permission"}, "action": {"add"}}
+	if code, _, body := post(asBoss, "/admin/auth/Permission/add/", grant); code != 303 {
+		t.Fatalf("boss grants ed auth: %d\n%s", code, body)
+	}
+	if code, _ := get(asAnn, "/admin/"); code != 403 {
+		t.Errorf("ann, not staff, with a row: %d", code)
+	}
+	if code, _ := get(asEd, "/admin/auth/Permission/add/"); code != 403 {
+		t.Errorf("ed adds a Permission: %d", code)
+	}
+	if code, body := get(asEd, "/admin/"); code != 200 || !strings.Contains(body, ">Post<") || strings.Contains(body, ">Comment<") || strings.Contains(body, ">Board<") {
+		t.Errorf("ed's index: %d\n%s", code, body)
+	}
+
+	free, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	notice, err := InsertBoard(ctx, db, NewBoardInput{Name: "공지"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	posts := map[string]Post{}
+	for _, p := range []struct {
+		board               Board
+		title, body, status string
+	}{
+		{free, "봄 소식", "본문", "published"},
+		{notice, "봄 행사", "본문", "published"},    // another board
+		{free, "여름 소식", "여름이 왔다", "published"}, // no 봄
+		{free, "봄 초안", "본문", "draft"},          // another status
+	} {
+		if posts[p.title], err = InsertPost(ctx, db, NewPostInput{BoardID: p.board.ID, Title: p.title, Body: p.body, Status: maago.Set(p.status)}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	code, body := get(asEd, "/admin/board/Post/")
+	if code != 200 || !strings.Contains(body, "<th>제목</th>") || strings.Contains(body, "<th>Body</th>") || strings.Contains(body, "<th>Views</th>") {
+		t.Errorf("the columns of admin_list: %d\n%s", code, body)
+	}
+	_, body = get(asEd, fmt.Sprintf("/admin/board/Post/?q=봄&board_id=%d&status=published", free.ID))
+	if !strings.Contains(body, "봄 소식") || strings.Contains(body, "봄 행사") || strings.Contains(body, "여름 소식") || strings.Contains(body, "봄 초안") {
+		t.Errorf("search and filters: %s", body)
+	}
+	if _, body = get(asEd, "/admin/board/Post/?q=왔다"); !strings.Contains(body, "여름 소식") || strings.Contains(body, "봄 소식") {
+		t.Errorf("a search in the body: %s", body)
+	}
+
+	// The form carries the version of the post it opened, its UpdatedAt,
+	// and saves only at it.
+	p := posts["봄 소식"]
+	edit := func(title, status string, version time.Time) url.Values {
+		return url.Values{"board_id": {fmt.Sprint(p.BoardID)}, "title": {title}, "body": {p.Body}, "status": {status}, "views": {"0"},
+			"_version": {fmt.Sprint(version.UnixMicro())}}
+	}
+	if code, _, body := post(asEd, fmt.Sprintf("/admin/board/Post/%d/", p.ID), edit("봄 소식!", "published", p.UpdatedAt)); code != 303 {
+		t.Errorf("ed changes a post: %d\n%s", code, body)
+	}
+	for _, path := range []string{"/admin/board/Comment/", fmt.Sprintf("/admin/board/Post/delete/?id=%d", p.ID)} {
+		if code, _ := get(asEd, path); code != 403 {
+			t.Errorf("ed GET %s: %d", path, code)
+		}
+	}
+	// boss opened the post before ed saved it: a 409, and ed's title stays.
+	if code, _, body := post(asBoss, fmt.Sprintf("/admin/board/Post/%d/", p.ID), edit("봄 소식?", "draft", p.UpdatedAt)); code != 409 || !strings.Contains(body, "changed since you opened it") {
+		t.Errorf("boss saves an old form: %d\n%s", code, body)
+	}
+	// Opened again, it saves. The admin saves by the model's rules alone:
+	// Next, the views' order of the statuses, is not asked.
+	now, err := GetPost(ctx, db, p.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if code, _, body := post(asBoss, fmt.Sprintf("/admin/board/Post/%d/", p.ID), edit("봄 소식!", "draft", now.UpdatedAt)); code != 303 {
+		t.Errorf("boss makes a published post a draft: %d\n%s", code, body)
+	}
+	if got, err := GetPost(ctx, db, p.ID); err != nil || got.Title != "봄 소식!" || got.Status != "draft" {
+		t.Errorf("after the changes: %+v %v", got, err)
+	}
+
+	// A post with comments is not deleted, not even by a superuser (the
+	// views hide such a post). One without is.
+	if _, err := InsertComment(ctx, db, NewCommentInput{PostID: p.ID, Text: "댓글"}); err != nil {
+		t.Fatal(err)
+	}
+	if code, _, body := post(asBoss, "/admin/board/Post/delete/", url.Values{"id": {fmt.Sprint(p.ID)}}); code != 200 || !strings.Contains(body, "1 row of board.Comment (PostID) refers to it") {
+		t.Errorf("deleting a post with comments: %d\n%s", code, body)
+	}
+	if _, err := GetPost(ctx, db, p.ID); err != nil {
+		t.Errorf("the post with comments: %v", err)
+	}
+	summer := posts["여름 소식"]
+	if code, _, body := post(asBoss, "/admin/board/Post/delete/", url.Values{"id": {fmt.Sprint(summer.ID)}}); code != 303 {
+		t.Errorf("deleting a post without comments: %d\n%s", code, body)
+	}
+	if _, err := GetPost(ctx, db, summer.ID); err != sql.ErrNoRows {
+		t.Errorf("the post without comments: %v", err)
+	}
+}
