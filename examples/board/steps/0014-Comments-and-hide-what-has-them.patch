@@ -1,9 +1,11 @@
 -- name: PinnedOverlap :one Count
--- How many posts of the board are pinned for some of from..until.
+-- How many posts of the board, not hidden, are pinned for some of
+-- from..until.
 -- param: board_id int64
 -- param: from     time.Time
 -- param: until    time.Time
 -- column: n int64
 SELECT count(*) AS n
