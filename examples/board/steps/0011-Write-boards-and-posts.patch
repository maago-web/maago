diff --git a/board/urls.go b/board/urls.go
index 7da271f..23c8d5a 100644
--- a/board/urls.go
+++ b/board/urls.go
@@ -6,7 +6,11 @@ import "github.com/maago-web/maago"
 // for the URL function and {{url}}, and the view.
 var Routes = maago.Routes{
 	maago.GET("/{$}", "home", Home),
+	maago.GET("/boards/new", "board_new", NewBoard),
+	maago.POST("/boards/new", "board_create", NewBoard),
 	maago.GET("/boards/{id}", "board_detail", ShowBoard),
 	maago.GET("/boards/{id}/rows", "board_rows", ShowBoard, maago.Block("rows")),
+	maago.GET("/boards/{id}/posts/new", "post_new", NewPost),
+	maago.POST("/boards/{id}/posts/new", "post_create", NewPost),
 	maago.GET("/posts/{id}", "post_detail", ShowPost),
 }
diff --git a/board/views.go b/board/views.go
index f983549..26904b1 100644
--- a/board/views.go
+++ b/board/views.go
@@ -74,3 +74,72 @@ func ShowPost(ctx context.Context, in PostIn) (PostPage, error) {
 	p, err := PostDetail(ctx, maago.DBFrom(ctx), PostDetailParams{ID: in.ID})
 	return PostPage{p}, err
 }
+
+type NewBoardIn struct {
+	Form BoardForm `maago:"form"`
+}
+
+type BoardFormPage struct {
+	Form BoardForm
+}
+
+// NewBoard draws the form on GET and saves it on POST. A taken name needs
+// the database, so the view checks it, not the form.
+func NewBoard(ctx context.Context, in NewBoardIn) (maago.Result[BoardFormPage], error) {
+	f := in.Form
+	if !f.Valid() {
+		return maago.Show(BoardFormPage{f}), nil
+	}
+	db := maago.DBFrom(ctx)
+	taken, err := BoardNameTaken(ctx, db, BoardNameTakenParams{Name: f.Name.Value})
+	if err != nil {
+		return maago.Result[BoardFormPage]{}, err
+	}
+	if taken.N > 0 {
+		f.Name.Error = "이미 있는 이름입니다."
+		return maago.Show(BoardFormPage{f}), nil
+	}
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: f.Name.Value})
+	if err != nil {
+		return maago.Result[BoardFormPage]{}, err
+	}
+	return maago.SeeOther[BoardFormPage](BoardDetailURL(b.ID)), nil
+}
+
+type NewPostIn struct {
+	BoardID int64    `maago:"path=id"`
+	Form    PostForm `maago:"form"`
+}
+
+type PostFormPage struct {
+	Board Board
+	Form  PostForm
+}
+
+// NewPost writes a post on the board of the path. The same title twice on
+// one board would break the model's unique=(BoardID,Title) as a 500; the
+// view asks first and says so on the field.
+func NewPost(ctx context.Context, in NewPostIn) (maago.Result[PostFormPage], error) {
+	db := maago.DBFrom(ctx)
+	b, err := GetBoard(ctx, db, in.BoardID)
+	if err != nil {
+		return maago.Result[PostFormPage]{}, err // sql.ErrNoRows: a 404
+	}
+	f := in.Form
+	if !f.Valid() {
+		return maago.Show(PostFormPage{b, f}), nil
+	}
+	taken, err := PostTitleTaken(ctx, db, PostTitleTakenParams{BoardID: b.ID, Title: f.Title.Value})
+	if err != nil {
+		return maago.Result[PostFormPage]{}, err
+	}
+	if taken.N > 0 {
+		f.Title.Error = "이 게시판에 같은 제목의 글이 있습니다."
+		return maago.Show(PostFormPage{b, f}), nil
+	}
+	p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: f.Title.Value, Body: f.Body.Value})
+	if err != nil {
+		return maago.Result[PostFormPage]{}, err
+	}
+	return maago.SeeOther[PostFormPage](PostDetailURL(p.ID)), nil
+}
diff --git a/board/web_test.go b/board/web_test.go
index 20e655e..5cc8c1c 100644
--- a/board/web_test.go
+++ b/board/web_test.go
@@ -5,6 +5,7 @@ import (
 	"fmt"
 	"net/http"
 	"net/http/httptest"
+	"net/url"
 	"strings"
 	"testing"
 
@@ -30,6 +31,16 @@ func get(h http.Handler, path string) (int, string) {
 	return w.Code, w.Body.String()
 }
 
+// post sends form to path, as a browser on the same site does, and returns
+// the status, the Location and the body.
+func post(h http.Handler, path string, form url.Values) (int, string, string) {
+	r := httptest.NewRequest("POST", path, strings.NewReader(form.Encode()))
+	r.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w.Code, w.Header().Get("Location"), w.Body.String()
+}
+
 func TestPages(t *testing.T) {
 	h, db := app(t)
 	ctx := t.Context()
@@ -73,3 +84,50 @@ func TestPages(t *testing.T) {
 		t.Errorf("rows: %d %s", code, body)
 	}
 }
+
+func TestWrite(t *testing.T) {
+	h, _ := app(t)
+
+	if code, body := get(h, BoardNewURL()); code != 200 || !strings.Contains(body, `<label for="name">이름</label>`) {
+		t.Fatalf("form: %d %s", code, body)
+	}
+	if code, _, body := post(h, BoardCreateURL(), url.Values{"name": {""}}); code != 200 || !strings.Contains(body, "This field is required.") {
+		t.Errorf("empty name: %d %s", code, body)
+	}
+	code, loc, _ := post(h, BoardCreateURL(), url.Values{"name": {"자유"}})
+	if code != 303 || loc != BoardDetailURL(1) {
+		t.Fatalf("save: %d %q", code, loc)
+	}
+	if code, _, body := post(h, BoardCreateURL(), url.Values{"name": {"자유"}}); code != 200 || !strings.Contains(body, "이미 있는 이름입니다.") || !strings.Contains(body, `value="자유"`) {
+		t.Errorf("taken name: %d %s", code, body)
+	}
+
+	write := url.Values{"title": {"첫 글"}, "body": {"안녕"}}
+	code, loc, _ = post(h, PostCreateURL(1), write)
+	if code != 303 || loc != PostDetailURL(1) {
+		t.Fatalf("post: %d %q", code, loc)
+	}
+	if code, body := get(h, loc); code != 200 || !strings.Contains(body, "첫 글") {
+		t.Errorf("after the post: %d %s", code, body)
+	}
+	if code, _, body := post(h, PostCreateURL(1), write); code != 200 || !strings.Contains(body, "같은 제목의 글이 있습니다") {
+		t.Errorf("taken title: %d %s", code, body)
+	}
+	if code, _, body := post(h, PostCreateURL(1), url.Values{"title": {strings.Repeat("가", 201)}, "body": {"x"}}); code != 200 || !strings.Contains(body, "Enter at most 200 characters.") {
+		t.Errorf("long title: %d %s", code, body)
+	}
+	if code, _, _ := post(h, PostCreateURL(2), write); code != 404 {
+		t.Errorf("no board: %d", code)
+	}
+
+	// Another site cannot post the form (Config.Origins trusts none).
+	r := httptest.NewRequest("POST", BoardCreateURL(), strings.NewReader("name=x"))
+	r.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	r.Header.Set("Origin", "https://evil.example")
+	r.Header.Set("Sec-Fetch-Site", "cross-site")
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	if w.Code != 403 {
+		t.Errorf("cross-site post: %d", w.Code)
+	}
+}
