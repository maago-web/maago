+package board
+
+import "github.com/maago-web/maago"
+
+// Routes are the board's pages. Each line is one route: its path, a name
+// for the URL function and {{url}}, and the view.
+var Routes = maago.Routes{
+	maago.GET("/{$}", "home", Home),
+	maago.GET("/boards/{id}", "board_detail", ShowBoard),
+	maago.GET("/boards/{id}/rows", "board_rows", ShowBoard, maago.Block("rows")),
+	maago.GET("/posts/{id}", "post_detail", ShowPost),
+}
diff --git a/board/views.go b/board/views.go
new file mode 100644
index 0000000..f983549
--- /dev/null
+++ b/board/views.go
@@ -0,0 +1,76 @@
+package board
+
+import (
+	"context"
+
+	"github.com/maago-web/maago"
+)
+
+// pageSize is how many posts a page of a board shows.
+const pageSize = 10
+
+type HomePage struct {
+	Boards []Board
+}
+
+// Home lists the boards.
+func Home(ctx context.Context, in struct{}) (HomePage, error) {
+	bs, err := BoardList(ctx, maago.DBFrom(ctx))
+	return HomePage{bs}, err
+}
+
+type BoardIn struct {
+	ID   int64   `maago:"path=id"`
+	Page *int64  `maago:"query=page"` // nil: the first page
+	Q    *string `maago:"query=q"`    // nil: no search
+}
+
+type BoardPage struct {
+	Board      Board
+	Posts      []PostSummary
+	Page       int64
+	Prev, Next int64 // 0: none
+	Q          string
+}
+
+// ShowBoard shows a board's posts, a page at a time, or those whose title
+// has q.
+func ShowBoard(ctx context.Context, in BoardIn) (BoardPage, error) {
+	db := maago.DBFrom(ctx)
+	b, err := GetBoard(ctx, db, in.ID)
+	if err != nil {
+		return BoardPage{}, err // sql.ErrNoRows: a 404
+	}
+	p := BoardPage{Board: b, Page: 1}
+	if in.Page != nil && *in.Page > 1 {
+		p.Page = *in.Page
+	}
+	if in.Q != nil {
+		p.Q = *in.Q
+		p.Posts, err = SearchPosts(ctx, db, SearchPostsParams{BoardID: b.ID, Q: in.Q, Limit: pageSize})
+		return p, err
+	}
+	// One more than a page tells whether a next page is there.
+	p.Posts, err = PostList(ctx, db, PostListParams{BoardID: b.ID, Limit: pageSize + 1, Offset: (p.Page - 1) * pageSize})
+	if len(p.Posts) > pageSize {
+		p.Posts, p.Next = p.Posts[:pageSize], p.Page+1
+	}
+	if p.Page > 1 {
+		p.Prev = p.Page - 1
+	}
+	return p, err
+}
+
+type PostIn struct {
+	ID int64 `maago:"path=id"`
+}
+
+type PostPage struct {
+	Post PostWithBoard
+}
+
+// ShowPost shows one post.
+func ShowPost(ctx context.Context, in PostIn) (PostPage, error) {
+	p, err := PostDetail(ctx, maago.DBFrom(ctx), PostDetailParams{ID: in.ID})
+	return PostPage{p}, err
+}
diff --git a/board/web_test.go b/board/web_test.go
new file mode 100644
index 0000000..20e655e
--- /dev/null
+++ b/board/web_test.go
@@ -0,0 +1,75 @@
+package board
+
+import (
+	"database/sql"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/maago-web/maago"
+	"github.com/maago-web/maago/maagotest"
+)
+
+// app serves the board on a new database, as main does.
+func app(t *testing.T) (http.Handler, *sql.DB) {
+	t.Helper()
+	db := maagotest.DB(t)
+	h, err := maago.Handler(maago.Config{DB: db, Apps: []maago.App{App}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return h, db
+}
+
+// get requests path and returns the status and the body.
+func get(h http.Handler, path string) (int, string) {
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, httptest.NewRequest("GET", path, nil))
+	return w.Code, w.Body.String()
+}
+
+func TestPages(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var first Post
+	for i := 1; i <= 12; i++ {
+		p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: fmt.Sprintf("글 %d", i), Body: "<b>본문</b>"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i == 1 {
+			first = p
+		}
+	}
+
+	for _, c := range []struct {
+		path string
+		code int
+		has  string
+	}{
+		{HomeURL(), 200, `<a href="/boards/1">자유</a>`},
+		{BoardDetailURL(b.ID), 200, "글 12"},               // the newest first
+		{BoardDetailURL(b.ID) + "?page=2", 200, "글 2"},    // ten a page
+		{BoardDetailURL(b.ID) + "?q=11", 200, "글 11"},     // a search
+		{BoardDetailURL(b.ID) + "?page=abc", 400, "Bad"},  // not a number
+		{BoardDetailURL(b.ID + 1), 404, "Not Found"},      // no board
+		{PostDetailURL(first.ID), 200, "&lt;b&gt;본문"},     // escaped
+		{PostDetailURL(first.ID + 100), 404, "Not Found"}, // sql.ErrNoRows
+		{"/posts/abc", 404, "Not Found"},                  // not an id
+	} {
+		if code, body := get(h, c.path); code != c.code || !strings.Contains(body, c.has) {
+			t.Errorf("GET %s: %d, want %d with %q:\n%s", c.path, code, c.code, c.has, body)
+		}
+	}
+
+	// The rows alone, for a page that swaps them in.
+	if code, body := get(h, BoardRowsURL(b.ID)+"?page=2"); code != 200 || !strings.HasPrefix(body, `<ul id="rows">`) || strings.Contains(body, "<html") {
+		t.Errorf("rows: %d %s", code, body)
+	}
+}
