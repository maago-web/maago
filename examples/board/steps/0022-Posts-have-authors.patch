+// signedIn is h for a browser signed in as a new user with email: every
+// request carries its session.
+func signedIn(t *testing.T, h http.Handler, db *sql.DB, email string) (http.Handler, auth.User) {
+	t.Helper()
+	u := newUser(t, db, email)
+	return as(h, login(t, h, email)), u
+}
+
+// as is h for a browser with the session cookie s.
+func as(h http.Handler, s *http.Cookie) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		r.AddCookie(s)
+		h.ServeHTTP(w, r)
+	})
+}
