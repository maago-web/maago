From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maago <maago@example.com>
Date: Mon, 5 Oct 2026 02:25:55 +0900
Subject: [PATCH] Serve under /app

Put the site under /app, for when the same server (or a proxy in front)
serves something else at /.

- Config.Prefix: "/app" in main. The generated URL functions
  (BoardDetailURL) and {{url}} in the templates start with /app. No view
  and no template changes
- The routes do not know /app: a path must come in as /boards/1. So
  main takes it off with http.StripPrefix("/app", h) before h. When the
  proxy in front takes it off already, use h as it is
- SeeOther goes to BoardDetailURL too, so it sends the browser to
  /app/boards/1

The prefix is one per process: the last maago.Handler made sets it. The
test makes the /app Handler first, and puts the one without a prefix
back when it ends.

With this the board has pages, forms, statuses, comments, an API, an
export and a webhook. Who wrote what it does not know yet: signing in,
and only the author publishing, archiving and deleting, come next.

diff --git a/board/web_test.go b/board/web_test.go
index 4fb6f92..3d7e413 100644
--- a/board/web_test.go
+++ b/board/web_test.go
@@ -386,3 +386,25 @@ func TestExport(t *testing.T) {
 		}
 	}
 }
+
+func TestUnderApp(t *testing.T) {
+	// The prefix is the process's, the last Handler's: make it first.
+	db := maagotest.DB(t)
+	h, err := maago.Handler(maago.Config{DB: db, Apps: []maago.App{App}, Prefix: "/app"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Back to no prefix for the tests after.
+	t.Cleanup(func() { maago.Handler(maago.Config{DB: db, Apps: []maago.App{App}}) })
+	srv := http.StripPrefix("/app", h) // as main serves it
+
+	if code, loc, _ := post(srv, BoardCreateURL(), url.Values{"name": {"자유"}}); code != 303 || loc != "/app/boards/1" {
+		t.Fatalf("save: %d %q", code, loc)
+	}
+	if code, body := get(srv, "/app/boards/1"); code != 200 || !strings.Contains(body, `<a href="/app/">게시판</a>`) || !strings.Contains(body, `href="/app/boards/1/posts/new"`) {
+		t.Errorf("board: %d %s", code, body)
+	}
+	if code, _ := get(srv, "/boards/1"); code != 404 {
+		t.Errorf("without /app: %d", code)
+	}
+}
diff --git a/main.go b/main.go
index 85ffe36..20e1fcb 100644
--- a/main.go
+++ b/main.go
@@ -33,6 +33,9 @@ func main() {
 		// The frontend's dev server, another origin: its pages may call the
 		// API, and read the answers.
 		Origins: []string{"http://localhost:5173"},
+		// The site is under /app, beside what else the server serves. Links
+		// and URL functions start with it.
+		Prefix: "/app",
 		// Every 5xx: a view's error or a panic. Send it where you watch
 		// errors; the log will do here.
 		OnError: func(ctx context.Context, r *http.Request, err error) {
@@ -42,6 +45,8 @@ func main() {
 	if err != nil {
 		log.Fatal(err)
 	}
-	log.Print("listening on :8000")
-	log.Fatal(http.ListenAndServe(":8000", h))
+	// StripPrefix takes /app off the path before the routes see it. A proxy
+	// in front that takes it off already gets h alone.
+	log.Print("listening on http://localhost:8000/app/")
+	log.Fatal(http.ListenAndServe(":8000", http.StripPrefix("/app", h)))
 }
