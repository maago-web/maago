+// Another service gets the files by the URLs the API gives staff: from
+// the app's address, without a sign-in.
+func TestFileURLs(t *testing.T) {
+	db := maagotest.DB(t)
+	srv := httptest.NewServer(nil)
+	defer srv.Close()
+	cfg := config(t, db)
+	cfg.Media = maago.LocalMedia{Dir: t.TempDir(), SiteURL: srv.URL}
+	h, err := maago.Handler(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv.Config.Handler = h
+	ctx := maago.WithMedia(t.Context(), cfg.Media)
+	b, _ := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err := WriteExportFiles(ctx, db, outbox.Job{Kind: ExportFiles, Payload: fmt.Sprintf(`{"id":%d}`, b.ID)}); err != nil {
+		t.Fatal(err)
+	}
+	boss, err := auth.CreateSuperuser(ctx, db, "boss@example.com", password)
+	if err != nil {
+		t.Fatal(err)
+	}
+	token, err := auth.SignInToken(ctx, db, boss)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, _ := http.NewRequest("GET", srv.URL+APIBoardFilesURL(b.ID), nil)
+	r.Header.Set("Authorization", "Bearer "+token)
+	resp, err := http.DefaultClient.Do(r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var links []FileLink
+	err = json.NewDecoder(resp.Body).Decode(&links)
+	resp.Body.Close()
+	if err != nil || resp.StatusCode != 200 || len(links) != 1 || links[0].Name != "index.md" || !strings.HasPrefix(links[0].URL, srv.URL+"/") {
+		t.Fatalf("the list: %d %+v %v", resp.StatusCode, links, err)
+	}
+	resp, err = http.Get(links[0].URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, _ := io.ReadAll(resp.Body)
+	resp.Body.Close()
+	if resp.StatusCode != 200 || string(body) != "# 자유\n\n" || !strings.HasPrefix(resp.Header.Get("Content-Disposition"), "attachment") {
+		t.Errorf("%s: %d %v %q", links[0].URL, resp.StatusCode, resp.Header, body)
+	}
+}
