+// FileLink is a file of a board's export, with a URL that serves it.
+type FileLink struct {
+	Name, Type string
+	Size       int64
+	URL        string
+}
+
+// APIFiles lists a board's files for another service, to staff, each
+// with a signed URL: for an hour, it serves the file to whoever has it,
+// without the app's check, and on S3 straight from the bucket. So the
+// check is here, before any URL is made.
+func APIFiles(ctx context.Context, u auth.User, db maago.DB, in FilesIn) ([]FileLink, error) {
+	if err := staffOnly(u); err != nil {
+		return nil, err
+	}
+	if _, err := GetBoard(ctx, db, in.ID); err != nil {
+		return nil, err
+	}
+	fs, err := BoardFiles(ctx, db, BoardFilesParams{BoardID: in.ID})
+	if err != nil {
+		return nil, err
+	}
+	links := []FileLink{}
+	for _, f := range fs {
+		url, err := maago.MediaURL(ctx, f.media(), time.Hour)
+		if err != nil {
+			return nil, err
+		}
+		links = append(links, FileLink{Name: f.Name, Type: f.Type, Size: f.Size, URL: url})
+	}
+	return links, nil
+}
+
 // staffOnly refuses with 403 whoever is not staff.
