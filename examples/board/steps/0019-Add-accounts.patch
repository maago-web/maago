From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maago <maago@example.com>
Date: Mon, 12 Oct 2026 23:36:24 +0900
Subject: [PATCH] Add accounts
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

계정을 들인다. 로그인, 가입과 이메일 인증, 비밀번호 변경과 재설정,
탈퇴, API 토큰. 손으로 짜지 않고 maago가 가진 앱을 복사한다:

    maago add auth
    maago makemigrations --name accounts

maago add는 프로젝트의 auth/에 앱 하나를 쓴다. 모델 여섯(User, Permission,
Session, Token, Attempt, APIToken), 쿼리, 라우트, 뷰, 폼, 메일, 템플릿, 그리고
시험까지. 쓴 파일은 이제 이 프로젝트의 것이다. User에 필드를 더하고,
영어 문구와 템플릿을 사이트에 맞게 고쳐 쓴다. 보안의 모양을 가진 부분
(비밀번호 해싱, 토큰, 쿠키 속성, 시도 횟수의 IP)은 라이브러리
contrib/auth에 있어서 maago를 올리면 고친 것이 따라온다.

auth/driver_test.go만은 프로젝트의 DB를 보고 고른다. 여기는 SQLite라
modernc.org/sqlite를 import한다. PostgreSQL 프로젝트라면 pgx를 쓴다.

makemigrations가 여섯 표를 0006에 쓴다. 그러나 maago gen은 아직 막는다:

    auth/urls.go:5:5: app auth has routes, but no package uses auth.App
      fix: add auth.App to maago.Config.Apps in main (D-114), then run maago gen: go build works after gen

라우트가 있는 앱은 main이 써야 한다. 다음 커밋이 잇는다.

이 커밋의 패치에는 auth/가 없다. 생성물(*_gen.go)처럼 명령이 만드는
것은 패치에 담지 않고, 아래 줄이 그 명령을 이 단계 앞에서 돌린다.

Maago-Run: maago add auth
Maago-Expect: auth/urls.go:5:5: app auth has routes, but no package uses auth.App

diff --git a/migrations/0006_accounts.sql b/migrations/0006_accounts.sql
new file mode 100644
index 0000000..7f2bee2
--- /dev/null
+++ b/migrations/0006_accounts.sql
@@ -0,0 +1,75 @@
+CREATE TABLE "auth_api_token" (
+    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
+    "user_id" INTEGER NOT NULL,
+    "name" TEXT NOT NULL CHECK (length("name") <= 100),
+    "hash" TEXT NOT NULL CHECK (length("hash") <= 64),
+    "created_at" TEXT NOT NULL,
+    CONSTRAINT "auth_api_token_user_id_fkey" FOREIGN KEY ("user_id") REFERENCES "auth_user" ("id") ON DELETE NO ACTION
+) STRICT;
+
+CREATE UNIQUE INDEX "auth_api_token_hash_key" ON "auth_api_token" ("hash");
+
+CREATE INDEX "auth_api_token_user_id_idx" ON "auth_api_token" ("user_id");
+
+CREATE TABLE "auth_attempt" (
+    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
+    "action" TEXT NOT NULL CHECK ("action" IN ('login', 'mail')),
+    "email" TEXT NOT NULL CHECK (length("email") <= 254),
+    "ip" TEXT NOT NULL,
+    "created_at" TEXT NOT NULL
+) STRICT;
+
+CREATE INDEX "auth_attempt_action_created_at_idx" ON "auth_attempt" ("action", "created_at");
+
+CREATE TABLE "auth_permission" (
+    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
+    "user_id" INTEGER NOT NULL,
+    "app" TEXT NOT NULL CHECK (length("app") <= 100),
+    "model_name" TEXT NOT NULL CHECK (length("model_name") <= 100),
+    "action" TEXT NOT NULL CHECK ("action" IN ('view', 'add', 'change', 'delete')),
+    CONSTRAINT "auth_permission_user_id_fkey" FOREIGN KEY ("user_id") REFERENCES "auth_user" ("id") ON DELETE NO ACTION
+) STRICT;
+
+CREATE UNIQUE INDEX "auth_permission_user_id_app_model_name_action_key" ON "auth_permission" ("user_id", "app", "model_name", "action");
+
+CREATE INDEX "auth_permission_user_id_idx" ON "auth_permission" ("user_id");
+
+CREATE TABLE "auth_session" (
+    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
+    "user_id" INTEGER NOT NULL,
+    "hash" TEXT NOT NULL CHECK (length("hash") <= 64),
+    "expires_at" TEXT NOT NULL,
+    "created_at" TEXT NOT NULL,
+    CONSTRAINT "auth_session_user_id_fkey" FOREIGN KEY ("user_id") REFERENCES "auth_user" ("id") ON DELETE NO ACTION
+) STRICT;
+
+CREATE UNIQUE INDEX "auth_session_hash_key" ON "auth_session" ("hash");
+
+CREATE INDEX "auth_session_user_id_idx" ON "auth_session" ("user_id");
+
+CREATE TABLE "auth_token" (
+    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
+    "user_id" INTEGER NOT NULL,
+    "purpose" TEXT NOT NULL CHECK ("purpose" IN ('verify', 'reset')),
+    "hash" TEXT NOT NULL CHECK (length("hash") <= 64),
+    "expires_at" TEXT NOT NULL,
+    "created_at" TEXT NOT NULL,
+    CONSTRAINT "auth_token_user_id_fkey" FOREIGN KEY ("user_id") REFERENCES "auth_user" ("id") ON DELETE NO ACTION
+) STRICT;
+
+CREATE UNIQUE INDEX "auth_token_hash_key" ON "auth_token" ("hash");
+
+CREATE INDEX "auth_token_user_id_idx" ON "auth_token" ("user_id");
+
+CREATE TABLE "auth_user" (
+    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
+    "email" TEXT NOT NULL CHECK (length("email") <= 254),
+    "password_hash" TEXT NOT NULL,
+    "is_active" INTEGER NOT NULL DEFAULT 1 CHECK ("is_active" IN (0, 1)),
+    "is_staff" INTEGER NOT NULL DEFAULT 0 CHECK ("is_staff" IN (0, 1)),
+    "is_superuser" INTEGER NOT NULL DEFAULT 0 CHECK ("is_superuser" IN (0, 1)),
+    "verified_at" TEXT,
+    "created_at" TEXT NOT NULL
+) STRICT;
+
+CREATE UNIQUE INDEX "auth_user_email_key" ON "auth_user" ("email");
