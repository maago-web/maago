From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maago <maago@example.com>
Date: Mon, 12 Oct 2026 23:36:24 +0900
Subject: [PATCH] Add accounts

Bring in accounts: sign-in, sign-up with email verification, password
change and reset, closing an account, API tokens. Not written by hand:
copy the app maago has:

    maago add auth
    maago makemigrations --name accounts

maago add writes one app to the project's auth/: six models (User,
Permission, Session, Token, Attempt, APIToken), queries, routes, views,
forms, mails, templates, and tests too. What it writes is now the
project's own: add fields to User, change the English texts and the
templates to suit the site. What carries the shape of security
(password hashing, tokens, cookie attributes, the IP of attempts) lives
in the library contrib/auth, so upgrading maago brings its fixes.

auth/driver_test.go alone picks by the project's database: this one is
PostgreSQL, so it imports pgx. A SQLite project gets modernc.org/sqlite.

makemigrations writes the six tables to 0003. But maago gen still
refuses:

    auth/urls.go:5:5: app auth has routes, but no package uses auth.App
      fix: add auth.App to maago.Config.Apps in main (D-114), then run maago gen: go build works after gen

main must use an app that has routes. The next commit does.

The patch of this commit has no auth/. What a command makes, like the
generated *_gen.go, stays out of the patches, and the line below runs
that command before this step.

Maago-Run: maago add auth
Maago-Expect: auth/urls.go:5:5: app auth has routes, but no package uses auth.App

diff --git a/migrations/0003_accounts.sql b/migrations/0003_accounts.sql
new file mode 100644
index 0000000..5d090da
--- /dev/null
+++ b/migrations/0003_accounts.sql
@@ -0,0 +1,74 @@
+CREATE TABLE "auth_api_token" (
+    "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    "user_id" BIGINT NOT NULL,
+    "name" VARCHAR(100) NOT NULL,
+    "hash" VARCHAR(64) NOT NULL,
+    "created_at" TIMESTAMPTZ NOT NULL,
+    CONSTRAINT "auth_api_token_hash_key" UNIQUE ("hash")
+);
+
+CREATE INDEX "auth_api_token_user_id_idx" ON "auth_api_token" ("user_id");
+
+CREATE TABLE "auth_attempt" (
+    "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    "action" TEXT NOT NULL CHECK ("action" IN ('login', 'mail')),
+    "email" VARCHAR(254) NOT NULL,
+    "ip" TEXT NOT NULL,
+    "created_at" TIMESTAMPTZ NOT NULL
+);
+
+CREATE INDEX "auth_attempt_action_created_at_idx" ON "auth_attempt" ("action", "created_at");
+
+CREATE TABLE "auth_permission" (
+    "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    "user_id" BIGINT NOT NULL,
+    "app" VARCHAR(100) NOT NULL,
+    "model_name" VARCHAR(100) NOT NULL,
+    "action" TEXT NOT NULL CHECK ("action" IN ('view', 'add', 'change', 'delete')),
+    CONSTRAINT "auth_permission_user_id_app_model_name_action_key" UNIQUE ("user_id", "app", "model_name", "action")
+);
+
+CREATE INDEX "auth_permission_user_id_idx" ON "auth_permission" ("user_id");
+
+CREATE TABLE "auth_session" (
+    "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    "user_id" BIGINT NOT NULL,
+    "hash" VARCHAR(64) NOT NULL,
+    "expires_at" TIMESTAMPTZ NOT NULL,
+    "created_at" TIMESTAMPTZ NOT NULL,
+    CONSTRAINT "auth_session_hash_key" UNIQUE ("hash")
+);
+
+CREATE INDEX "auth_session_user_id_idx" ON "auth_session" ("user_id");
+
+CREATE TABLE "auth_token" (
+    "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    "user_id" BIGINT NOT NULL,
+    "purpose" TEXT NOT NULL CHECK ("purpose" IN ('verify', 'reset')),
+    "hash" VARCHAR(64) NOT NULL,
+    "expires_at" TIMESTAMPTZ NOT NULL,
+    "created_at" TIMESTAMPTZ NOT NULL,
+    CONSTRAINT "auth_token_hash_key" UNIQUE ("hash")
+);
+
+CREATE INDEX "auth_token_user_id_idx" ON "auth_token" ("user_id");
+
+CREATE TABLE "auth_user" (
+    "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    "email" VARCHAR(254) NOT NULL,
+    "password_hash" TEXT NOT NULL,
+    "is_active" BOOLEAN NOT NULL DEFAULT true,
+    "is_staff" BOOLEAN NOT NULL DEFAULT false,
+    "is_superuser" BOOLEAN NOT NULL DEFAULT false,
+    "verified_at" TIMESTAMPTZ,
+    "created_at" TIMESTAMPTZ NOT NULL,
+    CONSTRAINT "auth_user_email_key" UNIQUE ("email")
+);
+
+ALTER TABLE "auth_api_token" ADD CONSTRAINT "auth_api_token_user_id_fkey" FOREIGN KEY ("user_id") REFERENCES "auth_user" ("id") ON DELETE NO ACTION;
+
+ALTER TABLE "auth_permission" ADD CONSTRAINT "auth_permission_user_id_fkey" FOREIGN KEY ("user_id") REFERENCES "auth_user" ("id") ON DELETE NO ACTION;
+
+ALTER TABLE "auth_session" ADD CONSTRAINT "auth_session_user_id_fkey" FOREIGN KEY ("user_id") REFERENCES "auth_user" ("id") ON DELETE NO ACTION;
+
+ALTER TABLE "auth_token" ADD CONSTRAINT "auth_token_user_id_fkey" FOREIGN KEY ("user_id") REFERENCES "auth_user" ("id") ON DELETE NO ACTION;
