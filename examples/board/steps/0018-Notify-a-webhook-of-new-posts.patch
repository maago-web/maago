From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maago <maago@example.com>
Date: Mon, 5 Oct 2026 02:25:55 +0900
Subject: [PATCH] Notify a webhook of new posts

Tell another service (a chat bot, say) of each new post. A webhook: POST
JSON to an address set in advance.

- The address and the token are the app's settings. They live in the
  app's package variable board.Webhook, and main fills them from the
  environment (BOARD_WEBHOOK_URL, BOARD_WEBHOOK_TOKEN). The token is not
  in the code. It goes as an Authorization: Bearer header
- The webhook hears of a post only once it is saved for good. savePost
  registers the call after the insert:

      maago.AfterCommit(ctx, func(ctx context.Context) {
          if err := notify(ctx, Webhook, p); err != nil {
              log.Printf("notify of post %d: %v", p.ID, err)
          }
      })

  f runs after the request's transaction commits, before the response.
  A rollback drops it, so a post that was never saved is never
  announced. By then the transaction and its connection are let go. f
  returns no error: the commit is done, so a failure can only be logged.
  Its ctx is not cancelled when the request ends, and maago.Serve waits
  for it when the server stops. The response waits for it too, so keep
  it short: what takes long belongs in an outbox (below)
- notify tries again after 1s and 2s, three tries in all, but only after
  a 5xx or no answer. A 4xx would be the same again (a wrong token, an
  address that is not there). Its tries and waits share one deadline,
  notifyWithin (10s): a webhook that is down slows the request by no
  more than that, and one that never answers uses it all on the first
  try

The test calls notify directly, with httptest.NewServer as the fake
webhook. 503 twice, then 200: three tries and success. 400: one try.
The package variable retryWait shrinks the waits to 1ms, and
notifyWithin the deadline, for a server that never answers.

A notice that must arrive even when the webhook is down for long, or
the process stops, needs a row in the database and a worker that sends
it (an outbox). That is beyond this tutorial.

diff --git a/board/notify.go b/board/notify.go
new file mode 100644
index 0000000..79c39ec
--- /dev/null
+++ b/board/notify.go
@@ -0,0 +1,70 @@
+package board
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"time"
+)
+
+// Hook is a webhook: where to post, and the token it wants.
+type Hook struct{ URL, Token string }
+
+// Webhook is where new posts are announced; main fills it in from the
+// environment. With no URL, nothing is announced.
+var Webhook Hook
+
+// retryWait is how long notify waits before each try after the first.
+var retryWait = []time.Duration{time.Second, 2 * time.Second}
+
+// notifyWithin bounds notify, its tries and waits together. It runs after
+// the commit but before the response (maago.AfterCommit), so a webhook
+// that is down slows the request by no more than this.
+var notifyWithin = 10 * time.Second
+
+// notify tells hook of post p. It tries again after a 5xx or no
+// answer, and gives up after a 4xx, which another try would not change,
+// or once notifyWithin is up.
+func notify(ctx context.Context, hook Hook, p Post) error {
+	if hook.URL == "" {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(ctx, notifyWithin)
+	defer cancel()
+	body, err := json.Marshal(map[string]any{"id": p.ID, "title": p.Title, "path": PostDetailURL(p.ID)})
+	if err != nil {
+		return err
+	}
+	for i := 0; ; i++ {
+		again, err := send(ctx, hook, body)
+		if err == nil || !again || i == len(retryWait) {
+			return err
+		}
+		select {
+		case <-time.After(retryWait[i]):
+		case <-ctx.Done():
+			return err
+		}
+	}
+}
+
+// send posts body to hook once, and reports whether to try again.
+func send(ctx context.Context, hook Hook, body []byte) (again bool, err error) {
+	r, err := http.NewRequestWithContext(ctx, "POST", hook.URL, bytes.NewReader(body))
+	if err != nil {
+		return false, err
+	}
+	r.Header.Set("Content-Type", "application/json")
+	r.Header.Set("Authorization", "Bearer "+hook.Token)
+	resp, err := http.DefaultClient.Do(r)
+	if err != nil {
+		return true, err // no answer
+	}
+	resp.Body.Close()
+	if resp.StatusCode >= 300 {
+		return resp.StatusCode >= 500, fmt.Errorf("webhook: %s", resp.Status)
+	}
+	return false, nil
+}
diff --git a/board/notify_test.go b/board/notify_test.go
new file mode 100644
index 0000000..b3c8ef1
--- /dev/null
+++ b/board/notify_test.go
@@ -0,0 +1,72 @@
+package board
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+func TestNotify(t *testing.T) {
+	defer func(w []time.Duration) { retryWait = w }(retryWait)
+	retryWait = []time.Duration{time.Millisecond, time.Millisecond}
+	post := Post{ID: 7, Title: "새 글"}
+
+	for _, c := range []struct {
+		name    string
+		answers []int // the fake webhook's, in turn; the last again after
+		calls   int
+		fails   bool
+	}{
+		{"503 twice, then 200", []int{503, 503, 200}, 3, false},
+		{"503 always", []int{503}, 3, true},
+		{"400: not again", []int{400}, 1, true},
+	} {
+		var calls int
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			var got struct {
+				ID    int64
+				Title string
+				Path  string
+			}
+			if err := json.NewDecoder(r.Body).Decode(&got); err != nil || got.ID != 7 || got.Title != "새 글" || got.Path != "/posts/7" || r.Header.Get("Authorization") != "Bearer s3cret" {
+				t.Errorf("%s: %+v %v %q", c.name, got, err, r.Header.Get("Authorization"))
+			}
+			w.WriteHeader(c.answers[min(calls, len(c.answers)-1)])
+			calls++
+		}))
+		err := notify(t.Context(), Hook{srv.URL, "s3cret"}, post)
+		srv.Close()
+		if calls != c.calls || (err != nil) != c.fails {
+			t.Errorf("%s: %d calls, %v", c.name, calls, err)
+		}
+	}
+
+	// No answer at all: tried again, then given up.
+	srv := httptest.NewServer(nil)
+	srv.Close()
+	if err := notify(t.Context(), Hook{srv.URL, "s3cret"}, post); err == nil {
+		t.Error("no server: no error")
+	}
+	if err := notify(t.Context(), Hook{}, post); err != nil {
+		t.Errorf("no webhook: %v", err)
+	}
+
+	// A webhook that never answers: notify gives up at notifyWithin, the
+	// first try having used it all.
+	defer func(d time.Duration) { notifyWithin = d }(notifyWithin)
+	notifyWithin = 50 * time.Millisecond
+	block, calls := make(chan struct{}), 0
+	srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		<-block
+	}))
+	start := time.Now()
+	err := notify(t.Context(), Hook{srv.URL, "s3cret"}, post)
+	close(block)
+	srv.Close()
+	if err == nil || calls != 1 || time.Since(start) > time.Second {
+		t.Errorf("no answer: %v, %d calls, %v", err, calls, time.Since(start))
+	}
+}
