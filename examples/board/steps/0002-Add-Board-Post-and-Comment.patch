From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maago <maago@example.com>
Date: Mon, 28 Sep 2026 22:14:38 +0900
Subject: [PATCH] Add Board, Post and Comment

Three models: a board (Board), the posts of a board (Post), and the
comments of a post (Comment).

- A model points at another model of the same app with fk=Model
  (Post.BoardID, Comment.PostID)
- A title only once on a board: unique=(BoardID,Title) in the model tag
- A post's status has choices, and defaults to 'draft'. A field with a
  default is a maago.Opt[string] in the generated input type
  NewPostInput: leave it out and the default goes in
- CreatedAt and UpdatedAt have the auto tag: the generated Insert and
  Update fill them

maago makemigrations writes migrations/0001_initial.sql, and maago
migrate applies it. maago gen writes Get, Insert, Update and Delete for
each model to board/models_gen.go. The tests call those functions
directly. maagotest.DB(t) gives each test a new database: it reads the
dialect from the .env at the root, applies the migrations, and drops
the database when the test ends. So the tests never see each other's
rows, and never touch board.db, which maago migrate uses. A test does
not go through main, so it imports the driver itself.

    go test ./...

diff --git a/board/board_test.go b/board/board_test.go
new file mode 100644
index 0000000..5897aa6
--- /dev/null
+++ b/board/board_test.go
@@ -0,0 +1,70 @@
+package board
+
+import (
+	"database/sql"
+	"errors"
+	"testing"
+
+	"github.com/maago-web/maago/maagotest"
+
+	// A test does not go through main, so it imports the driver itself.
+	_ "modernc.org/sqlite"
+)
+
+func TestPostCRUD(t *testing.T) {
+	db := maagotest.DB(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "공지"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "첫 글", Body: "안녕하세요"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if p.Status != "draft" {
+		t.Errorf("status %q, want the default draft", p.Status)
+	}
+
+	got, err := GetPost(ctx, db, p.ID)
+	if err != nil || got.Title != "첫 글" || !got.CreatedAt.Equal(p.CreatedAt) {
+		t.Fatalf("got %+v, %v", got, err)
+	}
+	got.Status = "published"
+	if err := UpdatePost(ctx, db, &got); err != nil {
+		t.Fatal(err)
+	}
+	if again, _ := GetPost(ctx, db, p.ID); again.Status != "published" {
+		t.Errorf("status %q after the update", again.Status)
+	}
+
+	if err := DeletePost(ctx, db, p.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := GetPost(ctx, db, p.ID); !errors.Is(err, sql.ErrNoRows) {
+		t.Errorf("after delete: %v", err)
+	}
+	if err := DeletePost(ctx, db, p.ID); !errors.Is(err, sql.ErrNoRows) {
+		t.Errorf("deleting it again: %v", err)
+	}
+}
+
+// The database keeps what the tags say: a title once per board, and a
+// post only on a board that exists.
+func TestPostConstraints(t *testing.T) {
+	db := maagotest.DB(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "같은 제목"}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "같은 제목"}); err == nil {
+		t.Error("the same title twice on one board")
+	}
+	if _, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID + 1000, Title: "없는 게시판"}); err == nil {
+		t.Error("a post on a board that does not exist")
+	}
+}
diff --git a/board/models.go b/board/models.go
new file mode 100644
index 0000000..0b9dfcb
--- /dev/null
+++ b/board/models.go
@@ -0,0 +1,37 @@
+// Package board is the app of the tutorial: boards, their posts, and the
+// comments on a post.
+package board
+
+import (
+	"time"
+
+	"github.com/maago-web/maago"
+)
+
+type Board struct {
+	maago.Model
+
+	ID   int64
+	Name string `maago:"max=100,unique,label='이름'"`
+}
+
+type Post struct {
+	maago.Model `maago:"unique=(BoardID,Title)"`
+
+	ID        int64
+	BoardID   int64  `maago:"fk=Board"`
+	Title     string `maago:"max=200,label='제목'"`
+	Body      string
+	Status    string    `maago:"choices=draft/published/archived,default='draft'"`
+	CreatedAt time.Time `maago:"auto=create"`
+	UpdatedAt time.Time `maago:"auto=update"`
+}
+
+type Comment struct {
+	maago.Model
+
+	ID        int64
+	PostID    int64 `maago:"fk=Post"`
+	Body      string
+	CreatedAt time.Time `maago:"auto=create"`
+}
diff --git a/migrations/0001_initial.sql b/migrations/0001_initial.sql
new file mode 100644
index 0000000..703190e
--- /dev/null
+++ b/migrations/0001_initial.sql
@@ -0,0 +1,31 @@
+CREATE TABLE "board_board" (
+    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
+    "name" TEXT NOT NULL CHECK (length("name") <= 100)
+) STRICT;
+
+CREATE UNIQUE INDEX "board_board_name_key" ON "board_board" ("name");
+
+CREATE TABLE "board_comment" (
+    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
+    "post_id" INTEGER NOT NULL,
+    "body" TEXT NOT NULL,
+    "created_at" TEXT NOT NULL,
+    CONSTRAINT "board_comment_post_id_fkey" FOREIGN KEY ("post_id") REFERENCES "board_post" ("id") ON DELETE NO ACTION
+) STRICT;
+
+CREATE INDEX "board_comment_post_id_idx" ON "board_comment" ("post_id");
+
+CREATE TABLE "board_post" (
+    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
+    "board_id" INTEGER NOT NULL,
+    "title" TEXT NOT NULL CHECK (length("title") <= 200),
+    "body" TEXT NOT NULL,
+    "status" TEXT NOT NULL DEFAULT 'draft' CHECK ("status" IN ('draft', 'published', 'archived')),
+    "created_at" TEXT NOT NULL,
+    "updated_at" TEXT NOT NULL,
+    CONSTRAINT "board_post_board_id_fkey" FOREIGN KEY ("board_id") REFERENCES "board_board" ("id") ON DELETE NO ACTION
+) STRICT;
+
+CREATE UNIQUE INDEX "board_post_board_id_title_key" ON "board_post" ("board_id", "title");
+
+CREATE INDEX "board_post_board_id_idx" ON "board_post" ("board_id");
