 	}()
+	// The sweep, as the server starts and each day after: it deletes the
+	// files no row keeps, a day old, such as an upload whose row was never
+	// committed. The store is this database's alone: never point a copy
+	// of the site at another's media.
+	go func() {
+		for {
+			if err := maago.SweepMedia(maago.WithMedia(work, media), db, 0); err != nil {
+				log.Printf("sweep: %v", err)
+			}
+			select {
+			case <-work.Done():
+				return
+			case <-time.After(24 * time.Hour):
+			}
+		}
+	}()
 	// Serve stops on SIGTERM, as a platform stops a container: it takes no
 	// new connections and lets the running requests finish, for up to 30s.
 	// Then the worker takes no more jobs, and finishes the one in hand.
