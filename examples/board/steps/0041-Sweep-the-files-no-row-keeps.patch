+
+// The sweep deletes a day-old file no row keeps, and keeps an
+// attachment's however old.
+func TestSweep(t *testing.T) {
+	db := maagotest.DB(t)
+	cfg := config(t, db)
+	dir := cfg.Media.(maago.LocalMedia).Dir
+	h, err := maago.Handler(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := maago.WithMedia(t.Context(), cfg.Media)
+	ann, annUser := signedIn(t, h, db, "ann@example.com")
+	b, _ := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	p, _ := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "첨부", Status: maago.Set("published"), AuthorID: &annUser.ID})
+	if w := upload(ann, p.ID, "a.txt", []byte("결과표")); w.Code != 303 {
+		t.Fatalf("upload: %d %s", w.Code, w.Body)
+	}
+	orphan, err := maago.SaveMediaFrom(ctx, "lost.txt", strings.NewReader("no row"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := time.Now().Add(-48 * time.Hour)
+	entries, _ := os.ReadDir(dir)
+	for _, e := range entries {
+		if err := os.Chtimes(filepath.Join(dir, e.Name()), old, old); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := maago.SweepMedia(ctx, db, 0); err != nil {
+		t.Fatal(err)
+	}
+	as, _ := PostAttachments(ctx, db, PostAttachmentsParams{PostID: p.ID})
+	if code, _ := get(h, AttachmentURL(as[0].ID)); code != 200 {
+		t.Errorf("the attachment after the sweep: %d", code)
+	}
+	if _, err := os.Stat(filepath.Join(dir, orphan.Key)); !os.IsNotExist(err) {
+		t.Errorf("the orphan after the sweep: %v", err)
+	}
+}
