@@ -165,3 +166,30 @@ func CreatePost(ctx context.Context, tx maago.Tx, in NewPostIn) (maago.Result[Po
 	}
 	return maago.SeeOther[PostFormPage](PostDetailURL(p.ID)), nil
 }
+
+// Publish publishes a draft.
+func Publish(ctx context.Context, tx maago.Tx, in PostIn) (maago.Result[PostPage], error) {
+	return move(ctx, tx, in.ID, "published")
+}
+
+// Archive archives a published post.
+func Archive(ctx context.Context, tx maago.Tx, in PostIn) (maago.Result[PostPage], error) {
+	return move(ctx, tx, in.ID, "archived")
+}
+
+// move gives post id status to, if Post.Next allows it, and goes back to
+// the post. What it does not allow is a 409 Conflict.
+func move(ctx context.Context, tx maago.Tx, id int64, to string) (maago.Result[PostPage], error) {
+	p, err := GetPost(ctx, tx, id)
+	if err != nil {
+		return maago.Result[PostPage]{}, err
+	}
+	if err := p.Next(to); err != nil {
+		return maago.Result[PostPage]{}, maago.Status(http.StatusConflict, err)
+	}
+	p.Status = to
+	if err := UpdatePost(ctx, tx, &p); err != nil {
+		return maago.Result[PostPage]{}, err
+	}
+	return maago.SeeOther[PostPage](PostDetailURL(id)), nil
+}
diff --git a/board/web_test.go b/board/web_test.go
index f5bfaf6..01bea0a 100644
--- a/board/web_test.go
+++ b/board/web_test.go
@@ -2,6 +2,7 @@ package board
 
 import (
 	"database/sql"
+	"errors"
 	"fmt"
 	"net/http"
 	"net/http/httptest"
@@ -190,3 +191,45 @@ func TestPinAndSchedule(t *testing.T) {
 		t.Errorf("search:\n%s", body)
 	}
 }
+
+func TestPublishAndArchive(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "글", Body: "본문"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range []struct {
+		path string
+		code int
+	}{
+		{PostArchiveURL(p.ID), 409}, // a draft is not archived
+		{PostPublishURL(p.ID), 303},
+		{PostPublishURL(p.ID), 409}, // not twice
+		{PostArchiveURL(p.ID), 303},
+		{PostPublishURL(p.ID), 409}, // archived is the end
+		{PostPublishURL(p.ID + 1), 404},
+	} {
+		if code, _, body := post(h, c.path, nil); code != c.code {
+			t.Errorf("POST %s: %d, want %d:\n%s", c.path, code, c.code, body)
+		}
+	}
+	got, err := GetPost(ctx, db, p.ID)
+	if err != nil || got.Status != "archived" {
+		t.Fatalf("%q %v", got.Status, err)
+	}
+
+	// A copy read before another write does not write over it: UpdatePost
+	// compares the version it read, UpdatedAt.
+	stale := got
+	if err := UpdatePost(ctx, db, &got); err != nil {
+		t.Fatal(err)
+	}
+	if err := UpdatePost(ctx, db, &stale); !errors.Is(err, maago.ErrConflict) {
+		t.Errorf("a stale copy: %v", err)
+	}
+}
