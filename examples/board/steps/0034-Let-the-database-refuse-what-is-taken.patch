 	changed.Title, changed.Body = f.Title.Value, f.Body.Value
 	changed.UpdatedAt = time.UnixMicro(in.Version) // UpdatePost writes only over this version
@@ -547,6 +529,8 @@ func ChangePost(ctx context.Context, u auth.User, tx maago.Tx, in ChangePostIn)
 	case errors.Is(err, maago.ErrConflict):
 		f.AddError("그새 다른 사람이 이 글을 고쳤습니다. 다시 열어 고치세요.")
 		return maago.Show(PostEditPage{p, f, in.Version}), nil
+	case f.Fail(err): // the title is taken on this board
