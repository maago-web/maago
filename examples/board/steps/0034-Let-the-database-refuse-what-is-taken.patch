+// Two requests at once with one name: the database lets the first have
+// it, and the other gets its form back with the message, not a 500. A
+// writes the name and holds its transaction open; B, the request, writes
+// the same name, which the unique index makes wait for A. A commits
+// without waiting for B: B is refused whether it got to its write before
+// or after, and its transaction goes on to show the page.
+func TestWriteRace(t *testing.T) {
+	h, db := app(t)
+	h, _ = signedIn(t, h, db, "ann@example.com")
+	var code int
+	var body string
+	done := make(chan struct{})
+	err := maago.WithTx(t.Context(), db, func(ctx context.Context, tx maago.Tx) error {
+		if _, err := InsertBoard(ctx, tx, NewBoardInput{Name: "자유"}); err != nil {
+			return err
+		}
+		go func() {
+			defer close(done)
+			code, _, body = post(h, BoardCreateURL(), url.Values{"name": {"자유"}})
+		}()
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	<-done
+	if code != 200 || !strings.Contains(body, "This value is already taken.") {
+		t.Errorf("B: %d %s", code, body)
+	}
+	if bs, err := BoardList(t.Context(), db); err != nil || len(bs) != 1 {
+		t.Errorf("boards: %v %v", bs, err)
+	}
+}
+
