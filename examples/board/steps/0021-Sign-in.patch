 // get requests path and returns the status and the body.
 func get(h http.Handler, path string) (int, string) {
+	return getAs(h, path, nil)
+}
+
+// getAs is get with the session cookie s, if not nil.
+func getAs(h http.Handler, path string, s *http.Cookie) (int, string) {
+	r := httptest.NewRequest("GET", path, nil)
+	if s != nil {
+		r.AddCookie(s)
+	}
 	w := httptest.NewRecorder()
-	h.ServeHTTP(w, httptest.NewRequest("GET", path, nil))
