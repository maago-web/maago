+
+const password = "correct horse battery staple"
+
+// newUser adds a verified account that may sign in.
+func newUser(t *testing.T, db *sql.DB, email string) auth.User {
+	t.Helper()
+	hash, err := authlib.Hash(password)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	u, err := auth.InsertUser(t.Context(), db, auth.NewUserInput{Email: email, PasswordHash: hash, VerifiedAt: &now})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return u
+}
+
+// login signs in as email and returns the session cookie.
+func login(t *testing.T, h http.Handler, email string) *http.Cookie {
+	t.Helper()
+	w := postAs(h, "/login", url.Values{"email": {email}, "password": {password}}, nil)
+	if w.Code != 303 || len(w.Result().Cookies()) != 1 {
+		t.Fatalf("login %s: %d", email, w.Code)
+	}
+	return w.Result().Cookies()[0]
+}
+
+// Signed in, the home page says who; the header links to sign in and out.
+func TestSignIn(t *testing.T) {
+	h, db := app(t)
+	newUser(t, db, "ann@example.com")
+	if _, body := get(h, "/"); strings.Contains(body, "로그인했습니다") || !strings.Contains(body, `href="/login"`) || !strings.Contains(body, `action="/logout"`) {
+		t.Errorf("before: %s", body)
+	}
+	s := login(t, h, "ann@example.com")
+	if _, body := getAs(h, "/", s); !strings.Contains(body, "ann@example.com(으)로 로그인했습니다.") {
+		t.Errorf("after: %s", body)
+	}
+}
