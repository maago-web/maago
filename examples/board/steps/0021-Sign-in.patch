 const front = "http://localhost:5173"
 
+// config is main's, on db.
+func config(db *sql.DB) maago.Config {
+	return maago.Config{DB: db, Apps: []maago.App{App, auth.App}, Origins: []string{front}, Auth: auth.Current, LoginURL: "/login"}
+}
