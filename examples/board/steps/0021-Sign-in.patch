-	h, err := maago.Handler(maago.Config{DB: db, Apps: []maago.App{App}, Origins: []string{front}})
+	h, err := maago.Handler(config(db))
 	if err != nil {
 		t.Fatal(err)
 	}
@@ -32,19 +44,37 @@ func app(t *testing.T) (http.Handler, *sql.DB) {
 
 // get requests path and returns the status and the body.
 func get(h http.Handler, path string) (int, string) {
+	return getAs(h, path, nil)
+}
+
+// getAs is get with the session cookie s, if not nil.
+func getAs(h http.Handler, path string, s *http.Cookie) (int, string) {
+	r := httptest.NewRequest("GET", path, nil)
+	if s != nil {
+		r.AddCookie(s)
+	}
 	w := httptest.NewRecorder()
-	h.ServeHTTP(w, httptest.NewRequest("GET", path, nil))
+	h.ServeHTTP(w, r)
 	return w.Code, w.Body.String()
 }
 
 // post sends form to path, as a browser on the same site does, and returns
 // the status, the Location and the body.
 func post(h http.Handler, path string, form url.Values) (int, string, string) {
+	w := postAs(h, path, form, nil)
+	return w.Code, w.Header().Get("Location"), w.Body.String()
+}
+
+// postAs is post with the session cookie s, if not nil.
+func postAs(h http.Handler, path string, form url.Values, s *http.Cookie) *httptest.ResponseRecorder {
 	r := httptest.NewRequest("POST", path, strings.NewReader(form.Encode()))
 	r.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	if s != nil {
+		r.AddCookie(s)
+	}
 	w := httptest.NewRecorder()
 	h.ServeHTTP(w, r)
-	return w.Code, w.Header().Get("Location"), w.Body.String()
+	return w
 }
 
 func TestPages(t *testing.T) {
@@ -390,12 +420,18 @@ func TestExport(t *testing.T) {
 func TestUnderApp(t *testing.T) {
 	// The prefix is the process's, the last Handler's: make it first.
 	db := maagotest.DB(t)
-	h, err := maago.Handler(maago.Config{DB: db, Apps: []maago.App{App}, Prefix: "/app"})
+	cfg := config(db)
+	cfg.Prefix, cfg.LoginURL = "/app", "/app/login"
