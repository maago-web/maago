+// fileMeta is what f tells of itself: an image's size, for the formats
+// imported for it here. A file that is no such image tells nothing: nil.
+func fileMeta(f maago.File) (*maago.JSON[AttachmentMeta], error) {
+	r, err := f.Open()
+	if err != nil {
+		return nil, err
+	}
+	defer r.Close()
+	c, _, err := image.DecodeConfig(r)
+	if err != nil {
+		return nil, nil // not an image Go reads
+	}
+	return &maago.JSON[AttachmentMeta]{V: AttachmentMeta{Width: c.Width, Height: c.Height}}, nil
+}
