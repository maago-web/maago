+// APIPost is the post of a key as JSON, for the link a frontend gives
+// out. A key is not a password: a draft's is not found but for its author
+// and staff (policy visible), as by its id.
+func APIPost(ctx context.Context, u *auth.User, db maago.DB, in APIPostIn) (Post, error) {
+	return PostByKey(ctx, u, db, PostByKeyParams{Key: in.Key, Now: time.Now()})
+}
