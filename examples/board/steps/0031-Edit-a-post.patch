 }
+
+// A post's author or staff change its title and body; when it is pinned
+// and published stays. The title is still one of a kind on its board.
+func TestEdit(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	other, err := InsertBoard(ctx, db, NewBoardInput{Name: "공지"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	asAnn, ann := signedIn(t, h, db, "ann@example.com")
+	boss, err := auth.CreateSuperuser(ctx, db, "boss@example.com", password)
+	if err != nil {
+		t.Fatal(err)
+	}
+	asBoss := maagotest.As(h, login(t, h, boss.Email))
+	from, until, at := time.Now().Add(time.Hour), time.Now().Add(2*time.Hour), time.Now().Add(3*time.Hour)
+	p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, AuthorID: &ann.ID, Title: "앤의 글", Body: "본문", PinnedFrom: &from, PinnedUntil: &until, PublishAt: &at})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, in := range []NewPostInput{
+		{BoardID: b.ID, Title: "있는 제목", Body: "본문"},
+		{BoardID: other.ID, Title: "다른 게시판의 제목", Body: "본문"},
+	} {
+		if _, err := InsertPost(ctx, db, in); err != nil {
+			t.Fatal(err)
+		}
+	}
+	h2, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, AuthorID: &ann.ID, Title: "숨긴 글", Body: "본문", Hidden: maago.Set(true)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	hidden := PostEditURL(h2.ID)
+	// version is the query of the form's action: the post's version now.
+	version := func(id int64) string {
+		p, err := GetPost(ctx, db, id)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return "?version=" + strconv.FormatInt(p.UpdatedAt.UnixMicro(), 10)
+	}
+	// As the database keeps it: to the microsecond, where Go's clock may
+	// say more.
+	before, err := GetPost(ctx, db, p.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if code, body := get(asAnn, PostEditURL(p.ID)); code != 200 || !strings.Contains(body, `value="앤의 글"`) || !strings.Contains(body, ">본문</textarea>") {
+		t.Errorf("the form: %d %s", code, body)
+	}
+	for _, c := range []struct {
+		who   string
+		h     http.Handler
+		path  string
+		title string
+		code  int
+	}{
+		{"ann", asAnn, hidden, "", 404},
+		{"ann", asAnn, PostChangeURL(p.ID), "있는 제목", 200}, // taken on this board
+		{"ann", asAnn, PostChangeURL(p.ID), "앤의 글", 303},  // its own title
+		{"ann", asAnn, PostChangeURL(p.ID), "다른 게시판의 제목", 303},
+		{"boss", asBoss, PostChangeURL(p.ID), "고친 제목", 303},
+	} {
+		var code int
+		var body string
+		if c.title == "" {
+			code, body = get(c.h, c.path)
+		} else { // with the version the form would carry now
+			code, _, body = post(c.h, c.path+version(p.ID), url.Values{"title": {c.title}, "body": {"고친 본문"}})
+		}
+		if code != c.code {
+			t.Errorf("%s %s %q: %d, want %d\n%s", c.who, c.path, c.title, code, c.code, body)
+		}
+		if c.code == 200 && !strings.Contains(body, "이 게시판에 같은 제목의 글이 있습니다.") {
+			t.Errorf("%s %q: no error on the title\n%s", c.who, c.title, body)
+		}
+	}
+
+	// A form opened before the saves above does not undo them: it draws
+	// again with what was written, and saves nothing.
+	stale := PostChangeURL(p.ID) + "?version=" + strconv.FormatInt(before.UpdatedAt.UnixMicro(), 10)
+	if code, _, body := post(asAnn, stale, url.Values{"title": {"늦은 제목"}, "body": {"늦은 본문"}}); code != 200 || !strings.Contains(body, "그새 다른 사람이") || !strings.Contains(body, `value="늦은 제목"`) {
+		t.Errorf("a stale form: %d %s", code, body)
+	}
+	if code, _, _ := post(asAnn, PostChangeURL(p.ID), url.Values{"title": {"버전 없는 제목"}, "body": {"본문"}}); code != 400 {
+		t.Errorf("no version: %d", code)
+	}
+
+	got, err := GetPost(ctx, db, p.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Title != "고친 제목" || got.Body != "고친 본문" || got.UpdatedAt.Equal(before.UpdatedAt) {
+		t.Errorf("after: %q %q %v", got.Title, got.Body, got.UpdatedAt)
+	}
+	if !got.PinnedFrom.Equal(*before.PinnedFrom) || !got.PinnedUntil.Equal(*before.PinnedUntil) || !got.PublishAt.Equal(*before.PublishAt) {
+		t.Errorf("the times changed: %v %v %v", got.PinnedFrom, got.PinnedUntil, got.PublishAt)
+	}
+}
