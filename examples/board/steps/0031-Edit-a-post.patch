+
+type EditPostIn struct {
+	ID   int64        `maago:"path=id"`
+	Form PostEditForm `maago:"form"`
+}
+
+// ChangePostIn is EditPostIn with the version of the post the form was
+// opened on: its UpdatedAt in microseconds, in the form's action URL.
+type ChangePostIn struct {
+	ID      int64        `maago:"path=id"`
+	Version int64        `maago:"query=version"`
+	Form    PostEditForm `maago:"form"`
+}
+
+type PostEditPage struct {
+	Post    Post
+	Form    PostEditForm
+	Version int64
+}
+
+// EditPost draws the form to change a post's title and body, for its
+// author or staff. The form starts with what the post has.
+func EditPost(ctx context.Context, u auth.User, db maago.DB, in EditPostIn) (PostEditPage, error) {
+	p, err := editable(ctx, db, u, in.ID)
+	if err != nil {
+		return PostEditPage{}, err
+	}
+	f := in.Form
+	f.Title.Raw, f.Body.Raw = p.Title, p.Body
+	return PostEditPage{p, f, p.UpdatedAt.UnixMicro()}, nil
+}
+
+// ChangePost saves the title and body, unless somebody saved the post
+// after the form was opened: then the form draws again with what was
+// written, and saves only once opened anew.
+func ChangePost(ctx context.Context, u auth.User, tx maago.Tx, in ChangePostIn) (maago.Result[PostEditPage], error) {
+	p, err := editable(ctx, tx, u, in.ID)
+	if err != nil {
+		return maago.Result[PostEditPage]{}, err
+	}
+	f := in.Form
+	if !f.Valid() {
+		return maago.Show(PostEditPage{p, f, in.Version}), nil
+	}
+	taken, err := PostTitleTaken(ctx, tx, PostTitleTakenParams{BoardID: p.BoardID, Title: f.Title.Value, SkipID: &p.ID})
+	if err != nil {
+		return maago.Result[PostEditPage]{}, err
+	}
+	if taken.N > 0 {
+		f.Title.Error = "이 게시판에 같은 제목의 글이 있습니다."
+		return maago.Show(PostEditPage{p, f, in.Version}), nil
+	}
+	changed := p
+	changed.Title, changed.Body = f.Title.Value, f.Body.Value
+	changed.UpdatedAt = time.UnixMicro(in.Version) // UpdatePost writes only over this version
+	switch err := UpdatePost(ctx, tx, &changed); {
+	case errors.Is(err, maago.ErrConflict):
+		f.AddError("그새 다른 사람이 이 글을 고쳤습니다. 다시 열어 고치세요.")
+		return maago.Show(PostEditPage{p, f, in.Version}), nil
+	case err != nil:
+		return maago.Result[PostEditPage]{}, err
+	}
+	return maago.SeeOther[PostEditPage](PostDetailURL(p.ID)), nil
+}
+
+// editable is post id, for its author or staff to change. A hidden post
+// is not found.
+func editable(ctx context.Context, db maago.DB, u auth.User, id int64) (Post, error) {
+	p, err := GetPost(ctx, db, id)
+	switch {
+	case err != nil:
+		return Post{}, err
+	case p.Hidden:
+		return Post{}, sql.ErrNoRows
+	}
+	if err := mayChange(u, p); err != nil {
+		return Post{}, err
+	}
+	return p, nil
+}
