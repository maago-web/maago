diff --git a/board/views.go b/board/views.go
index b02f07d..f62f1bd 100644
--- a/board/views.go
+++ b/board/views.go
@@ -437,3 +437,49 @@ func Me(ctx context.Context, in struct{}) (MePage, error) {
 	ps, err := MyPosts(ctx, maago.DBFrom(ctx), MyPostsParams{AuthorID: u.ID})
 	return MePage{Email: u.Email, Posts: ps}, err
 }
+
+type EditPostIn struct {
+	ID   int64        `maago:"path=id"`
+	Form PostEditForm `maago:"form"`
+}
+
+type PostEditPage struct {
+	Post Post
+	Form PostEditForm
+}
+
+// EditPost changes a post's title and body, for its author or staff. The
+// form starts with what the post has.
+func EditPost(ctx context.Context, in EditPostIn) (maago.Result[PostEditPage], error) {
+	db := maago.DBFrom(ctx)
+	p, err := GetPost(ctx, db, in.ID)
+	switch {
+	case err != nil:
+		return maago.Result[PostEditPage]{}, err
+	case p.Hidden:
+		return maago.Result[PostEditPage]{}, sql.ErrNoRows
+	}
+	if err := mayChange(ctx, p); err != nil {
+		return maago.Result[PostEditPage]{}, err
+	}
+	f := in.Form
+	if !f.Bound() {
+		f.Title.Raw, f.Body.Raw = p.Title, p.Body
+	}
+	if !f.Valid() {
+		return maago.Show(PostEditPage{Post: p, Form: f}), nil
+	}
+	taken, err := PostTitleTaken(ctx, db, PostTitleTakenParams{BoardID: p.BoardID, Title: f.Title.Value, SkipID: &p.ID})
+	if err != nil {
+		return maago.Result[PostEditPage]{}, err
+	}
+	if taken.N > 0 {
+		f.Title.Error = "이 게시판에 같은 제목의 글이 있습니다."
+		return maago.Show(PostEditPage{Post: p, Form: f}), nil
+	}
+	p.Title, p.Body = f.Title.Value, f.Body.Value
+	if err := UpdatePost(ctx, db, &p); err != nil {
+		return maago.Result[PostEditPage]{}, err
+	}
+	return maago.SeeOther[PostEditPage](PostDetailURL(p.ID)), nil
+}
diff --git a/board/web_test.go b/board/web_test.go
index 7b884f4..17c49e6 100644
--- a/board/web_test.go
+++ b/board/web_test.go
@@ -682,3 +682,91 @@ func TestMe(t *testing.T) {
 		t.Errorf("/api/me without a token: %d %v", w.Code, w.Header())
 	}
 }
+
+// A post's author or staff change its title and body; when it is pinned
+// and published stays. The title is still one of a kind on its board.
+func TestEdit(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	other, err := InsertBoard(ctx, db, NewBoardInput{Name: "공지"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	asAnn, ann := signedIn(t, h, db, "ann@example.com")
+	asBob, _ := signedIn(t, h, db, "bob@example.com")
+	boss, err := auth.CreateSuperuser(ctx, db, "boss@example.com", password)
+	if err != nil {
+		t.Fatal(err)
+	}
+	asBoss := as(h, login(t, h, boss.Email))
+	from, until, at := time.Now().Add(time.Hour), time.Now().Add(2*time.Hour), time.Now().Add(3*time.Hour)
+	p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, AuthorID: &ann.ID, Title: "앤의 글", Body: "본문", PinnedFrom: &from, PinnedUntil: &until, PublishAt: &at})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, in := range []NewPostInput{
+		{BoardID: b.ID, Title: "있는 제목", Body: "본문"},
+		{BoardID: other.ID, Title: "다른 게시판의 제목", Body: "본문"},
+	} {
+		if _, err := InsertPost(ctx, db, in); err != nil {
+			t.Fatal(err)
+		}
+	}
+	h2, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, AuthorID: &ann.ID, Title: "숨긴 글", Body: "본문", Hidden: maago.Set(true)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	hidden := PostEditURL(h2.ID)
+
+	if code, body := get(asAnn, PostEditURL(p.ID)); code != 200 || !strings.Contains(body, `value="앤의 글"`) || !strings.Contains(body, ">본문</textarea>") {
+		t.Errorf("the form: %d %s", code, body)
+	}
+	if code, _ := get(h, PostEditURL(p.ID)); code != 303 {
+		t.Errorf("the form without a sign-in: %d", code)
+	}
+	for _, c := range []struct {
+		who   string
+		h     http.Handler
+		path  string
+		title string
+		code  int
+	}{
+		{"nobody", h, PostUpdateURL(p.ID), "새 제목", 401},
+		{"bob", asBob, PostEditURL(p.ID), "", 403},
+		{"bob", asBob, PostUpdateURL(p.ID), "밥의 제목", 403},
+		{"ann", asAnn, hidden, "", 404},
+		{"ann", asAnn, PostUpdateURL(p.ID), "있는 제목", 200}, // taken on this board
+		{"ann", asAnn, PostUpdateURL(p.ID), "앤의 글", 303},  // its own title
+		{"ann", asAnn, PostUpdateURL(p.ID), "다른 게시판의 제목", 303},
+		{"boss", asBoss, PostUpdateURL(p.ID), "고친 제목", 303},
+	} {
+		var code int
+		var body string
+		if c.title == "" {
+			code, body = get(c.h, c.path)
+		} else {
+			code, _, body = post(c.h, c.path, url.Values{"title": {c.title}, "body": {"고친 본문"}})
+		}
+		if code != c.code {
+			t.Errorf("%s %s %q: %d, want %d\n%s", c.who, c.path, c.title, code, c.code, body)
+		}
+		if c.code == 200 && !strings.Contains(body, "이 게시판에 같은 제목의 글이 있습니다.") {
+			t.Errorf("%s %q: no error on the title\n%s", c.who, c.title, body)
+		}
+	}
+
+	got, err := GetPost(ctx, db, p.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Title != "고친 제목" || got.Body != "고친 본문" || got.UpdatedAt.Equal(p.UpdatedAt) {
+		t.Errorf("after: %q %q %v", got.Title, got.Body, got.UpdatedAt)
+	}
+	if !got.PinnedFrom.Equal(*p.PinnedFrom) || !got.PinnedUntil.Equal(*p.PinnedUntil) || !got.PublishAt.Equal(*p.PublishAt) {
+		t.Errorf("the times changed: %v %v %v", got.PinnedFrom, got.PinnedUntil, got.PublishAt)
+	}
+}
