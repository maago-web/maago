 }
+
+// PostEditForm is what changes in a post: its title and body. When to pin
+// and publish it is decided when it is written.
+type PostEditForm struct {
+	maago.Form `maago:"model=Post"`
+	Title      maago.Field[string]
+	Body       maago.Field[string]
+}
diff --git a/board/queries/post_title_taken.sql b/board/queries/post_title_taken.sql
index d28b47e..e17b664 100644
--- a/board/queries/post_title_taken.sql
+++ b/board/queries/post_title_taken.sql
@@ -1,8 +1,11 @@
 -- name: PostTitleTaken :one Count
--- How many posts of the board have the title: 0 or 1.
+-- How many posts of the board have the title: 0 or 1. With skip_id, the
+-- post being changed does not count.
 -- param: board_id int64
 -- param: title    string
+-- param: skip_id? int64
 -- column: n int64
 SELECT count(*) AS n
 FROM board_post
 WHERE board_id = :board_id AND title = :title
+  {skip_id} AND id <> :skip_id
