+// The pages link the stylesheet by a name with its content's hash, which
+// browsers keep for a year (D-137).
+func TestStylesheet(t *testing.T) {
+	h, _ := app(t)
+	_, body := get(h, HomeURL())
+	link := regexp.MustCompile(`href="(/static/board/tailwind\.[0-9a-f]{16}\.css)"`).FindStringSubmatch(body)
+	if link == nil {
+		t.Fatalf("no stylesheet:\n%s", body)
+	}
+	r := httptest.NewRequest("GET", link[1], nil)
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	if w.Code != 200 || !strings.Contains(w.Body.String(), "tailwindcss") || w.Header().Get("Cache-Control") != "public, max-age=31536000, immutable" {
+		t.Errorf("%s: %d %v", link[1], w.Code, w.Header())
+	}
+}
