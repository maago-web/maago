@@ -0,0 +1,33 @@
+CREATE TABLE "maago_new_board_post" (
+    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
+    "board_id" INTEGER NOT NULL,
+    "title" TEXT NOT NULL CHECK (length("title") <= 200),
+    "body" TEXT NOT NULL,
+    "status" TEXT NOT NULL DEFAULT 'draft' CHECK ("status" IN ('draft', 'published', 'archived')),
+    "views" INTEGER NOT NULL DEFAULT 0,
+    "created_at" TEXT NOT NULL,
+    "updated_at" TEXT NOT NULL,
+    "pinned_from" TEXT,
+    "pinned_until" TEXT,
+    "publish_at" TEXT,
+    "hidden" INTEGER NOT NULL DEFAULT 0 CHECK ("hidden" IN (0, 1)),
+    "author_id" INTEGER,
+    CONSTRAINT "board_post_board_id_fkey" FOREIGN KEY ("board_id") REFERENCES "board_board" ("id") ON DELETE NO ACTION,
+    CONSTRAINT "board_post_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "auth_user" ("id") ON DELETE NO ACTION
+) STRICT;
+
+INSERT INTO "maago_new_board_post" ("id", "board_id", "title", "body", "status", "views", "created_at", "updated_at", "pinned_from", "pinned_until", "publish_at", "hidden") SELECT "id", "board_id", "title", "body", "status", "views", "created_at", "updated_at", "pinned_from", "pinned_until", "publish_at", "hidden" FROM "board_post";
+
+DELETE FROM sqlite_sequence WHERE name = 'maago_new_board_post';
+
+INSERT INTO sqlite_sequence (name, seq) SELECT 'maago_new_board_post', seq FROM sqlite_sequence WHERE name = 'board_post';
+
+DROP TABLE "board_post";
+
+ALTER TABLE "maago_new_board_post" RENAME TO "board_post";
+
+CREATE UNIQUE INDEX "board_post_board_id_title_key" ON "board_post" ("board_id", "title");
+
+CREATE INDEX "board_post_board_id_idx" ON "board_post" ("board_id");
+
+CREATE INDEX "board_post_author_id_idx" ON "board_post" ("author_id");
