 	}
 }
+
+// mayChange refuses with 403 whoever neither wrote p nor is staff. A post
+// from before there were accounts has no author: staff change it.
+func mayChange(ctx context.Context, p Post) error {
+	u, _ := maago.UserFrom[auth.User](ctx) // the routes require login
+	if u.IsStaff || p.AuthorID != nil && *p.AuthorID == u.ID {
+		return nil
+	}
+	return maago.Status(http.StatusForbidden, errors.New("only its author or staff may change a post"))
+}
