+// Writing needs a sign-in; publishing, archiving and deleting a post need
+// its author or staff.
+func TestAuthors(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if code, _ := get(h, PostNewURL(b.ID)); code != 303 {
+		t.Errorf("the form without a sign-in: %d", code)
+	}
+	for _, path := range []string{BoardCreateURL(), PostCreateURL(b.ID), CommentCreateURL(1), PostPublishURL(1)} {
+		if code, _, _ := post(h, path, url.Values{"title": {"t"}}); code != 401 {
+			t.Errorf("POST %s without a sign-in: %d", path, code)
+		}
+	}
+
+	asAnn, ann := signedIn(t, h, db, "ann@example.com")
+	asBob, _ := signedIn(t, h, db, "bob@example.com")
+	boss, err := auth.CreateSuperuser(ctx, db, "boss@example.com", password)
+	if err != nil {
+		t.Fatal(err)
+	}
+	asBoss := as(h, login(t, h, boss.Email))
+	if code, loc, _ := post(asAnn, PostCreateURL(b.ID), url.Values{"title": {"앤의 글"}, "body": {"본문"}}); code != 303 || loc != PostDetailURL(1) {
+		t.Fatalf("ann writes: %d %q", code, loc)
+	}
+	if p, err := GetPost(ctx, db, 1); err != nil || p.AuthorID == nil || *p.AuthorID != ann.ID {
+		t.Fatalf("the author: %v %v", p.AuthorID, err)
+	}
+	old, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "계정 전의 글", Body: "본문"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range []struct {
+		who  string
+		h    http.Handler
+		path string
+		code int
+	}{
+		{"bob", asBob, PostPublishURL(1), 403},
+		{"bob", asBob, PostArchiveURL(1), 403},
+		{"bob", asBob, PostDeleteURL(1), 403},
+		{"ann", asAnn, PostPublishURL(old.ID), 403}, // no author: staff only
+		{"ann", asAnn, PostDeleteURL(old.ID), 403},
+		{"ann", asAnn, PostPublishURL(1), 303},
+		{"ann", asAnn, PostArchiveURL(1), 303},
+		{"ann", asAnn, PostDeleteURL(1), 303},
+		{"boss", asBoss, PostPublishURL(old.ID), 303},
+		{"boss", asBoss, PostArchiveURL(old.ID), 303},
+		{"boss", asBoss, PostDeleteURL(old.ID), 303},
+	} {
+		if code, _, body := post(c.h, c.path, nil); code != c.code {
+			t.Errorf("%s POST %s: %d, want %d\n%s", c.who, c.path, code, c.code, body)
+		}
+	}
+}
