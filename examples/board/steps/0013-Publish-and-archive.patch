 <h1>{{.Post.Title}}</h1>
 <p>{{.Post.Status}} · 조회 {{.Post.Views}}</p>
 <div>{{.Post.Body}}</div>
+{{if eq .Post.Status "draft"}}<form method="post" action="{{url "post_publish" .Post.ID}}"><button>게시하기</button></form>{{end}}
+{{if eq .Post.Status "published"}}<form method="post" action="{{url "post_archive" .Post.ID}}"><button>보관하기</button></form>{{end}}
 {{end}}
