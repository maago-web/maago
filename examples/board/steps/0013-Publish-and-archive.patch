diff --git a/board/views.go b/board/views.go
index 26f272d..e17a025 100644
--- a/board/views.go
+++ b/board/views.go
@@ -2,6 +2,7 @@ package board
 
 import (
 	"context"
+	"net/http"
 	"time"
 
 	"github.com/maago-web/maago"
@@ -157,3 +158,31 @@ func NewPost(ctx context.Context, in NewPostIn) (maago.Result[PostFormPage], err
 	}
 	return maago.SeeOther[PostFormPage](PostDetailURL(p.ID)), nil
 }
+
+// Publish publishes a draft.
+func Publish(ctx context.Context, in PostIn) (maago.Result[PostPage], error) {
+	return move(ctx, in.ID, "published")
+}
+
+// Archive archives a published post.
+func Archive(ctx context.Context, in PostIn) (maago.Result[PostPage], error) {
+	return move(ctx, in.ID, "archived")
+}
+
+// move gives post id status to, if Post.Next allows it, and goes back to
+// the post. What it does not allow is a 409 Conflict.
+func move(ctx context.Context, id int64, to string) (maago.Result[PostPage], error) {
+	db := maago.DBFrom(ctx)
+	p, err := GetPost(ctx, db, id)
+	if err != nil {
+		return maago.Result[PostPage]{}, err
+	}
+	if err := p.Next(to); err != nil {
+		return maago.Result[PostPage]{}, maago.Status(http.StatusConflict, err)
+	}
+	p.Status = to
+	if err := UpdatePost(ctx, db, &p); err != nil {
+		return maago.Result[PostPage]{}, err
+	}
+	return maago.SeeOther[PostPage](PostDetailURL(id)), nil
+}
diff --git a/board/web_test.go b/board/web_test.go
index f5bfaf6..b424fe9 100644
--- a/board/web_test.go
+++ b/board/web_test.go
@@ -190,3 +190,34 @@ func TestPinAndSchedule(t *testing.T) {
 		t.Errorf("search:\n%s", body)
 	}
 }
+
+func TestPublishAndArchive(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "글", Body: "본문"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range []struct {
+		path string
+		code int
+	}{
+		{PostArchiveURL(p.ID), 409}, // a draft is not archived
+		{PostPublishURL(p.ID), 303},
+		{PostPublishURL(p.ID), 409}, // not twice
+		{PostArchiveURL(p.ID), 303},
+		{PostPublishURL(p.ID), 409}, // archived is the end
+		{PostPublishURL(p.ID + 1), 404},
+	} {
+		if code, _, body := post(h, c.path, nil); code != c.code {
+			t.Errorf("POST %s: %d, want %d:\n%s", c.path, code, c.code, body)
+		}
+	}
+	if got, err := GetPost(ctx, db, p.ID); err != nil || got.Status != "archived" {
+		t.Errorf("%q %v", got.Status, err)
+	}
+}
