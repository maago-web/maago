+	PublishAt *time.Time `maago:"label='게시 시각'"`
 }
 
 type Comment struct {
diff --git a/board/queries/pinned_overlap.sql b/board/queries/pinned_overlap.sql
new file mode 100644
index 0000000..91f4ede
--- /dev/null
+++ b/board/queries/pinned_overlap.sql
@@ -0,0 +1,9 @@
+-- name: PinnedOverlap :one Count
+-- How many posts of the board are pinned for some of from..until.
+-- param: board_id int64
+-- param: from     time.Time
+-- param: until    time.Time
+-- column: n int64
+SELECT count(*) AS n
+FROM board_post
+WHERE board_id = :board_id AND pinned_from < :until AND pinned_until > :from
diff --git a/board/queries/post_list.sql b/board/queries/post_list.sql
index eec1a64..fdfb466 100644
--- a/board/queries/post_list.sql
+++ b/board/queries/post_list.sql
@@ -1,6 +1,8 @@
 -- name: PostList :many PostSummary
--- The posts of a board, newest first, one page at a time.
+-- The posts of a board out by now, one page at a time: the notices pinned
+-- now first, then the newest.
 -- param: board_id int64
+-- param: now      time.Time
 -- param: limit    int64
 -- param: offset   int64
 -- column: comments int64
@@ -8,5 +10,7 @@ SELECT p.id, p.title, p.created_at,
        (SELECT count(*) FROM board_comment c WHERE c.post_id = p.id) AS comments
 FROM board_post p
 WHERE p.board_id = :board_id
-ORDER BY p.created_at DESC, p.id DESC
+  AND (p.publish_at IS NULL OR p.publish_at <= :now)
+ORDER BY CASE WHEN p.pinned_from <= :now AND p.pinned_until > :now THEN 0 ELSE 1 END,
+         p.created_at DESC, p.id DESC
 LIMIT :limit OFFSET :offset
diff --git a/board/queries/recent_posts.sql b/board/queries/recent_posts.sql
index 82165b7..1ede919 100644
--- a/board/queries/recent_posts.sql
+++ b/board/queries/recent_posts.sql
@@ -1,7 +1,8 @@
 -- name: RecentPosts :many Post
 -- The newest posts of every board.
 -- param: limit int64
-SELECT id, board_id, title, status, views, created_at, updated_at, body
+SELECT id, board_id, title, status, views, created_at, updated_at, body,
+       pinned_from, pinned_until, publish_at
 FROM board_post
 ORDER BY created_at DESC, id DESC
 LIMIT :limit
