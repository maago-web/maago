From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maago <maago@example.com>
Date: Mon, 5 Oct 2026 02:25:55 +0900
Subject: [PATCH] Pin notices and schedule posts
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

글을 게시판 위에 고정하고(공지), 정한 시각에 보이게 한다(예약).

- Post에 PinnedFrom·PinnedUntil·PublishAt을 더한다. *time.Time이라 NULL을
  받는다. maago makemigrations --name pin_and_schedule이 0004를 쓴다
- maago gen이 recent_posts.sql을 막는다. 결과 타입이 Post인데 새 컬럼을
  고르지 않았다. 셋을 더해 고른다
- 폼의 시각 필드는 maago.Field[time.Time]과 optional이다. 비워 두면
  Given이 거짓이고, 뷰가 모델에 nil을 넘긴다(given)
- 필드 하나로는 모르는 것은 폼의 Validate가 본다: 끝이 시작보다 뒤인지,
  지난 시각으로 예약하지 않는지. Validate는 필드를 다 읽은 뒤에만 돌고,
  DB를 보지 않는다. 문구는 필드의 Error나 폼의 AddError로.
  datetime-local은 분까지 보내니, 지금 이 분은 지난 시각이 아니다
- 같은 게시판에서 고정 기간이 겹치는지는 DB를 봐야 안다. 뷰가
  pinned_overlap.sql로 본다
- 목록과 검색 쿼리가 :now를 받아 아직 때가 아닌 글을 거르고, 지금 고정된
  글을 먼저 놓는다
- 템플릿의 {{define "time"}}은 시각 필드 하나를 그린다. 셋이 그것을
  {{template "time" .Form.PinnedFrom}}으로 부른다. maago gen은 그 안도
  Field[time.Time]으로 걸어 본다

<input type="datetime-local">이 보내는 값은 Config.TimeZone의 시각으로
읽힌다(기본 UTC).

diff --git a/board/forms.go b/board/forms.go
index 6db3438..b9cefcd 100644
--- a/board/forms.go
+++ b/board/forms.go
@@ -1,6 +1,10 @@
 package board
 
-import "github.com/maago-web/maago"
+import (
+	"time"
+
+	"github.com/maago-web/maago"
+)
 
 // BoardForm takes its fields' rules from the model: the name is required,
 // and at most 100 characters.
@@ -9,9 +13,39 @@ type BoardForm struct {
 	Name       maago.Field[string]
 }
 
-// PostForm is the post's title and body. The board comes from the path.
+// PostForm is the post's title and body, and when to pin and publish it.
+// The board comes from the path. The model's times are pointers, NULL when
+// not set; a form field is optional instead, and Given says it was set.
 type PostForm struct {
-	maago.Form `maago:"model=Post"`
-	Title      maago.Field[string]
-	Body       maago.Field[string]
+	maago.Form  `maago:"model=Post"`
+	Title       maago.Field[string]
+	Body        maago.Field[string]
+	PinnedFrom  maago.Field[time.Time] `maago:"optional"`
+	PinnedUntil maago.Field[time.Time] `maago:"optional"`
+	PublishAt   maago.Field[time.Time] `maago:"optional"`
+}
+
+// Validate checks what the fields alone cannot: it runs once every field
+// has read. It sees only the form; what needs the database is the view's.
+func (f *PostForm) Validate() {
+	from, until := f.PinnedFrom, f.PinnedUntil
+	switch {
+	case from.Given != until.Given:
+		f.AddError("고정하려면 시작과 끝을 함께 적으세요.")
+	case from.Given && !until.Value.After(from.Value):
+		f.PinnedUntil.Error = "끝은 시작보다 뒤여야 합니다."
+	}
+	// datetime-local sends minutes: this minute is not past yet.
+	if f.PublishAt.Given && f.PublishAt.Value.Before(time.Now().Truncate(time.Minute)) {
+		f.PublishAt.Error = "지난 시각으로 예약할 수 없습니다."
+	}
+}
+
+// given is a field's value, or nil when it was left empty: what a pointer
+// field of the model takes.
+func given(f maago.Field[time.Time]) *time.Time {
+	if !f.Given {
+		return nil
+	}
+	return &f.Value
 }
