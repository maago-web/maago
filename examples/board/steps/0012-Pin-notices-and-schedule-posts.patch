diff --git a/board/web_test.go b/board/web_test.go
index 5cc8c1c..f5bfaf6 100644
--- a/board/web_test.go
+++ b/board/web_test.go
@@ -8,6 +8,7 @@ import (
 	"net/url"
 	"strings"
 	"testing"
+	"time"
 
 	"github.com/maago-web/maago"
 	"github.com/maago-web/maago/maagotest"
@@ -131,3 +132,61 @@ func TestWrite(t *testing.T) {
 		t.Errorf("cross-site post: %d", w.Code)
 	}
 }
+
+func TestPinAndSchedule(t *testing.T) {
+	h, db := app(t)
+	b, err := InsertBoard(t.Context(), db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// As <input type="datetime-local"> sends it, in Config.TimeZone (UTC).
+	at := func(d time.Duration) string { return time.Now().UTC().Add(d).Format("2006-01-02T15:04") }
+	write := func(title string, more ...string) (int, string) {
+		v := url.Values{"title": {title}, "body": {"본문"}}
+		for i := 0; i < len(more); i += 2 {
+			v.Set(more[i], more[i+1])
+		}
+		code, _, body := post(h, PostCreateURL(b.ID), v)
+		return code, body
+	}
+
+	for _, c := range []struct {
+		title string
+		more  []string
+		has   string
+	}{
+		{"끝이 앞", []string{"pinned_from", at(time.Hour), "pinned_until", at(-time.Hour)}, "끝은 시작보다 뒤여야 합니다."},
+		{"끝이 없음", []string{"pinned_from", at(0)}, "시작과 끝을 함께 적으세요."},
+		{"지난 예약", []string{"publish_at", at(-time.Hour)}, "지난 시각으로 예약할 수 없습니다."},
+		{"날짜 아님", []string{"publish_at", "내일"}, "Enter a date and time."},
+	} {
+		if code, body := write(c.title, c.more...); code != 200 || !strings.Contains(body, c.has) {
+			t.Errorf("%s: %d, want 200 with %q:\n%s", c.title, code, c.has, body)
+		}
+	}
+
+	if code, body := write("공지", "pinned_from", at(-time.Hour), "pinned_until", at(24*time.Hour)); code != 303 {
+		t.Fatalf("notice: %d %s", code, body)
+	}
+	if code, body := write("다른 공지", "pinned_from", at(time.Hour), "pinned_until", at(2*time.Hour)); code != 200 || !strings.Contains(body, "고정된 다른 공지가 있습니다") {
+		t.Errorf("overlap: %d %s", code, body)
+	}
+	for _, w := range [][]string{
+		{"다음 달 행사", "pinned_from", at(25 * time.Hour), "pinned_until", at(26 * time.Hour)}, // after the notice's end
+		{"새 글"},
+		{"내일 글", "publish_at", at(24 * time.Hour)},
+	} {
+		if code, body := write(w[0], w[1:]...); code != 303 {
+			t.Fatalf("%s: %d %s", w[0], code, body)
+		}
+	}
+
+	// The notice on top though older; tomorrow's post not yet.
+	_, body := get(h, BoardDetailURL(b.ID))
+	if n, p := strings.Index(body, "공지"), strings.Index(body, "새 글"); n < 0 || p < 0 || n > p || strings.Contains(body, "내일 글") {
+		t.Errorf("list:\n%s", body)
+	}
+	if _, body := get(h, BoardDetailURL(b.ID)+"?q=글"); !strings.Contains(body, "새 글") || strings.Contains(body, "내일 글") {
+		t.Errorf("search:\n%s", body)
+	}
+}
