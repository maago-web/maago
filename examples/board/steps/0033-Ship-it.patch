 	if err != nil {
 		log.Fatal(err)
@@ -40,10 +56,17 @@ func main() {
 		log.Printf("created %s", u.Email)
 		return
 	}
-	// The links of the mails go to SiteURL, never to the request's Host.
+	// The port to listen on: PORT, as hosts and containers set it.
+	port := cmp.Or(os.Getenv("PORT"), "8000")
+	// The links of the mails go to SiteURL, never to the request's Host,
