+	auth.SiteURL = os.Getenv("BOARD_SITE_URL")
+	if auth.SiteURL == "" {
+		log.Fatal("BOARD_SITE_URL is not set: set it to the site's address, https://board.example.com in production, http://localhost:" + port + " in development")
+	}
 	authlib.Mail = authlib.ConsoleMail
 	// Where to announce published posts. Settings of the app are the app's own
 	// package variables, filled in here.
@@ -80,6 +103,10 @@ func main() {
 	}
 	// StripPrefix takes /app off the path before the routes see it. A proxy
 	// in front that takes it off already gets h alone.
-	log.Print("listening on http://localhost:8000/app/")
-	log.Fatal(http.ListenAndServe(":8000", http.StripPrefix("/app", h)))
+	log.Printf("listening on http://localhost:%s/app/", port)
+	// Serve stops on SIGTERM, as a platform stops a container: it takes no
+	// new connections and lets the running requests finish, for up to 30s.
+	if err := maago.Serve(ctx, ":"+port, http.StripPrefix("/app", h)); err != nil {
+		log.Fatal(err)
+	}
 }
