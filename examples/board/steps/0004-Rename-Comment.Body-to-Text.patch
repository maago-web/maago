From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maago <maago@example.com>
Date: Mon, 28 Sep 2026 22:15:09 +0900
Subject: [PATCH] Rename Comment.Body to Text
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Rename a field: Comment.Body becomes Comment.Text.

Run makemigrations as usual and maago cannot tell a rename, so its draft
drops body and adds text, with a ⚠ note. For a rename, delete that file
and say what changed:

    maago makemigrations --rename board_comment.body:text

Out comes one RENAME COLUMN, which keeps the values.

diff --git a/board/board_test.go b/board/board_test.go
index c6ad329..153dcfb 100644
--- a/board/board_test.go
+++ b/board/board_test.go
@@ -68,3 +68,27 @@ func TestPostConstraints(t *testing.T) {
 		t.Error("a post on a board that does not exist")
 	}
 }
+
+// A comment keeps its post: the post cannot go while it has comments.
+func TestComment(t *testing.T) {
+	db := maagotest.DB(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "질문"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "물어봅니다"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := InsertComment(ctx, db, NewCommentInput{PostID: p.ID, Text: "답입니다"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, err := GetComment(ctx, db, c.ID); err != nil || got.Text != "답입니다" {
+		t.Errorf("got %+v, %v", got, err)
+	}
+	if err := DeletePost(ctx, db, p.ID); err == nil {
+		t.Error("deleted a post that has a comment")
+	}
+}
diff --git a/board/models.go b/board/models.go
index f873463..b975ced 100644
--- a/board/models.go
+++ b/board/models.go
@@ -33,6 +33,6 @@ type Comment struct {
 
 	ID        int64
 	PostID    int64 `maago:"fk=Post"`
-	Body      string
+	Text      string
 	CreatedAt time.Time `maago:"auto=create"`
 }
diff --git a/migrations/0003_rename_board_comment_body.sql b/migrations/0003_rename_board_comment_body.sql
new file mode 100644
index 0000000..dfc4c65
--- /dev/null
+++ b/migrations/0003_rename_board_comment_body.sql
@@ -0,0 +1 @@
+ALTER TABLE "board_comment" RENAME COLUMN "body" TO "text";
