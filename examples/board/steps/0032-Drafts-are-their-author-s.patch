+// APIPublish publishes a draft for a frontend, and returns it: what
+// APICreatePost writes is a draft too.
+func APIPublish(ctx context.Context, tx maago.Tx, in PostIn) (Post, error) {
+	return moveTo(ctx, tx, in.ID, "published")
+}
+
+// maySee hides, as not found, a post that is not out from whoever may not
+// change it: a draft, or one to publish later. A hidden post is not found
+// at all. Not found, not forbidden: a post not out does not say it is
+// there.
+func maySee(ctx context.Context, p Post) error {
+	switch {
+	case p.Hidden:
+		return sql.ErrNoRows
+	case p.Status == "draft" || p.PublishAt != nil && p.PublishAt.After(time.Now()):
+		if mayChange(ctx, p) != nil {
+			return sql.ErrNoRows
+		}
+	}
+	return nil
+}
+
 // mayChange refuses with 403 whoever neither wrote p nor is staff. A post
 // from before there were accounts has no author: staff change it.
 func mayChange(ctx context.Context, p Post) error {
