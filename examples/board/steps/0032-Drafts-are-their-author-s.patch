+// A draft, or a post to publish later, is not out: its author and staff
+// see it, and to anyone else it is not there. No list has it, whoever
+// asks: its author finds it on /me.
+func TestDrafts(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	asAnn, ann := signedIn(t, h, db, "ann@example.com")
+	asBob, _ := signedIn(t, h, db, "bob@example.com")
+	boss, err := auth.CreateSuperuser(ctx, db, "boss@example.com", password)
+	if err != nil {
+		t.Fatal(err)
+	}
+	asBoss := as(h, login(t, h, boss.Email))
+	later := time.Now().Add(time.Hour)
+	var draft, scheduled Post
+	for _, p := range []struct {
+		to *Post
+		in NewPostInput
+	}{
+		{&draft, NewPostInput{BoardID: b.ID, AuthorID: &ann.ID, Title: "앤의 초안", Body: "본문"}},
+		{&scheduled, NewPostInput{BoardID: b.ID, AuthorID: &ann.ID, Title: "앤의 예약 글", Body: "본문", Status: maago.Set("published"), PublishAt: &later}},
+		{nil, NewPostInput{BoardID: b.ID, AuthorID: &ann.ID, Title: "앤의 게시 글", Body: "본문", Status: maago.Set("published")}},
+	} {
+		got, err := InsertPost(ctx, db, p.in)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if p.to != nil {
+			*p.to = got
+		}
+	}
+	var files []Attachment
+	for _, p := range []Post{draft, scheduled} {
+		if w := upload(asAnn, p.ID, "a.txt", []byte("나오지 않은 글의 파일")); w.Code != 303 {
+			t.Fatalf("upload: %d %s", w.Code, w.Body)
+		}
+		as, err := PostAttachments(ctx, db, PostAttachmentsParams{PostID: p.ID})
+		if err != nil || len(as) != 1 {
+			t.Fatalf("%v %v", as, err)
+		}
+		files = append(files, as[0])
+	}
+
+	type who struct {
+		name string
+		h    http.Handler
+	}
+	nobody, bob, annH, staff := who{"nobody", h}, who{"bob", asBob}, who{"ann", asAnn}, who{"staff", asBoss}
+	for _, c := range []struct {
+		who
+		method, path string
+		code         int
+	}{
+		{nobody, "GET", PostDetailURL(draft.ID), 404},
+		{bob, "GET", PostDetailURL(draft.ID), 404},
+		{bob, "GET", PostDetailURL(scheduled.ID), 404},
+		{annH, "GET", PostDetailURL(draft.ID), 200},
+		{annH, "GET", PostDetailURL(scheduled.ID), 200},
+		{staff, "GET", PostDetailURL(scheduled.ID), 200},
+		{nobody, "GET", AttachmentURL(fmt.Sprint(files[0].ID)), 404},
+		{bob, "GET", AttachmentURL(fmt.Sprint(files[0].ID)), 404},
+		{staff, "GET", AttachmentURL(fmt.Sprint(files[0].ID)), 200},
+		{bob, "GET", AttachmentURL(fmt.Sprint(files[1].ID)), 404},
+		{annH, "GET", AttachmentURL(fmt.Sprint(files[1].ID)), 200},
+		{nobody, "POST", CommentCreateURL(draft.ID), 401},
+		{bob, "POST", CommentCreateURL(draft.ID), 404},
+		{annH, "POST", CommentCreateURL(draft.ID), 303},
+	} {
+		var code int
+		if c.method == "GET" {
+			code, _ = get(c.h, c.path)
+		} else {
+			code, _, _ = post(c.h, c.path, url.Values{"text": {c.name + "의 댓글"}})
+		}
+		if code != c.code {
+			t.Errorf("%s %s %s: %d, want %d", c.name, c.method, c.path, code, c.code)
+		}
+	}
+	if cs, err := PostComments(ctx, db, PostCommentsParams{PostID: draft.ID}); err != nil || len(cs) != 1 {
+		t.Errorf("the draft's comments: %v %v", cs, err)
+	}
+
+	// out reports whether body has the published post and neither other.
+	out := func(body string) bool {
+		return strings.Contains(body, "앤의 게시 글") && !strings.Contains(body, "초안") && !strings.Contains(body, "예약")
+	}
+	for _, w := range []who{nobody, annH, staff} {
+		for _, path := range []string{BoardDetailURL(b.ID), BoardDetailURL(b.ID) + "?q=앤", APIPostsURL(b.ID), BoardExportURL(fmt.Sprint(b.ID))} {
+			if code, body := get(w.h, path); code != 200 || !out(body) {
+				t.Errorf("%s GET %s: %d\n%s", w.name, path, code, body)
+			}
+		}
+	}
+
+	// The webhook hears of a post when it is published, not when it is
+	// written: before, its link is not there.
+	heard := make(chan string, 2)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var p struct{ Title string }
+		json.NewDecoder(r.Body).Decode(&p)
+		heard <- p.Title
+	}))
+	defer srv.Close()
+	defer func(w Hook) { Webhook = w }(Webhook)
+	Webhook = Hook{URL: srv.URL}
+	if code, _, _ := post(asAnn, PostCreateURL(b.ID), url.Values{"title": {"새 초안"}, "body": {"본문"}}); code != 303 {
+		t.Fatalf("write: %d", code)
+	}
+	select {
+	case title := <-heard:
+		t.Errorf("heard of %q before it was published", title)
+	case <-time.After(100 * time.Millisecond):
+	}
+	if code, _, _ := post(asAnn, PostPublishURL(draft.ID), nil); code != 303 {
+		t.Fatalf("publish: %d", code)
+	}
+	select {
+	case title := <-heard:
+		if title != "앤의 초안" {
+			t.Errorf("heard of %q", title)
+		}
+	case <-time.After(5 * time.Second):
+		t.Error("the webhook heard nothing of the published post")
+	}
+	if _, body := get(h, BoardDetailURL(b.ID)); !strings.Contains(body, "앤의 초안") {
+		t.Errorf("published, not on the board:\n%s", body)
+	}
+	// Archiving is no news.
+	if code, _, _ := post(asAnn, PostArchiveURL(draft.ID), nil); code != 303 {
+		t.Fatalf("archive: %d", code)
+	}
+	select {
+	case title := <-heard:
+		t.Errorf("heard of %q when it was archived", title)
+	case <-time.After(100 * time.Millisecond):
+	}
+}
