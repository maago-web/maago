diff --git a/board/urls.go b/board/urls.go
index 12c67c9..3f9dfd5 100644
--- a/board/urls.go
+++ b/board/urls.go
@@ -20,8 +20,10 @@ var Routes = maago.Routes{
 	maago.POST("/posts/{id}/delete", "post_delete", RemovePost, maago.LoginRequired),
 	maago.POST("/posts/{id}/attachments", "attachment_add", Attach, maago.LoginRequired),
 	maago.GET("/attachments/{id}", "attachment", DownloadAttachment),
+	maago.GET("/me", "me", Me, maago.LoginRequired),
 
 	// JSON for a frontend on another origin: main trusts it in Config.Origins.
 	maago.GET("/api/boards/{id}/posts", "api_posts", APIPosts, maago.API),
 	maago.POST("/api/boards/{id}/posts", "api_post_create", APICreatePost, maago.API, maago.LoginRequired),
+	maago.GET("/api/me", "api_me", Me, maago.API, maago.LoginRequired),
 }
diff --git a/board/views.go b/board/views.go
index e747f37..2802719 100644
--- a/board/views.go
+++ b/board/views.go
@@ -435,3 +435,18 @@ func deletePost(ctx context.Context, tx maago.Tx, id int64) error {
 	})
 	return nil
 }
+
+type MePage struct {
+	Email string
+	Posts []MyPost
+}
+
+// Me lists the posts of whoever asks, drafts and scheduled ones too: a
+// page in the browser, and JSON with an API token. One view serves both
+// routes; MePage, not auth.User, is what goes out, so the password's hash
+// never does.
+func Me(ctx context.Context, in struct{}) (MePage, error) {
+	u, _ := maago.UserFrom[auth.User](ctx) // the routes require login
+	ps, err := MyPosts(ctx, maago.DBFrom(ctx), MyPostsParams{AuthorID: u.ID})
+	return MePage{Email: u.Email, Posts: ps}, err
+}
diff --git a/board/web_test.go b/board/web_test.go
index dad8cfd..153a6df 100644
--- a/board/web_test.go
+++ b/board/web_test.go
@@ -627,3 +627,70 @@ func TestDeleteWithoutComments(t *testing.T) {
 		t.Errorf("the post is still there: %v", err)
 	}
 }
+
+// Me lists the posts of whoever asks, drafts and scheduled ones too, but
+// not the hidden ones or anybody else's: as a page, and as JSON for a
+// token.
+func TestMe(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	asAnn, ann := signedIn(t, h, db, "ann@example.com")
+	bob := newUser(t, db, "bob@example.com")
+	later := time.Now().Add(time.Hour)
+	for _, p := range []NewPostInput{
+		{BoardID: b.ID, AuthorID: &ann.ID, Title: "앤의 초안", Body: "본문"},
+		{BoardID: b.ID, AuthorID: &ann.ID, Title: "앤의 게시 글", Body: "본문", Status: maago.Set("published")},
+		{BoardID: b.ID, AuthorID: &ann.ID, Title: "앤의 예약 글", Body: "본문", PublishAt: &later},
+		{BoardID: b.ID, AuthorID: &ann.ID, Title: "앤의 숨긴 글", Body: "본문", Hidden: maago.Set(true)},
+		{BoardID: b.ID, AuthorID: &bob.ID, Title: "밥의 글", Body: "본문"},
+	} {
+		if _, err := InsertPost(ctx, db, p); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// lists reports whether body has ann's three posts, the newest first,
+	// and no other.
+	lists := func(body string) bool {
+		last := -1
+		for _, s := range []string{"앤의 예약 글", "앤의 게시 글", "앤의 초안"} {
+			i := strings.Index(body, s)
+			if i <= last {
+				return false
+			}
+			last = i
+		}
+		return !strings.Contains(body, "숨긴") && !strings.Contains(body, "밥의")
+	}
+
+	if code, body := get(asAnn, MeURL()); code != 200 || !lists(body) || !strings.Contains(body, "ann@example.com") {
+		t.Errorf("/me: %d %s", code, body)
+	}
+	if code, _ := get(h, MeURL()); code != 303 {
+		t.Errorf("/me without a sign-in: %d", code)
+	}
+
+	token, hash := authlib.NewToken()
+	if _, err := auth.InsertAPIToken(ctx, db, auth.NewAPITokenInput{UserID: ann.ID, Name: "front", Hash: hash}); err != nil {
+		t.Fatal(err)
+	}
+	// call asks for the API's /me with the Authorization header header.
+	call := func(header string) *httptest.ResponseRecorder {
+		r := httptest.NewRequest("GET", APIMeURL(), nil)
+		if header != "" {
+			r.Header.Set("Authorization", header)
+		}
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		return w
+	}
+	if w := call("Bearer " + token); w.Code != 200 || w.Header().Get("Content-Type") != "application/json" || !lists(w.Body.String()) || !strings.Contains(w.Body.String(), `"Email":"ann@example.com"`) {
+		t.Errorf("/api/me: %d %v %s", w.Code, w.Header(), w.Body)
+	}
+	if w := call(""); w.Code != 401 || w.Header().Get("WWW-Authenticate") != "Bearer" {
+		t.Errorf("/api/me without a token: %d %v", w.Code, w.Header())
+	}
+}
