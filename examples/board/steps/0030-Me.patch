+
+type MePage struct {
+	Email string
+	Posts []MyPost
+}
+
+// Me lists the posts of whoever asks, drafts and scheduled ones too: a
+// page in the browser, and JSON with an API token. One view serves both
+// routes; MePage, not auth.User, is what goes out, so the password's hash
+// never does.
+func Me(ctx context.Context, u auth.User, db maago.DB, in struct{}) (MePage, error) {
+	ps, err := MyPosts(ctx, db, MyPostsParams{AuthorID: u.ID})
+	return MePage{Email: u.Email, Posts: ps}, err
+}
