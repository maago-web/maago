new file mode 100644
index 0000000..50a62e9
--- /dev/null
+++ b/board/attach_test.go
@@ -0,0 +1,145 @@
+package board
+
+import (
+	"bytes"
+	"fmt"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/maago-web/maago"
+	"github.com/maago-web/maago/maagotest"
+)
+
+// upload sends file as the form of attachment_add of post id.
+func upload(h http.Handler, id int64, name string, file []byte) *httptest.ResponseRecorder {
+	var b bytes.Buffer
+	mw := multipart.NewWriter(&b)
+	if name != "" || file != nil {
+		part, _ := mw.CreateFormFile("file", name)
+		part.Write(file)
+	} else { // no file chosen, as a browser sends it
+		part, _ := mw.CreateFormFile("file", "")
+		part.Write(nil)
+	}
+	mw.Close()
+	r := httptest.NewRequest("POST", AttachmentAddURL(id), &b)
+	r.Header.Set("Content-Type", mw.FormDataContentType())
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+
+// Files of a post: its author keeps them with it, whoever may see the post
+// gets them, to download; a draft's only its author and staff, a hidden
+// post's no one. Deleting the post deletes them.
+func TestAttachments(t *testing.T) {
+	db := maagotest.DB(t)
+	cfg := config(t, db)
+	h, err := maago.Handler(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := t.Context()
+	ann, annUser := signedIn(t, h, db, "ann@example.com")
+	bob, _ := signedIn(t, h, db, "bob@example.com")
+	b, _ := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "첨부", Status: maago.Set("published"), AuthorID: &annUser.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	body := []byte("결과표")
+
+	if w := upload(h, p.ID, "a.txt", body); w.Code != 401 {
+		t.Errorf("without a sign-in: %d", w.Code)
+	}
+	if w := upload(bob, p.ID, "a.txt", body); w.Code != 403 {
+		t.Errorf("not its author: %d", w.Code)
+	}
+	if w := upload(ann, p.ID, "", nil); w.Code != 200 || !strings.Contains(w.Body.String(), "This field is required.") {
+		t.Errorf("no file: %d %s", w.Code, w.Body)
+	}
+	if w := upload(ann, p.ID, "../evil.txt", body); w.Code != 303 {
+		t.Fatalf("upload: %d %s", w.Code, w.Body)
+	}
+	as, _ := PostAttachments(ctx, db, PostAttachmentsParams{PostID: p.ID})
+	if len(as) != 1 || as[0].Size != int64(len(body)) {
+		t.Fatalf("rows: %+v", as)
+	}
+	a := as[0]
+	if entries, _ := os.ReadDir(cfg.MediaDir); len(entries) != 1 || entries[0].Name() != a.Key {
+		t.Errorf("the media directory: %v", entries)
+	}
+	if code, page := get(h, PostDetailURL(p.ID)); code != 200 || !strings.Contains(page, `href="`+AttachmentURL(fmt.Sprint(a.ID))+`"`) {
+		t.Errorf("the post: %d %s", code, page)
+	}
+
+	// Anyone gets a published post's file, to download.
+	r := httptest.NewRequest("GET", AttachmentURL(fmt.Sprint(a.ID)), nil)
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	if w.Code != 200 || w.Body.String() != string(body) || !strings.HasPrefix(w.Header().Get("Content-Disposition"), "attachment") {
+		t.Errorf("download: %d %v", w.Code, w.Header())
+	}
+	if code, _ := get(h, AttachmentURL(fmt.Sprint(a.ID+1))); code != 404 {
+		t.Errorf("no attachment: %d", code)
+	}
+	if w := upload(ann, p.ID, "big.bin", make([]byte, 10<<20+1)); w.Code != 413 {
+		t.Errorf("past 10MB: %d", w.Code)
+	}
+
+	// A draft's files: its author and staff only (M7's condition 6).
+	p.Status = "draft"
+	if err := UpdatePost(ctx, db, &p); err != nil {
+		t.Fatal(err)
+	}
+	for who, c := range map[string]struct {
+		h    http.Handler
+		code int
+	}{"no one signed in": {h, 403}, "bob": {bob, 403}, "ann": {ann, 200}} {
+		if code, _ := get(c.h, AttachmentURL(fmt.Sprint(a.ID))); code != c.code {
+			t.Errorf("a draft's file to %s: %d, want %d", who, code, c.code)
+		}
+	}
+
+	// Deleting a post without comments deletes its files.
+	if code, _, _ := post(ann, PostDeleteURL(p.ID), nil); code != 303 {
+		t.Fatalf("delete: %d", code)
+	}
+	if as, _ := PostAttachments(ctx, db, PostAttachmentsParams{PostID: p.ID}); len(as) != 0 {
+		t.Errorf("rows left: %+v", as)
+	}
+	if entries, _ := os.ReadDir(cfg.MediaDir); len(entries) != 0 {
+		t.Errorf("files left: %v", entries)
+	}
+}
+
+// A post with comments is hidden, not deleted: its files stay, and no one
+// gets them, nor adds more.
+func TestHiddenAttachments(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	ann, annUser := signedIn(t, h, db, "ann@example.com")
+	b, _ := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	p, _ := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "첨부", Status: maago.Set("published"), AuthorID: &annUser.ID})
+	if w := upload(ann, p.ID, "a.txt", []byte("x")); w.Code != 303 {
+		t.Fatalf("upload: %d", w.Code)
+	}
+	InsertComment(ctx, db, NewCommentInput{PostID: p.ID, Text: "댓글"})
+	if code, _, _ := post(ann, PostDeleteURL(p.ID), nil); code != 303 {
+		t.Fatalf("delete: %d", code)
+	}
+	as, _ := PostAttachments(ctx, db, PostAttachmentsParams{PostID: p.ID})
+	if len(as) != 1 {
+		t.Fatalf("rows: %+v", as)
+	}
+	if code, _ := get(ann, AttachmentURL(fmt.Sprint(as[0].ID))); code != 404 {
+		t.Errorf("a hidden post's file: %d", code)
+	}
+	if w := upload(ann, p.ID, "b.txt", []byte("x")); w.Code != 404 {
+		t.Errorf("a file to a hidden post: %d", w.Code)
+	}
+}
