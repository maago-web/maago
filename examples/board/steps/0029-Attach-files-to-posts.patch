--- /dev/null
+++ b/board/queries/post_attachments.sql
@@ -0,0 +1,7 @@
+-- name: PostAttachments :many Attachment
+-- The files of a post, in the order they came.
+-- param: post_id int64
+SELECT id, post_id, key, name, type, size, created_at
+FROM board_attachment
+WHERE post_id = :post_id
+ORDER BY id
