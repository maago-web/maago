 	if len(cs) == 0 {
-		err = DeletePost(ctx, db, p.ID)
+		err = deletePost(ctx, p.ID)
 	} else {
 		p.Hidden = true
 		err = UpdatePost(ctx, db, &p)
@@ -314,3 +397,28 @@ func mayChange(ctx context.Context, p Post) error {
 	}
 	return maago.Status(http.StatusForbidden, errors.New("only its author or staff may change a post"))
 }
+
+// deletePost deletes a post and its attachments: their rows first, which
+// point at the post, then their files. A file that will not go is logged
+// and left: the post is gone already, and a second try would find nothing.
+func deletePost(ctx context.Context, id int64) error {
+	db := maago.DBFrom(ctx)
+	as, err := PostAttachments(ctx, db, PostAttachmentsParams{PostID: id})
+	if err != nil {
+		return err
+	}
+	for _, a := range as {
+		if err := DeleteAttachment(ctx, db, a.ID); err != nil {
+			return err
+		}
+	}
+	if err := DeletePost(ctx, db, id); err != nil {
+		return err
+	}
+	for _, a := range as {
+		if err := maago.DeleteMedia(ctx, a.Key); err != nil {
+			log.Printf("post %d: the file of attachment %d stays: %v", id, a.ID, err)
+		}
+	}
+	return nil
+}
