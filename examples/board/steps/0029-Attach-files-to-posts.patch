 	if len(cs) == 0 {
-		err = DeletePost(ctx, tx, p.ID)
+		err = deletePost(ctx, tx, p.ID)
 	} else {
 		p.Hidden = true
 		err = UpdatePost(ctx, tx, &p)
@@ -325,3 +405,31 @@ func mayChange(u auth.User, p Post) error {
 	}
 	return maago.Status(http.StatusForbidden, errors.New("only its author or staff may change a post"))
 }
+
+// deletePost deletes a post and its attachments: their rows first, which
+// point at the post, then their files, once the rows are gone for good
+// (maago.AfterCommit): a rollback keeps the rows, and so their files. A
+// file that will not go is logged and left: the post is gone already, and
+// a second try would find nothing.
+func deletePost(ctx context.Context, tx maago.Tx, id int64) error {
+	as, err := PostAttachments(ctx, tx, PostAttachmentsParams{PostID: id})
+	if err != nil {
+		return err
+	}
+	for _, a := range as {
+		if err := DeleteAttachment(ctx, tx, a.ID); err != nil {
+			return err
+		}
+	}
+	if err := DeletePost(ctx, tx, id); err != nil {
+		return err
+	}
+	maago.AfterCommit(ctx, func(ctx context.Context) {
+		for _, a := range as {
+			if err := maago.DeleteMedia(ctx, a.Key); err != nil {
+				log.Printf("post %d: the file of attachment %d stays: %v", id, a.ID, err)
+			}
+		}
+	})
+	return nil
+}
