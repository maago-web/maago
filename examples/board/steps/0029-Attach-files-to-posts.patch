index 5f00642..d6143a3 100644
--- a/board/models.go
+++ b/board/models.go
@@ -48,6 +48,26 @@ type Comment struct {
 	CreatedAt time.Time `maago:"auto=create"`
 }
 
+// Attachment is a file kept with a post: what maago.SaveMedia returns,
+// field by field, and when it came. The file itself is in the media
+// directory under Key.
+type Attachment struct {
+	maago.Model `maago:"admin_list=(PostID,Name,Type,Size,CreatedAt),admin_search=(Name)"`
+
+	ID        int64
+	PostID    int64  `maago:"fk=Post"`
+	Key       string `maago:"unique"`
+	Name      string
+	Type      string
+	Size      int64
+	CreatedAt time.Time `maago:"auto=create"`
+}
+
+// media is the attachment's file, as maago.ServeMedia takes it.
+func (a Attachment) media() maago.Media {
+	return maago.Media{Key: a.Key, Name: a.Name, Type: a.Type, Size: a.Size}
+}
+
 // next is where a post of each status may go: draft, then published, then
 // archived, one way.
 var next = map[string]string{"draft": "published", "published": "archived"}
diff --git a/board/queries/post_attachments.sql b/board/queries/post_attachments.sql
new file mode 100644
