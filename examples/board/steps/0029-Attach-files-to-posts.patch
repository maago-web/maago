+type AttachIn struct {
+	ID   int64          `maago:"path=id"`
+	Form AttachmentForm `maago:"form"`
+}
+
+// Attach keeps a file with a post, for its author or staff. The page is
+// the post's, so a form with an error draws again where it was sent from.
+// The file is saved inside the request's transaction, which holds the
+// write lock of SQLite meanwhile. A row that fails takes its file with it;
+// a commit that fails leaves the file behind, with no row.
+func Attach(ctx context.Context, u auth.User, tx maago.Tx, in AttachIn) (maago.Result[PostPage], error) {
+	post, err := GetPost(ctx, tx, in.ID)
+	switch {
+	case err != nil:
+		return maago.Result[PostPage]{}, err
+	case post.Hidden:
+		return maago.Result[PostPage]{}, sql.ErrNoRows
+	}
+	if err := mayChange(u, post); err != nil {
+		return maago.Result[PostPage]{}, err
+	}
+	if in.Form.Valid() {
+		m, err := maago.SaveMedia(ctx, in.Form.File.Value)
+		if err != nil {
+			return maago.Result[PostPage]{}, err
+		}
+		if _, err := InsertAttachment(ctx, tx, NewAttachmentInput{PostID: post.ID, Key: m.Key, Name: m.Name, Type: m.Type, Size: m.Size}); err != nil {
+			maago.DeleteMedia(ctx, m.Key) // no row points at it: it would stay for nothing
+			return maago.Result[PostPage]{}, err
+		}
+		return maago.SeeOther[PostPage](PostDetailURL(post.ID)), nil
+	}
+	page, err := postPage(ctx, tx, post.ID, CommentForm{})
+	page.AttachForm = in.Form
+	return maago.Show(page), err
+}
+
+// DownloadAttachment sends an attachment down, to whoever may see its
+// post: none of a hidden post, and of a draft only to its author and
+// staff. The view checks it: no route serves the media directory as it is.
+func DownloadAttachment(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	db := maago.DBFrom(ctx)
+	id, err := strconv.ParseInt(r.PathValue("id"), 10, 64)
+	if err != nil {
+		http.NotFound(w, r)
+		return
+	}
+	a, err := GetAttachment(ctx, db, id)
+	var post Post
+	if err == nil {
+		post, err = GetPost(ctx, db, a.PostID)
+	}
+	switch {
+	case errors.Is(err, sql.ErrNoRows) || err == nil && post.Hidden:
+		http.NotFound(w, r)
+		return
+	case err != nil:
+		panic(err) // nothing is written yet: a 500, and Config.OnError hears it
+	}
+	if post.Status == "draft" {
+		// An escape view takes no parameters: it reads the user, as the
+		// database, from the request.
+		u, _ := maago.UserFrom[auth.User](ctx)
+		if err := mayChange(u, post); err != nil {
+			http.Error(w, http.StatusText(http.StatusForbidden), http.StatusForbidden)
+			return
+		}
+	}
+	maago.ServeMedia(w, r, a.media())
 }
 
 // RemovePost deletes a post. One without comments goes from the database;
@@ -132,7 +212,7 @@ func RemovePost(ctx context.Context, u auth.User, tx maago.Tx, in PostIn) (maago
 		return maago.Result[PostPage]{}, err
