From: Maago <maago@example.com>
Date: Mon, 28 Sep 2026 22:15:54 +0900
Subject: [PATCH] Add post queries

Write SQL. One query to a file, in board/queries/.

- post_list.sql: the posts of a board, newest first, a page at a time
  with LIMIT and OFFSET
- post_detail.sql: one post and the name of its board (a JOIN), or
  sql.ErrNoRows
- search_posts.sql: search a board. q? is a parameter that may be
  missing, and a line that starts with {q} goes into the SQL only when q
  is given

The -- name: line at the top of a file names the Go function and its
result type. A result that is not a model makes a new type
(PostSummary, PostWithBoard); a column that selects a model's column as
it is takes that field's type. An expression such as count(*) has no
type to take, so -- column: declares it. Two queries that use the same
result name must have the same shape.

maago gen prepares the SQL of every combination of the optional lines
on a practice database before it writes board/queries_gen.go.

diff --git a/board/queries/post_detail.sql b/board/queries/post_detail.sql
new file mode 100644
index 0000000..12da43e
--- /dev/null
+++ b/board/queries/post_detail.sql
@@ -0,0 +1,7 @@
+-- name: PostDetail :one PostWithBoard
+-- One post with the name of its board.
+-- param: id int64
+SELECT p.id, p.title, p.body, p.status, p.views, p.created_at, b.name AS board_name
+FROM board_post p
+JOIN board_board b ON b.id = p.board_id
+WHERE p.id = :id
diff --git a/board/queries/post_list.sql b/board/queries/post_list.sql
new file mode 100644
index 0000000..eec1a64
--- /dev/null
+++ b/board/queries/post_list.sql
@@ -0,0 +1,12 @@
+-- name: PostList :many PostSummary
+-- The posts of a board, newest first, one page at a time.
+-- param: board_id int64
+-- param: limit    int64
+-- param: offset   int64
+-- column: comments int64
+SELECT p.id, p.title, p.created_at,
+       (SELECT count(*) FROM board_comment c WHERE c.post_id = p.id) AS comments
+FROM board_post p
+WHERE p.board_id = :board_id
+ORDER BY p.created_at DESC, p.id DESC
+LIMIT :limit OFFSET :offset
diff --git a/board/queries/search_posts.sql b/board/queries/search_posts.sql
new file mode 100644
index 0000000..fecea2e
--- /dev/null
+++ b/board/queries/search_posts.sql
@@ -0,0 +1,13 @@
+-- name: SearchPosts :many PostSummary
+-- The posts of a board whose title has q; all of them without q.
+-- param: board_id int64
+-- param: q?       string
+-- param: limit    int64
+-- column: comments int64
+SELECT p.id, p.title, p.created_at,
+       (SELECT count(*) FROM board_comment c WHERE c.post_id = p.id) AS comments
+FROM board_post p
+WHERE p.board_id = :board_id
+  {q} AND p.title LIKE '%' || :q || '%'
+ORDER BY p.created_at DESC, p.id DESC
+LIMIT :limit
diff --git a/board/queries_test.go b/board/queries_test.go
new file mode 100644
index 0000000..4668f9a
--- /dev/null
+++ b/board/queries_test.go
@@ -0,0 +1,88 @@
+package board
+
+import (
+	"database/sql"
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/maago-web/maago"
+	"github.com/maago-web/maago/maagotest"
+)
+
+// titles are the titles of the posts, in order.
+func titles(ps []PostSummary) []string {
+	var ts []string
+	for _, p := range ps {
+		ts = append(ts, p.Title)
+	}
+	return ts
+}
+
+func TestPostQueries(t *testing.T) {
+	db := maagotest.DB(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "목록"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	other, err := InsertBoard(ctx, db, NewBoardInput{Name: "다른 게시판"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ids []int64
+	for i := 1; i <= 5; i++ {
+		p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: fmt.Sprintf("글 %d", i), Body: "본문"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, p.ID)
+	}
+	if _, err := InsertPost(ctx, db, NewPostInput{BoardID: other.ID, Title: "글 9"}); err != nil {
+		t.Fatal(err)
+	}
+	for range 2 {
+		if _, err := InsertComment(ctx, db, NewCommentInput{PostID: ids[4], Text: "댓글"}); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	// Pages: newest first, and the last page is short.
+	for _, c := range []struct {
+		offset int64
+		want   string
+	}{{0, "[글 5 글 4]"}, {2, "[글 3 글 2]"}, {4, "[글 1]"}, {6, "[]"}} {
+		ps, err := PostList(ctx, db, PostListParams{BoardID: b.ID, Limit: 2, Offset: c.offset})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := fmt.Sprint(titles(ps)); got != c.want {
+			t.Errorf("offset %d: %s, want %s", c.offset, got, c.want)
+		}
+		if c.offset == 0 && ps[0].Comments != 2 {
+			t.Errorf("글 5 has %d comments, want 2", ps[0].Comments)
+		}
+	}
+
+	// Search: with q only the matches, without it every post of the board.
+	for _, c := range []struct {
+		q    *string
+		want string
+	}{{maago.Ptr("3"), "[글 3]"}, {maago.Ptr("없음"), "[]"}, {nil, "[글 5 글 4 글 3 글 2 글 1]"}} {
+		ps, err := SearchPosts(ctx, db, SearchPostsParams{BoardID: b.ID, Q: c.q, Limit: 10})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := fmt.Sprint(titles(ps)); got != c.want {
+			t.Errorf("q %v: %s, want %s", c.q, got, c.want)
+		}
+	}
+
+	page, err := PostDetail(ctx, db, PostDetailParams{ID: ids[0]})
+	if err != nil || page.Title != "글 1" || page.BoardName != "목록" || page.Status != "draft" {
+		t.Errorf("got %+v, %v", page, err)
+	}
+	if _, err := PostDetail(ctx, db, PostDetailParams{ID: -1}); !errors.Is(err, sql.ErrNoRows) {
+		t.Errorf("a post that does not exist: %v", err)
+	}
+}
