Content-Transfer-Encoding: 8bit

SQL을 쓴다. 쿼리 하나에 파일 하나, board/queries/에.

- post_list.sql: 게시판의 글 목록, 최신 순, LIMIT·OFFSET으로 한 쪽씩
- post_detail.sql: 글 하나와 게시판 이름(JOIN), 없으면 sql.ErrNoRows
- search_posts.sql: 게시판별 검색. q?는 없어도 되는 파라미터이고,
  {q}로 시작하는 줄은 q가 있을 때만 SQL에 들어간다

파일 머리의 -- name: 줄이 Go 함수 이름과 결과 타입을 정한다. 결과가 모델이
아니면 새 타입(PostSummary, PostWithBoard)이 생기고, 모델 컬럼을 그대로 고른
컬럼은 그 필드의 타입을 쓴다. count(*) 같은 식은 타입을 알 수 없으므로
-- column:으로 적는다. 두 쿼리가 같은 결과 이름을 쓰면 모양도 같아야 한다.

maago gen은 조건 줄의 조합마다 SQL을 연습용 DB에 prepare해 본 뒤에
board/queries_gen.go를 쓴다.

diff --git a/board/queries/post_detail.sql b/board/queries/post_detail.sql
new file mode 100644
index 0000000..12da43e
--- /dev/null
+++ b/board/queries/post_detail.sql
@@ -0,0 +1,7 @@
+-- name: PostDetail :one PostWithBoard
+-- One post with the name of its board.
+-- param: id int64
+SELECT p.id, p.title, p.body, p.status, p.views, p.created_at, b.name AS board_name
+FROM board_post p
+JOIN board_board b ON b.id = p.board_id
+WHERE p.id = :id
diff --git a/board/queries/post_list.sql b/board/queries/post_list.sql
new file mode 100644
index 0000000..eec1a64
--- /dev/null
+++ b/board/queries/post_list.sql
@@ -0,0 +1,12 @@
+-- name: PostList :many PostSummary
+-- The posts of a board, newest first, one page at a time.
+-- param: board_id int64
+-- param: limit    int64
+-- param: offset   int64
+-- column: comments int64
+SELECT p.id, p.title, p.created_at,
+       (SELECT count(*) FROM board_comment c WHERE c.post_id = p.id) AS comments
+FROM board_post p
+WHERE p.board_id = :board_id
+ORDER BY p.created_at DESC, p.id DESC
+LIMIT :limit OFFSET :offset
diff --git a/board/queries/search_posts.sql b/board/queries/search_posts.sql
new file mode 100644
index 0000000..fecea2e
--- /dev/null
+++ b/board/queries/search_posts.sql
@@ -0,0 +1,13 @@
+-- name: SearchPosts :many PostSummary
+-- The posts of a board whose title has q; all of them without q.
+-- param: board_id int64
+-- param: q?       string
+-- param: limit    int64
+-- column: comments int64
+SELECT p.id, p.title, p.created_at,
+       (SELECT count(*) FROM board_comment c WHERE c.post_id = p.id) AS comments
+FROM board_post p
+WHERE p.board_id = :board_id
+  {q} AND p.title LIKE '%' || :q || '%'
+ORDER BY p.created_at DESC, p.id DESC
+LIMIT :limit
diff --git a/board/queries_test.go b/board/queries_test.go
new file mode 100644
index 0000000..5ba8478
--- /dev/null
+++ b/board/queries_test.go
@@ -0,0 +1,86 @@
+package board
+
+import (
+	"database/sql"
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/maago-web/maago"
+)
+
+// titles are the titles of the posts, in order.
+func titles(ps []PostSummary) []string {
+	var ts []string
+	for _, p := range ps {
+		ts = append(ts, p.Title)
+	}
+	return ts
+}
+
+func TestPostQueries(t *testing.T) {
+	ctx, tx := tx(t)
+	b, err := InsertBoard(ctx, tx, NewBoardInput{Name: "목록"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	other, err := InsertBoard(ctx, tx, NewBoardInput{Name: "다른 게시판"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ids []int64
+	for i := 1; i <= 5; i++ {
+		p, err := InsertPost(ctx, tx, NewPostInput{BoardID: b.ID, Title: fmt.Sprintf("글 %d", i), Body: "본문"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, p.ID)
+	}
+	if _, err := InsertPost(ctx, tx, NewPostInput{BoardID: other.ID, Title: "글 9"}); err != nil {
+		t.Fatal(err)
+	}
+	for range 2 {
+		if _, err := InsertComment(ctx, tx, NewCommentInput{PostID: ids[4], Text: "댓글"}); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	// Pages: newest first, and the last page is short.
+	for _, c := range []struct {
+		offset int64
+		want   string
+	}{{0, "[글 5 글 4]"}, {2, "[글 3 글 2]"}, {4, "[글 1]"}, {6, "[]"}} {
+		ps, err := PostList(ctx, tx, PostListParams{BoardID: b.ID, Limit: 2, Offset: c.offset})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := fmt.Sprint(titles(ps)); got != c.want {
+			t.Errorf("offset %d: %s, want %s", c.offset, got, c.want)
+		}
+		if c.offset == 0 && ps[0].Comments != 2 {
+			t.Errorf("글 5 has %d comments, want 2", ps[0].Comments)
+		}
+	}
+
+	// Search: with q only the matches, without it every post of the board.
+	for _, c := range []struct {
+		q    *string
+		want string
+	}{{maago.Ptr("3"), "[글 3]"}, {maago.Ptr("없음"), "[]"}, {nil, "[글 5 글 4 글 3 글 2 글 1]"}} {
+		ps, err := SearchPosts(ctx, tx, SearchPostsParams{BoardID: b.ID, Q: c.q, Limit: 10})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := fmt.Sprint(titles(ps)); got != c.want {
+			t.Errorf("q %v: %s, want %s", c.q, got, c.want)
+		}
+	}
+
+	page, err := PostDetail(ctx, tx, PostDetailParams{ID: ids[0]})
+	if err != nil || page.Title != "글 1" || page.BoardName != "목록" || page.Status != "draft" {
+		t.Errorf("got %+v, %v", page, err)
+	}
+	if _, err := PostDetail(ctx, tx, PostDetailParams{ID: -1}); !errors.Is(err, sql.ErrNoRows) {
+		t.Errorf("a post that does not exist: %v", err)
+	}
+}
