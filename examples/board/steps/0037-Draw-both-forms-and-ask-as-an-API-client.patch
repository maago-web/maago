-// and the comment form f, if u may read it (policy visible): a post u may
-// not read is not found.
+// the comment form f and an empty attachment form, if u may read it
+// (policy visible): a post u may not read is not found.
 func postPage(ctx context.Context, db maago.DB, u *auth.User, id int64, f CommentForm) (PostPage, error) {
 	p, err := PostDetail(ctx, u, db, PostDetailParams{ID: id, Now: time.Now()})
 	if err != nil {
 		return PostPage{}, err
 	}
-	page := PostPage{Post: p, Form: f}
+	page := PostPage{Post: p, Form: f, AttachForm: NewAttachmentForm()}
 	if page.Comments, err = PostComments(ctx, db, PostCommentsParams{PostID: p.ID}); err != nil {
 		return PostPage{}, err
 	}
@@ -155,7 +155,7 @@ func Attach(ctx context.Context, u auth.User, tx maago.Tx, in AttachIn) (maago.R
 		}
 		return maago.SeeOther[PostPage](PostDetailURL(post.ID)), nil
 	}
-	page, err := postPage(ctx, tx, &u, post.ID, CommentForm{})
+	page, err := postPage(ctx, tx, &u, post.ID, NewCommentForm())
 	page.AttachForm = in.Form
 	return maago.Show(page), err
 }
