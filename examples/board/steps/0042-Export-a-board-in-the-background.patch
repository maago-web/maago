+
+// deliver is the outbox's worker's handle: each job by its kind, with the
+// media store in its context, which maago.SaveMediaFrom finds there. A
+// kind it does not know is an error: the job stays, and shows in the
+// admin with it.
+func deliver(db maago.DB, media maago.MediaStore) func(context.Context, outbox.Job) error {
+	return func(ctx context.Context, j outbox.Job) error {
+		ctx = maago.WithMedia(ctx, media)
+		switch j.Kind {
+		case board.PostPublished:
+			return board.Deliver(ctx, j)
+		case board.ExportFiles:
+			return board.WriteExportFiles(ctx, db, j)
+		}
+		return fmt.Errorf("no job of kind %q", j.Kind)
+	}
+}
