From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maago <maago@example.com>
Date: Wed, 25 Nov 2026 01:23:29 +0900
Subject: [PATCH] Export a board in the background

Staff asks for a board's files: a Markdown file for each post, and an
index. Writing them is the outbox's worker's, not the request's: a long
board takes a while, and a job that fails goes again.

    maago makemigrations --name export_files

- A model ExportFile (table board_export_file): a file of a board's
  latest export, by name, unique on (BoardID, Name). Its Key is tagged
  media, as the attachments' is: what a row keeps, the sweep keeps
- A second kind of job, ExportFiles, "export_files". postPublished is
  PostPublished now: main tells the kinds apart, so both are exported,
  and Deliver, the webhook's, no longer asks the kind.
  The handle is main's deliver(db, media): it puts the store in the
  job's context, maago.WithMedia(ctx, media), where maago.SaveMediaFrom
  finds it, and goes by the job's Kind. A kind it does not know is an
  error: the job stays, and the admin shows it
- WriteExportFiles reads the posts out to everybody, whoever asked: the
  files go out of the site, and a draft must not. It keeps each file
  with maago.SaveMediaFrom first, then, in one transaction, deletes the
  board's rows and writes the new ones. No code deletes a file: the
  export before, a run that stopped halfway, and a run again past its
  lease leave files no row keeps, and the sweep deletes them
- Routes, staff only, under /boards/{id}/files: board_files lists the
  files with a button to export again, board_files_export writes the
  job, {"id": the board's ID}, in the request's transaction, board_file
  (/{name}) sends a file down by its name, with maago.ServeMedia, as
  the attachments go

TestWriteExportFiles runs a job twice, a post a page (exportPage = 1),
makes the files two days old and sweeps: the store holds the rows'
files, post-ID.md for each post and index.md, and they read as they
should; the draft is in none. TestFiles asks as staff, runs the job
with outbox.RunOnce and a handle of its own that goes by the kind
(main's deliver is in package main, out of a board test's reach), and
gets index.md by its name. TestPermissions has the three routes' rows.

diff --git a/board/files.go b/board/files.go
new file mode 100644
index 0000000..677fa0a
--- /dev/null
+++ b/board/files.go
@@ -0,0 +1,142 @@
+package board
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/maago-web/maago"
+
+	"example.com/board/auth"
+	"example.com/board/outbox"
+)
+
+// ExportFiles is the kind of the outbox's jobs that write a board's files.
+const ExportFiles = "export_files"
+
+// WriteExportFiles writes the files of the board of job j: a post-ID.md
+// for each post out to everybody, and index.md, which lists them. Out to
+// everybody, whoever asked: the files go out by URL. It keeps the files
+// first, then swaps the board's rows for theirs in one transaction. The
+// files of the export before, and of a run that stopped halfway, no row
+// keeps: the sweep deletes them.
+func WriteExportFiles(ctx context.Context, db maago.DB, j outbox.Job) error {
+	var in struct{ ID int64 }
+	if err := json.Unmarshal([]byte(j.Payload), &in); err != nil {
+		return err
+	}
+	b, err := GetBoard(ctx, db, in.ID)
+	if err != nil {
+		return err
+	}
+	now := time.Now()
+	var files []maago.Media
+	var index strings.Builder
+	fmt.Fprintf(&index, "# %s\n\n", b.Name)
+	var after int64
+	for {
+		rows, err := ExportRows(ctx, nil, db, ExportRowsParams{BoardID: b.ID, Now: now, After: after, Limit: exportPage})
+		if err != nil {
+			return err
+		}
+		for _, r := range rows {
+			p, err := GetPost(ctx, nil, db, r.ID, now)
+			if err != nil {
+				return err
+			}
+			name := fmt.Sprintf("post-%d.md", p.ID)
+			m, err := maago.SaveMediaFrom(ctx, name, strings.NewReader("# "+p.Title+"\n\n"+p.Body+"\n"))
+			if err != nil {
+				return err
+			}
+			files = append(files, m)
+			fmt.Fprintf(&index, "- [%s](%s)\n", p.Title, name)
+		}
+		if int64(len(rows)) < exportPage {
+			break
+		}
+		after = rows[len(rows)-1].ID
+	}
+	m, err := maago.SaveMediaFrom(ctx, "index.md", strings.NewReader(index.String()))
+	if err != nil {
+		return err
+	}
+	files = append(files, m)
+	return maago.WithTx(ctx, db, func(ctx context.Context, tx maago.Tx) error {
+		if _, err := DeleteBoardFiles(ctx, tx, DeleteBoardFilesParams{BoardID: b.ID}); err != nil {
+			return err
+		}
+		for _, m := range files {
+			if _, err := InsertExportFile(ctx, tx, NewExportFileInput{BoardID: b.ID, Name: m.Name, Key: m.Key, Type: m.Type, Size: m.Size}); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+}
+
+type FilesIn struct {
+	ID int64 `maago:"path=id"`
+}
+
+type FilesPage struct {
+	Board Board
+	Files []ExportFile
+}
+
+// ShowFiles lists a board's files, to staff.
+func ShowFiles(ctx context.Context, u auth.User, db maago.DB, in FilesIn) (FilesPage, error) {
+	if err := staffOnly(u); err != nil {
+		return FilesPage{}, err
+	}
+	b, err := GetBoard(ctx, db, in.ID)
+	if err != nil {
+		return FilesPage{}, err
+	}
+	fs, err := BoardFiles(ctx, db, BoardFilesParams{BoardID: b.ID})
+	return FilesPage{Board: b, Files: fs}, err
+}
+
+// ExportFilesAgain asks the outbox's worker for the board's files, in
+// the request's transaction: they are there once the job has run.
+func ExportFilesAgain(ctx context.Context, u auth.User, tx maago.Tx, in FilesIn) (maago.Result[FilesPage], error) {
+	if err := staffOnly(u); err != nil {
+		return maago.Result[FilesPage]{}, err
+	}
+	if _, err := GetBoard(ctx, tx, in.ID); err != nil {
+		return maago.Result[FilesPage]{}, err
+	}
+	if _, err := outbox.Enqueue(ctx, tx, ExportFiles, map[string]any{"id": in.ID}); err != nil {
+		return maago.Result[FilesPage]{}, err
+	}
+	return maago.SeeOther[FilesPage](BoardFilesURL(in.ID)), nil
+}
+
+type FileIn struct {
+	ID   int64  `maago:"path=id"`
+	Name string `maago:"path=name"`
+}
+
+// DownloadFile sends a board's file down by its name, to staff.
+func DownloadFile(ctx context.Context, u auth.User, db maago.DB, in FileIn, w http.ResponseWriter, r *http.Request) error {
+	if err := staffOnly(u); err != nil {
+		return err
+	}
+	f, err := BoardFile(ctx, db, BoardFileParams{BoardID: in.ID, Name: in.Name})
+	if err != nil {
+		return err
+	}
+	return maago.ServeMedia(w, r, f.media())
+}
+
+// staffOnly refuses with 403 whoever is not staff.
+func staffOnly(u auth.User) error {
+	if !u.IsStaff {
+		return maago.Status(http.StatusForbidden, errors.New("only staff get a board's files"))
+	}
+	return nil
+}
diff --git a/board/files_test.go b/board/files_test.go
new file mode 100644
index 0000000..936aa8b
--- /dev/null
+++ b/board/files_test.go
@@ -0,0 +1,131 @@
+package board
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/maago-web/maago"
+	"github.com/maago-web/maago/maagotest"
+
+	"example.com/board/auth"
+	"example.com/board/outbox"
+)
+
+// An export is a file for each post out to everybody, and index.md, a
+// page of posts at a time. Run again, as a job past its lease is, it
+// swaps the rows: the files of the run before no row keeps, and the
+// sweep deletes them.
+func TestWriteExportFiles(t *testing.T) {
+	defer func(n int64) { exportPage = n }(exportPage)
+	exportPage = 1 // two posts: two full pages, then an empty one
+	db := maagotest.DB(t)
+	dir := t.TempDir()
+	ctx := maago.WithMedia(t.Context(), maago.LocalMedia{Dir: dir})
+	b, _ := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	p, _ := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "공개", Body: "본문", Status: maago.Set("published")})
+	InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "초안", Body: "비밀"})
+	p2, _ := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: "둘째", Body: "본문 둘", Status: maago.Set("published")})
+	j := outbox.Job{Kind: ExportFiles, Payload: fmt.Sprintf(`{"id":%d}`, b.ID)}
+	for range 2 {
+		if err := WriteExportFiles(ctx, db, j); err != nil {
+			t.Fatal(err)
+		}
+	}
+	fs, err := BoardFiles(ctx, db, BoardFilesParams{BoardID: b.ID})
+	if err != nil || len(fs) != 3 || fs[0].Name != "index.md" || fs[1].Name != fmt.Sprintf("post-%d.md", p.ID) || fs[2].Name != fmt.Sprintf("post-%d.md", p2.ID) {
+		t.Fatalf("files: %+v %v", fs, err)
+	}
+	old := time.Now().Add(-48 * time.Hour)
+	entries, _ := os.ReadDir(dir)
+	if len(entries) != 6 {
+		t.Fatalf("%d files in the store, want two runs' three", len(entries))
+	}
+	for _, e := range entries {
+		os.Chtimes(filepath.Join(dir, e.Name()), old, old)
+	}
+	if err := maago.SweepMedia(ctx, db, 0); err != nil {
+		t.Fatal(err)
+	}
+	var names, keys []string
+	entries, _ = os.ReadDir(dir)
+	for _, e := range entries {
+		names = append(names, e.Name())
+	}
+	for _, f := range fs {
+		keys = append(keys, f.Key)
+	}
+	slices.Sort(keys)
+	if !slices.Equal(names, keys) {
+		t.Errorf("after the sweep: %v, want the rows' %v", names, keys)
+	}
+	for _, c := range []struct{ file, want string }{{fs[0].Key, "# 자유\n\n- [공개](" + fs[1].Name + ")\n- [둘째](" + fs[2].Name + ")\n"}, {fs[1].Key, "# 공개\n\n본문\n"}, {fs[2].Key, "# 둘째\n\n본문 둘\n"}} {
+		f, err := maago.OpenMedia(ctx, c.file)
+		if err != nil {
+			t.Fatal(err)
+		}
+		body, _ := io.ReadAll(f)
+		f.Close()
+		if string(body) != c.want {
+			t.Errorf("file: %q, want %q", body, c.want)
+		}
+	}
+}
+
+// Staff asks for the files; the worker writes them; staff gets them by
+// name.
+func TestFiles(t *testing.T) {
+	db := maagotest.DB(t)
+	cfg := config(t, db)
+	h, err := maago.Handler(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := t.Context()
+	boss, err := auth.CreateSuperuser(ctx, db, "boss@example.com", password)
+	if err != nil {
+		t.Fatal(err)
+	}
+	session, err := auth.SignIn(ctx, db, boss)
+	if err != nil {
+		t.Fatal(err)
+	}
+	staff := maagotest.As(h, session)
+	b, _ := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+
+	if code, body := get(staff, BoardFilesURL(b.ID)); code != 200 || !strings.Contains(body, "아직 내보낸 파일이 없습니다.") {
+		t.Errorf("no files yet: %d %s", code, body)
+	}
+	if code, loc, _ := post(staff, BoardFilesExportURL(b.ID), nil); code != 303 || loc != BoardFilesURL(b.ID) {
+		t.Fatalf("export: %d %q", code, loc)
+	}
+	// The worker, as main runs it: the store in its context.
+	handle := func(ctx context.Context, j outbox.Job) error {
+		if j.Kind != ExportFiles {
+			return fmt.Errorf("a job of kind %q", j.Kind)
+		}
+		return WriteExportFiles(maago.WithMedia(ctx, cfg.Media), db, j)
+	}
+	if found, err := outbox.RunOnce(ctx, db, time.Now(), handle); !found || err != nil {
+		t.Fatalf("the job: %v %v", found, err)
+	}
+	if code, body := get(staff, BoardFilesURL(b.ID)); code != 200 || !strings.Contains(body, `href="`+BoardFileURL(b.ID, "index.md")+`"`) {
+		t.Errorf("the files: %d %s", code, body)
+	}
+	r := httptest.NewRequest("GET", BoardFileURL(b.ID, "index.md"), nil)
+	w := httptest.NewRecorder()
+	staff.ServeHTTP(w, r)
+	if w.Code != 200 || w.Body.String() != "# 자유\n\n" || !strings.HasPrefix(w.Header().Get("Content-Disposition"), "attachment") {
+		t.Errorf("index.md: %d %v %q", w.Code, w.Header(), w.Body)
+	}
+	if code, _ := get(staff, BoardFileURL(b.ID, "nope.md")); code != 404 {
+		t.Errorf("no such file: %d", code)
+	}
+}
