@@ -93,3 +93,23 @@ func (p Post) Next(to string) error {
 	}
 	return nil
 }
+
+// ExportFile is a file of a board's export, which the outbox's worker
+// writes: the board's latest, by name. The file itself is in the media
+// store under Key.
+type ExportFile struct {
+	maago.Model `maago:"unique=(BoardID,Name)"`
+
+	ID        int64
+	BoardID   int64 `maago:"fk=Board"`
+	Name      string
+	Key       string `maago:"unique,media"`
+	Type      string
+	Size      int64
+	CreatedAt time.Time `maago:"auto=create"`
+}
+
+// media is the file of f, as maago.ServeMedia takes it.
+func (f ExportFile) media() maago.Media {
+	return maago.Media{Key: f.Key, Name: f.Name, Type: f.Type, Size: f.Size}
+}
