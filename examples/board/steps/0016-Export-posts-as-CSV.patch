index 9220624..fe47ffd 100644
--- a/board/web_test.go
+++ b/board/web_test.go
@@ -2,6 +2,7 @@ package board
 
 import (
 	"database/sql"
+	"encoding/csv"
 	"fmt"
 	"net/http"
 	"net/http/httptest"
@@ -327,3 +328,49 @@ func TestAPI(t *testing.T) {
 		t.Errorf("no board: %d %s", w.Code, w.Body)
 	}
 }
+
+func TestExport(t *testing.T) {
+	h, db := app(t)
+	ctx := t.Context()
+	b, err := InsertBoard(ctx, db, NewBoardInput{Name: "자유"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, title := range []string{"하나", `"따옴표", 쉼표`, "셋", "=1+2", "숨김"} {
+		p, err := InsertPost(ctx, db, NewPostInput{BoardID: b.ID, Title: title, Body: "본문"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if title == "숨김" {
+			p.Hidden = true
+			if err := UpdatePost(ctx, db, &p); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	defer func(n int64) { exportPage = n }(exportPage)
+	exportPage = 2 // four rows: two full pages, then an empty one
+
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, httptest.NewRequest("GET", BoardExportURL(fmt.Sprint(b.ID)), nil))
+	if w.Code != 200 || w.Header().Get("Content-Type") != "text/csv; charset=utf-8" || w.Header().Get("Content-Disposition") != `attachment; filename="board-1.csv"` {
+		t.Fatalf("%d %v", w.Code, w.Header())
+	}
+	rows, err := csv.NewReader(w.Body).ReadAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var titles []string
+	for _, r := range rows {
+		titles = append(titles, r[1])
+	}
+	if got := strings.Join(titles, "|"); got != `title|하나|"따옴표", 쉼표|셋|'=1+2` {
+		t.Errorf("titles %s in\n%q", got, rows)
+	}
+
+	for _, path := range []string{BoardExportURL("2"), BoardExportURL("abc")} {
+		if code, _ := get(h, path); code != 404 {
+			t.Errorf("%s: %d", path, code)
+		}
+	}
+}
